import silk.cli.task { Task, TaskError }
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.char
import silk.text.string { String, Split, ScalarStep }
import silk.num.u32
import support

pub effect fn embedShaders(check: bool) -> ()
  ! TaskError | FileError | HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  run shaderSet("modules/gpu_scene", &["scene", "blend+compose", "blend+filter"], check)
  run shaderSet("modules/ui_renderer", &["common+quad", "common+shadow", "common+underline", "common+sprite+mono", "common+sprite+poly", "common+path", "../../gpu_scene/shaders/blend+layer"], check)
}

effect fn shaderSet(directory: string, shaders: &[string], check: bool) -> ()
  ! TaskError | FileError | HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let mut generated = run String.copy("// Generated by silk task embed-shaders from ")
  run String.append(&mut generated, directory)
  run String.append(&mut generated, "/shaders; do not edit.\n")
  let mut index: usize = 0
  while index < shaders.length {
    let mut parts = String.split(shaders[index], "+")
    let mut source = Bytes.make()
    let mut name = shaders[index]
    while let Option<string>.Some { value } = Split.next(&mut parts) {
      let mut filename = run String.copy(directory)
      run String.append(&mut filename, "/shaders/")
      run String.append(&mut filename, value)
      run String.append(&mut filename, ".wgsl")
      let data = run support.read(String.view(&filename))
      run Bytes.append(&mut source, Bytes.asSlice(&data))
      name = value
    }
    if let Option<usize>.Some { value } = String.findLast(name, "/") {
      name = String.slice(name, value + 1, String.utf8Bytes(name).length - value - 1)
    }
    run String.append(&mut generated, "pub fn ")
    let mut words = String.split(name, "-")
    let mut first = true
    while let Option<string>.Some { value } = Split.next(&mut words) {
      if !first { run String.append(&mut generated, "_") }
      run String.append(&mut generated, value)
      first = false
    }
    run String.append(&mut generated, "() -> &'static [u8] { return b\"")
    run quoted(&mut generated, run support.text(Bytes.asSlice(&source)))
    run String.append(&mut generated, "\" }\n")
    index = index + 1
  }
  let mut destination = run String.copy(directory)
  run String.append(&mut destination, "/src/generated_shaders.silk")
  run generatedFile(String.view(&destination), String.utf8Bytes(String.view(&generated)), check)
}

effect fn hex4(out: &mut String, value: u32) -> () ! OutOfMemoryError ? &mut Allocator {
  run String.append(&mut out.*, "\\u")
  let hex = "0123456789abcdef"
  let mut divisor: u32 = 4096
  while divisor > 0 {
    run String.append(&mut out.*, String.slice(hex, u32.toUsize((value / divisor) % 16), 1))
    divisor = divisor / 16
  }
}

effect fn quoted(out: &mut String, source: string) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut cursor = String.scalarCursor()
  while let Option<ScalarStep>.Some { value: step } = String.nextScalar(source, move cursor) {
    let scalar = char.toU32(String.scalarValue(&step))
    let start = String.scalarByteOffset(&step)
    cursor = String.nextCursor(move step)
    if scalar == 34 { run String.append(&mut out.*, "\\\"") }
    else if scalar == 92 { run String.append(&mut out.*, "\\\\") }
    else if scalar == 8 { run String.append(&mut out.*, "\\b") }
    else if scalar == 9 { run String.append(&mut out.*, "\\t") }
    else if scalar == 10 { run String.append(&mut out.*, "\\n") }
    else if scalar == 12 { run String.append(&mut out.*, "\\f") }
    else if scalar == 13 { run String.append(&mut out.*, "\\r") }
    else if scalar < 32 || scalar >= 127 {
      if scalar <= 65535 { run hex4(&mut out.*, scalar) }
      else {
        let supplementary = scalar - 65536
        run hex4(&mut out.*, 55296 + supplementary / 1024)
        run hex4(&mut out.*, 56320 + supplementary % 1024)
      }
    } else { run String.append(&mut out.*, String.slice(source, start, 1)) }
  }
}

effect fn generatedFile(destination: string, bytes: &[u8], check: bool) -> ()
  ! TaskError | FileError | HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  if check {
    let actual = run support.read(destination)
    if !support.equal(Bytes.asSlice(&actual), bytes) { run Task.abort(destination) }
  } else { run support.save(destination, bytes) }
}

effect fn quotedField<'a>(line: string<'a>, field: string) -> string<'a> ! TaskError | OutOfMemoryError ? &mut Allocator {
  let start = match String.find(line, field) {
    Option<usize>.Some { value } => value + String.utf8Bytes(field).length
    Option<usize>.None => run Task.abort("Missing native dependency field")
  }
  let rest = String.slice(line, start, String.utf8Bytes(line).length - start)
  let quote = match String.find(rest, "\"") {
    Option<usize>.Some { value } => value + 1
    Option<usize>.None => run Task.abort("Expected quoted native dependency field")
  }
  let value = String.slice(rest, quote, String.utf8Bytes(rest).length - quote)
  let end = match String.find(value, "\"") {
    Option<usize>.Some { value: found } => found
    Option<usize>.None => run Task.abort("Unterminated native dependency field")
  }
  return String.slice(value, 0, end)
}

pub effect fn nativeRoot() -> Path
  ! TaskError | FileError | HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let manifest = run support.read("modules/ui_renderer/browser/silk.toml")
  let mut lines = String.split(run support.text(Bytes.asSlice(&manifest)), "\n")
  let mut revision = String.make()
  while let Option<string>.Some { value } = Split.next(&mut lines) {
    if String.startsWith(String.trim(value), "webgpu =") {
      let git = run quotedField(value, "git")
      if git != "https://github.com/silk-lang/lib-native.git" && git != "https://github.com/silk-lang/lib-native" {
        run Task.abort("webgpu must pin silk-lang/lib-native")
      }
      let rev = run quotedField(value, "rev")
      let bytes = String.utf8Bytes(rev)
      if bytes.length != 40 { run Task.abort("Expected an exact 40-character native Git revision") }
      let mut at: usize = 0
      while at < bytes.length {
        let b = bytes[at]
        if !(b >= 48 && b <= 57) && !(b >= 97 && b <= 102) { run Task.abort("Invalid native Git revision") }
        at = at + 1
      }
      revision = run String.copy(rev)
    }
  }
  if String.view(&revision) == "" { run Task.abort("Missing pinned webgpu dependency") }
  let home = match move run HostInput.variableNamed("SILK_HOME") {
    Option<Bytes>.Some { value } => run support.path(run support.text(Bytes.asSlice(&value)))
    Option<Bytes>.None => {
      let name = if support.OS == "windows" { "USERPROFILE" } else { "HOME" }
      let value = match move run HostInput.variableNamed(name) {
        Option<Bytes>.Some { value } => move value
        Option<Bytes>.None => run Task.abort("Neither SILK_HOME nor the user home is set")
      }
      let root = run support.path(run support.text(Bytes.asSlice(&value)))
      run Path.join(&root, ".silk")
    }
  }
  let git = run Path.join(&home, "git")
  let root = run Path.join(&git, String.view(&revision))
  let runner = run Path.join(&root, "modules/gpu/webgpu/browser/runner.ts")
  if !run FileSystem.exists(&runner) {
    run Task.abort("Fetch the pinned native payload: silk check --manifest-path modules/ui_renderer/browser/silk.toml --target wasm32-unknown-unknown")
  }
  return move root
}

pub effect fn browserExports(check: bool) -> ()
  ! TaskError | FileError | HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let native = run nativeRoot()
  let source = run Path.join(&native, "modules/gpu/webgpu/browser/generated_webgpu_exports.silk")
  let template = run FileSystem.readFile(&source)
  run generatedFile("modules/ui_renderer/browser/src/generated_webgpu_exports.silk", Bytes.asSlice(&template), check)
}
