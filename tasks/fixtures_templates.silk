//! Test source templates transcribed from the independent fixture generators.
pub const png0: string = "//! Independent PNG sample vectors generated by silk task fixtures png.\n//! https://www.w3.org/TR/png-3/#11IHDR and #11tRNS\nimport png\nimport image { ImageError }\nimport png_decode { PngError }\nimport silk.core.effect { Effect }\nimport silk.mem.allocator { Allocator, OutOfMemoryError }\nimport silk.testing.testing { Testing, AssertionError }\n\neffect fn check(data: &[u8], expected: &[u8], width: u32, height: u32) -> ()\n  ! PngError | ImageError | OutOfMemoryError | AssertionError<'static>\n  ? &mut Allocator {\n  let image = run png.decode(data)\n  run Testing.expect(image.width() == width && image.height() == height, \"decoded dimensions\")\n  let pixels = image.data()\n  run Testing.expect(pixels.length == expected.length, \"decoded length\")\n  let mut i: usize = 0\n  while i < pixels.length {\n    run Testing.expect(pixels[i] == expected[i], \"straight samples become premultiplied RGBA\")\n    i = i + 1\n  }\n}\n"
pub const png1: string = "\ntest effect fn @0@() -> ()\n  ! PngError | ImageError | OutOfMemoryError | AssertionError<'static> {\n  let mut allocator = Allocator.systemAllocatorProvider()\n  run check(@1@, @2@, @3@, @4@)\n    |> Effect.provideMut<Allocator>(&mut allocator)\n}\n"
pub const png2: string = "//! PNG malformed-input contracts: framing, integrity, bounds and sample validity.\nimport png\nimport png_decode { PngError }\nimport image { Image, ImageError }\nimport silk.collections.slice { Slice }\nimport silk.core.effect { Effect }\nimport silk.core.result { Result }\nimport silk.mem.allocator { Allocator, OutOfMemoryError }\nimport silk.testing.testing { Testing, AssertionError }\n\neffect fn rejects(data: &[u8]) -> ()\n  ! OutOfMemoryError | AssertionError<'static>\n  ? &mut Allocator {\n  let result = run Effect.result(png.decode(data))\n  let rejected = match &result {\n    Result<Image, PngError | ImageError | OutOfMemoryError>.Success { .. } => false\n    Result<Image, PngError | ImageError | OutOfMemoryError>.Failure { error } => match &error {\n      PngError _ => true\n      ImageError _ => true\n      OutOfMemoryError _ => { fail OutOfMemoryError {} }\n    }\n  }\n  run Testing.expect(rejected, \"invalid PNG is rejected without a partial image\")\n}\n"
pub const png3: string = "\ntest effect fn @0@() -> () ! OutOfMemoryError | AssertionError<'static> {\n  let mut allocator = Allocator.systemAllocatorProvider()\n  run rejects(@1@) |> Effect.provideMut<Allocator>(&mut allocator)\n}\n"
pub const png4: string = "\neffect fn allTruncations() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {\n  let data = @0@\n  let mut length: usize = 0\n  while length < data.length {\n    run rejects(Slice.view<u8>(data, 0, length))\n    length = length + 1\n  }\n}\ntest effect fn truncatedAtEveryByte() -> () ! OutOfMemoryError | AssertionError<'static> {\n  let mut allocator = Allocator.systemAllocatorProvider()\n  run allTruncations() |> Effect.provideMut<Allocator>(&mut allocator)\n}\n"
pub const png5: string = "//! PNG color metadata is preserved for the color-management consumer.\nimport png\nimport png_decode { PngError, Chromaticities }\nimport image { ImageError }\nimport silk.core.option { Option }\nimport silk.core.effect { Effect }\nimport silk.mem.allocator { Allocator, OutOfMemoryError }\nimport silk.testing.testing { Testing, AssertionError }\n"
pub const png6: string = "\neffect fn metadata() -> () ! PngError | ImageError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {\n  let decoded = run png.decodeWithMetadata(@0@)\n  run Testing.expect(match &decoded.metadata.gamma { Option<u32>.Some { value } => value == 45455 _ => false }, \"gamma stored in PNG integer units\")\n  run Testing.expect(match &decoded.metadata.srgbIntent { Option<u8>.Some { value } => value == 2 _ => false }, \"sRGB rendering intent\")\n  run Testing.expect(match &decoded.metadata.chromaticities {\n    Option<Chromaticities>.Some { value } => value.whiteX == 31270 && value.redX == 64000 && value.greenY == 60000 && value.blueY == 6000\n    _ => false\n  }, \"chromaticity coordinates retained\")\n  let icc = run png.decodeWithMetadata(@1@)\n  let bytes = icc.metadata.iccProfile.asSlice()\n  run Testing.expect(bytes.length == 132 && bytes[36] == 97 && bytes[39] == 112, \"ICC profile decompressed and retained\")\n}\ntest effect fn retainsColorMetadata() -> () ! PngError | ImageError | OutOfMemoryError | AssertionError<'static> {\n  let mut allocator = Allocator.systemAllocatorProvider()\n  run metadata() |> Effect.provideMut<Allocator>(&mut allocator)\n}\n"
pub const jpeg0: string = "//! JPEG marker/frame metadata from independently encoded fixtures.\nimport jpeg\nimport jpeg_header { JpegError }\nimport image { ImageError }\nimport silk.testing.testing { Testing, AssertionError }\n"
pub const jpeg1: string = "\ntest effect fn @0@() -> () ! JpegError | ImageError | AssertionError<'static> {\n  let header = run jpeg.inspect(@1@)\n  run Testing.expect(header.width == 9 && header.height == 7, \"frame dimensions\")\n  run Testing.expect(header.progressive == @2@, \"sequential/progressive frame marker\")\n  run Testing.expect(header.orientation == @3@, \"EXIF orientation retained\")\n  run Testing.expect(header.componentCount == @4@ && header.jfif, \"component count and JFIF declaration\")\n}\n"
pub const jpeg2: string = "//! JPEG header rejection before entropy decoding.\nimport jpeg\nimport jpeg_header { Header, JpegError }\nimport image { ImageError }\nimport silk.collections.slice { Slice }\nimport silk.core.effect { Effect }\nimport silk.core.result { Result }\nimport silk.testing.testing { Testing, AssertionError }\neffect fn rejects(data: &[u8]) -> () ! AssertionError<'static> {\n  let result = run Effect.result(jpeg.inspect(data))\n  let rejected = match &result {\n    Result<Header, JpegError | ImageError>.Success { .. } => false\n    Result<Header, JpegError | ImageError>.Failure { .. } => true\n  }\n  run Testing.expect(rejected, \"malformed JPEG header rejected\")\n}\n"
pub const jpeg3: string = "\ntest effect fn @0@() -> () ! AssertionError<'static> { run rejects(@1@) }\n"
pub const jpeg4: string = "\ntest effect fn truncatedHeaders() -> () ! AssertionError<'static> {\n  let data = @0@\n  let mut length: usize = 0\n  while length < @1@ {\n    run rejects(Slice.view<u8>(data,0,length))\n    length = length + 1\n  }\n}\n"
pub const jpegprogressive0: string = "//! Progressive reconstruction agrees with sequential coding of the same coefficients.\nimport jpeg\nimport jpeg_header { JpegError }\nimport image { ImageError }\nimport silk.core.effect { Effect }\nimport silk.mem.allocator { Allocator, OutOfMemoryError }\nimport silk.testing.testing { Testing, AssertionError }\n"
pub const jpegprogressive1: string = "\neffect fn @0@Body() -> () ! JpegError | ImageError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {\n  let sequential = run jpeg.decode(@1@)\n  let progressive = run jpeg.decode(@2@)\n  run Testing.expect(progressive.width() == 23 && progressive.height() == 19, \"partial MCU dimensions\")\n  let expected = sequential.data()\n  let actual = progressive.data()\n  let mut i: usize = 0\n  while i < expected.length {\n    run Testing.expect(actual[i] == expected[i], \"progressive scans reconstruct identical sequential coefficients\")\n    i = i + 1\n  }\n}\ntest effect fn @0@() -> () ! JpegError | ImageError | OutOfMemoryError | AssertionError<'static> {\n  let mut allocator = Allocator.systemAllocatorProvider()\n  run @0@Body() |> Effect.provideMut<Allocator>(&mut allocator)\n}\n"
pub const jpegprogressive2: string = "\neffect fn separateBody() -> () ! JpegError | ImageError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {\n  let decoded = run jpeg.decode(@0@)\n  let pixels = decoded.data()\n  let mut i: usize = 0\n  while i < pixels.length {\n    run Testing.expect(pixels[i] == 128 && pixels[i+1] == 128 && pixels[i+2] == 128 && pixels[i+3] == 255, \"separate sequential components\")\n    i = i + 4\n  }\n}\ntest effect fn separateSequentialScans() -> () ! JpegError | ImageError | OutOfMemoryError | AssertionError<'static> {\n  let mut allocator = Allocator.systemAllocatorProvider()\n  run separateBody() |> Effect.provideMut<Allocator>(&mut allocator)\n}\n"
pub const jpegprogressive3: string = "//! Malformed progressive scans must fail without yielding a partial image.\nimport jpeg\nimport jpeg_header { JpegError }\nimport image { Image, ImageError }\nimport silk.collections.slice { Slice }\nimport silk.core.effect { Effect }\nimport silk.core.result { Result }\nimport silk.mem.allocator { Allocator, OutOfMemoryError }\nimport silk.testing.testing { Testing, AssertionError }\neffect fn rejects(data: &[u8]) -> () ! AssertionError<'static> ? &mut Allocator {\n  let result = run Effect.result(jpeg.decode(data))\n  let rejected = match &result {\n    Result<Image, JpegError | ImageError | OutOfMemoryError>.Success { .. } => false\n    Result<Image, JpegError | ImageError | OutOfMemoryError>.Failure { .. } => true\n  }\n  run Testing.expect(rejected, \"malformed progressive stream rejected\")\n}\n"
pub const jpegprogressive4: string = "\ntest effect fn @0@() -> () ! AssertionError<'static> {\n  let mut allocator = Allocator.systemAllocatorProvider()\n  run rejects(@1@) |> Effect.provideMut<Allocator>(&mut allocator)\n}\n"
pub const jpegprogressive5: string = "\ntest effect fn everyProgressiveTruncation() -> () ! AssertionError<'static> {\n  let mut allocator = Allocator.systemAllocatorProvider()\n  let data = @0@\n  let mut length: usize = 0\n  while length < data.length {\n    run rejects(Slice.view<u8>(data, 0, length)) |> Effect.provideMut<Allocator>(&mut allocator)\n    length = length + 1\n  }\n}\n"
pub const jpegmetadata0: string = "//! EXIF metadata must survive unrelated APP1 segments.\nimport jpeg\nimport jpeg_header { JpegError }\nimport image { ImageError }\nimport silk.testing.testing { Testing, AssertionError }\n"
pub const jpegmetadata1: string = "\ntest effect fn xmpDoesNotEraseOrientation() -> () ! JpegError | ImageError | AssertionError<'static> {\n  let header = run jpeg.inspect(@0@)\n  run Testing.expect(header.orientation == 6, \"unrelated APP1 retains EXIF orientation\")\n}\n"
pub const jpegmetadata2: string = "\nimport jpeg_metadata\nimport jpeg_metadata { Metadata }\nimport silk.core.effect { Effect }\nimport silk.core.result { Result }\nimport silk.mem.allocator { Allocator, OutOfMemoryError }\n"
pub const jpegmetadata3: string = "\neffect fn assembledBody() -> () ! JpegError | ImageError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {\n  let decoded = run jpeg_metadata.decodeWithMetadata(@0@)\n  run Testing.expect(decoded.metadata.orientation == 6 && decoded.image.width() == 9 && decoded.image.height() == 7, \"raw dimensions and orientation retained\")\n  let actual = decoded.metadata.iccProfile.asSlice()\n  let expected = @1@\n  run Testing.expect(actual.length == expected.length, \"all ICC chunks assembled\")\n  let mut i: usize = 0\n  while i < expected.length {\n    run Testing.expect(actual[i] == expected[i], \"chunk sequence controls assembly, not marker order\")\n    i = i + 1\n  }\n}\ntest effect fn reorderedProfileChunks() -> () ! JpegError | ImageError | OutOfMemoryError | AssertionError<'static> {\n  let mut allocator = Allocator.systemAllocatorProvider()\n  run assembledBody() |> Effect.provideMut<Allocator>(&mut allocator)\n}\neffect fn rejects(data: &[u8]) -> () ! AssertionError<'static> ? &mut Allocator {\n  let result = run Effect.result(jpeg_metadata.read(data))\n  let rejected = match &result {\n    Result<Metadata, JpegError | ImageError | OutOfMemoryError>.Success { .. } => false\n    Result<Metadata, JpegError | ImageError | OutOfMemoryError>.Failure { .. } => true\n  }\n  run Testing.expect(rejected, \"malformed ICC chunk framing rejected\")\n}\n"
pub const jpegmetadata4: string = "\ntest effect fn @0@() -> () ! AssertionError<'static> {\n  let mut allocator = Allocator.systemAllocatorProvider()\n  run rejects(@1@) |> Effect.provideMut<Allocator>(&mut allocator)\n}\n"
pub const jpegmetadata5: string = "\neffect fn trailingProfileBody() -> () ! JpegError | ImageError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {\n  let decoded = run jpeg_metadata.decodeWithMetadata(@0@)\n  run Testing.expect(decoded.metadata.iccProfile.asSlice().length == @1@, \"APP2 between progressive scans retained\")\n}\ntest effect fn profileBetweenScans() -> () ! JpegError | ImageError | OutOfMemoryError | AssertionError<'static> {\n  let mut allocator = Allocator.systemAllocatorProvider()\n  run trailingProfileBody() |> Effect.provideMut<Allocator>(&mut allocator)\n}\n"
