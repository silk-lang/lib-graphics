import silk.build.graph { Build, BuildError, Compilation, Deferred, Optimize, Options }
import silk.cli.command { Command, CommandLine }
import silk.cli.task { Task, TaskError, TaskSet }
import silk.io.writer { WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { FileSystem, FileError }
import silk.system.host_input { HostInput, HostInputError }

union Tasks {
  JpegBench { pub options: Options },
}

impl CommandLine for Tasks {
  static fn command() -> Command<Tasks> {
    return Command<Tasks>.make("tasks", "Build the package") |> Command.flatten("options")
  }
}

effect fn compilation(options: &Options) -> Compilation
  ! BuildError
  ? &mut Allocator | &mut FileSystem | &mut HostInput {
  return run Compilation.fromPackage(options)
}

impl TaskSet for Tasks {
  effect fn perform(self: Tasks) -> ()
    ! BuildError
      | TaskError
      | ProcessError
      | FileError
      | HostInputError
      | OutOfMemoryError
      | WriterError
    ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    match move self {
      Tasks.JpegBench { options } => {
        let executable = run Compilation.executable("jpeg-bench", "src/jpeg_bench.silk")
        let optimized = run executable.optimize(run Deferred<Optimize>.value(options.optimize))
        let debugged = run optimized.debug(run Deferred<bool>.value(options.debugInfo()))
        let selected = run debugged.unsandboxedTools(options.unsandboxedTools)
        let graph = run (run Build.make()).add(move selected)
        drop run graph.compile()
      }
    }
  }
}

pub effect fn main() -> i32
  ? &mut HostInput {
  return run Task.main<Tasks>()
}
