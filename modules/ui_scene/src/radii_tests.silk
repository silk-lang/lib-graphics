//! Corner radii as CSS Backgrounds 3 resolves them.
import radii { Radii }
import primitives { ContentMask }
import silk.geometry.corners { Corners }
import silk.geometry.rect { Rect }
import silk.num.f32
import silk.testing.testing { Testing, AssertionError }

fn near(a: f32, b: f32) -> bool {
  return f32.abs(a - b) < 0.0001
}

test effect fn overlappingRadiiShrinkTogether() -> () ! AssertionError<'static> {
  // 50% of a 200 x 100 box is an ellipse, nothing to shrink.
  let half = Radii.new(Corners<f32>.uniform(100.0), Corners<f32>.uniform(50.0)).fitted(200.0, 100.0)
  run Testing.expect(near(half.x.topLeft, 100.0) && near(half.y.bottomRight, 50.0), "radii that just fit stay")
  // Top side: 150 + 150 on 200 gives f = 2/3, which every radius takes, not only those on the top.
  let r = Radii.new(Corners<f32>.new(150.0, 150.0, 20.0, 10.0), Corners<f32>.new(30.0, 30.0, 30.0, 30.0)).fitted(200.0, 100.0)
  run Testing.expect(near(r.x.topLeft, 100.0) && near(r.x.bottomRight, 20.0 * 2.0 / 3.0) && near(r.y.bottomLeft, 20.0), "one factor scales all radii")
  // A radius past half the shorter side but fitting its sides stays, unlike a clamp to half.
  let wide = Radii.new(Corners<f32>.new(90.0, 10.0, 10.0, 10.0), Corners<f32>.uniform(10.0)).fitted(100.0, 20.0)
  run Testing.expect(near(wide.x.topLeft, 90.0) && near(wide.y.topLeft, 10.0), "radii are not clamped to half the shorter side")
  // A corner with one zero radius is square; negative radii are zero.
  let square = Radii.new(Corners<f32>.new(10.0, -4.0, 10.0, 10.0), Corners<f32>.new(0.0, 10.0, 10.0, 10.0)).fitted(100.0, 100.0)
  run Testing.expect(square.x.topLeft == 0.0 && square.y.topLeft == 0.0 && square.x.topRight == 0.0 && square.y.topRight == 0.0, "a zero radius makes the corner square")
}

test effect fn innerAndSpreadRadii() -> () ! AssertionError<'static> {
  // Padding edge radii: each axis less the border on its side.
  let inner = Radii.uniform(20.0).inset(4.0, 8.0, 30.0, 2.0)
  run Testing.expect(near(inner.x.topLeft, 16.0) && near(inner.y.topLeft, 12.0) && inner.x.topRight == 0.0 && near(inner.y.bottomRight, 18.0), "inner radii are elliptical per side")
  // Spread: r >= spread grows by the spread; a smaller radius by spread * (1 + (r / spread - 1)^3).
  let grown = Radii.new(Corners<f32>.new(20.0, 5.0, 0.0, 10.0), Corners<f32>.uniform(20.0)).spread(10.0)
  run Testing.expect(near(grown.x.topLeft, 30.0) && near(grown.x.topRight, 5.0 + 10.0 * (1.0 - 0.125)) && grown.x.bottomRight == 0.0 && near(grown.x.bottomLeft, 20.0), "spread radii follow the spec's curve")
  let shrunk = Radii.uniform(6.0).spread(-10.0)
  run Testing.expect(shrunk.x.topLeft == 0.0, "an inset spread never goes below zero")
}

test effect fn ellipticalMaskCoverage() -> () ! AssertionError<'static> {
  let mask = ContentMask.rounded(Rect<f32>.new(0.0, 0.0, 100.0, 40.0), Radii.new(Corners<f32>.uniform(50.0), Corners<f32>.uniform(20.0)))
  run Testing.expect(mask.cornerCoverage(50.0, 20.0) == 1.0 && mask.cornerCoverage(2.0, 20.0) == 1.0, "inside the ellipse is kept")
  run Testing.expect(mask.cornerCoverage(4.0, 4.0) == 0.0 && mask.cornerCoverage(96.0, 36.0) == 0.0, "outside it is cut")
  // On the ellipse x^2/50^2 + y^2/20^2 = 1 at 45 degrees the coverage is about a half.
  let c = mask.cornerCoverage(50.0 - 50.0 * 0.70710677, 20.0 - 20.0 * 0.70710677)
  run Testing.expect(c > 0.4 && c < 0.6, "the curve is antialiased")
}
