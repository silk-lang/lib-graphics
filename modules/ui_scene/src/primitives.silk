//! The records a UI frame is made of. Every primitive is a flat `Copy` struct in scaled device
//! pixels (physical pixels, y down, after the window's scale factor), so a renderer can copy it
//! into an instance buffer without following any handle.
//!
//! Each primitive carries a [`ContentMask`]: the rectangle it is clipped to, usually the bounds of
//! the scroll view or panel that contains it. Pixels are clipped by area, so a mask on integer
//! coordinates clips exactly at pixel edges.
import effects { LayerEffects }
import silk.core.equal { Equal }
import silk.core.ownership { Copy }
import silk.geometry.corners { Corners }
import silk.geometry.insets { Insets }
import silk.geometry.matrix { Matrix3 }
import silk.geometry.point { Point2 }
import silk.geometry.rect { Rect }
import silk.geometry.vector { Vector2 }
import silk.num.f32
import silk.num.i32
import silk.num.u32
import atlas.atlas { AtlasTile }
import silk.color.color { ColorSpace, Interpolation }
import silk.color.rgba { Rgba }
import color

/// The clip rectangle of a primitive.
pub struct ContentMask {
  pub bounds: Rect<f32>,
}

impl Copy for ContentMask {}

impl ContentMask {
  /// A mask that clips to `bounds`.
  pub fn new(bounds: Rect<f32>) -> ContentMask {
    return ContentMask { bounds: bounds }
  }

  /// The intersection of two masks, as a nested scroll view clips its children. Disjoint masks
  /// give an empty mask, which hides everything.
  pub fn intersect(self: Self, other: ContentMask) -> ContentMask {
    return ContentMask {
      bounds: Rect<f32>.new(
        f32.max(self.bounds.xMin, other.bounds.xMin),
        f32.max(self.bounds.yMin, other.bounds.yMin),
        f32.min(self.bounds.xMax, other.bounds.xMax),
        f32.min(self.bounds.yMax, other.bounds.yMax),
      ),
    }
  }
}

/// A gradient stop: `color` at `offset` (0 at the start of the gradient line, 1 at its end).
pub struct ColorStop {
  pub color: Rgba<f32>,
  pub offset: f32,
}

impl Copy for ColorStop {}

/// A two-stop linear gradient across a box, as CSS `linear-gradient(<angle>, from, to)`.
///
/// The angle is in degrees, clockwise from "to top": 0 runs bottom to top, 90 left to right, 180
/// top to bottom. The gradient line passes through the box center, and its length is chosen so the
/// corners of the box land on offsets 0 and 1 (CSS Images 3 §3.1.1). Outside the stops the end
/// colors extend (pad).
pub struct LinearGradient {
  pub angle: f32,
  pub from: ColorStop,
  pub to: ColorStop,
  /// How the stops are interpolated (`silk.color`): the space, and the hue arc for polar spaces.
  pub interpolation: Interpolation,
}

impl Copy for LinearGradient {}

/// What fills a quad or a path.
pub union Background {
  Solid { pub color: Rgba<f32> },
  Linear { pub gradient: LinearGradient },
}

impl Copy for Background {}

impl Background {
  /// A solid fill.
  pub fn solid(fill: Rgba<f32>) -> Background {
    return Background.Solid { color: fill }
  }

  /// A two-stop linear gradient at `angle` degrees, interpolated in sRGB.
  pub fn linear(angle: f32, from: Rgba<f32>, to: Rgba<f32>) -> Background {
    return Background.Linear {
      gradient: LinearGradient {
        angle: angle,
        from: ColorStop { color: from, offset: 0.0 },
        to: ColorStop { color: to, offset: 1.0 },
        interpolation: Interpolation.new(ColorSpace.Srgb),
      },
    }
  }

  /// Whether the fill draws nothing.
  pub fn isTransparent(self: &Self) -> bool {
    return match &self.* {
      Background.Solid { color: c } => color.isTransparent(c)
      Background.Linear { gradient } => color.isTransparent(gradient.from.color)
        && color.isTransparent(gradient.to.color)
    }
  }
}

/// How a quad's border is drawn.
pub union BorderStyle {
  Solid,
  /// Dashes along the border's center line, each `2 * w` long with `w` gaps between them, where
  /// `w` is the widest border edge. They start at the top-left corner and run clockwise.
  Dashed,
}

impl Copy for BorderStyle {}

impl Equal for BorderStyle {
  fn equals(left: &Self, right: &Self) -> bool {
    return match &left.* {
      BorderStyle.Solid => match &right.* {
        BorderStyle.Solid => true
        BorderStyle.Dashed => false
      }
      BorderStyle.Dashed => match &right.* {
        BorderStyle.Solid => false
        BorderStyle.Dashed => true
      }
    }
  }
}

/// A rectangle with per-corner radii, per-edge border widths and a background.
///
/// The background fills the whole rounded rectangle. The border is the band between that outline
/// and the inner outline inset by the border widths; it is drawn over the background, so a
/// translucent border shows the background through it, as GPUI does. Each radius is clamped to
/// half the smaller side. An inner corner is elliptical, with radii `r - left` (or `r - right`)
/// across and `r - top` (or `r - bottom`) down, as in CSS.
pub struct Quad {
  pub bounds: Rect<f32>,
  pub mask: ContentMask,
  pub background: Background,
  pub cornerRadii: Corners<f32>,
  pub borderWidths: Insets<f32>,
  pub borderColor: Rgba<f32>,
  pub borderStyle: BorderStyle,
}

impl Copy for Quad {}

impl Quad {
  /// A borderless quad with square corners filled by `background`.
  pub fn fill(bounds: Rect<f32>, mask: ContentMask, background: Background) -> Quad {
    return Quad {
      bounds: bounds,
      mask: mask,
      background: background,
      cornerRadii: Corners<f32>.uniform(0.0),
      borderWidths: Insets<f32>.uniform(0.0),
      borderColor: color.transparent(),
      borderStyle: BorderStyle.Solid,
    }
  }

  /// Whether the border has any width and color.
  pub fn hasBorder(self: &Self) -> bool {
    let w = self.borderWidths
    return !color.isTransparent(self.borderColor)
      && (w.top > 0.0 || w.right > 0.0 || w.bottom > 0.0 || w.left > 0.0)
  }
}

/// A blurred rounded rectangle, as CSS `box-shadow`.
///
/// `bounds` and `cornerRadii` are the box casting the shadow. The shadow's shape is that box moved
/// by `offset` and grown by `spread` on every side (radii grow by `spread` too, never below 0). It
/// is blurred by a Gaussian with standard deviation `blurRadius / 2`, as CSS defines the blur
/// radius. A drop shadow (`inset` false) draws the blurred shape and is not cut out under the box,
/// as in GPUI: draw the box over it. An inset shadow draws inside the box only: the box minus the
/// shape (shrunk by `spread` instead of grown), blurred.
pub struct Shadow {
  pub bounds: Rect<f32>,
  pub mask: ContentMask,
  pub cornerRadii: Corners<f32>,
  pub color: Rgba<f32>,
  pub blurRadius: f32,
  pub offset: Vector2<f32>,
  pub spread: f32,
  pub inset: bool,
}

impl Copy for Shadow {}

impl Shadow {
  /// The Gaussian's standard deviation.
  pub fn sigma(self: &Self) -> f32 {
    return f32.max(self.blurRadius, 0.0) * 0.5
  }

  /// The shape that is blurred: the box moved by `offset`, grown by `spread` (shrunk for inset).
  pub fn shape(self: &Self) -> Rect<f32> {
    let grow = if self.inset {
      -self.spread
    } else {
      self.spread
    }
    let b = self.bounds
    return Rect<f32>.new(
      b.xMin + self.offset.x - grow,
      b.yMin + self.offset.y - grow,
      b.xMax + self.offset.x + grow,
      b.yMax + self.offset.y + grow,
    )
  }

  /// The radii of [`Shadow.shape`].
  pub fn shapeRadii(self: &Self) -> Corners<f32> {
    let grow = if self.inset {
      -self.spread
    } else {
      self.spread
    }
    let r = self.cornerRadii
    return Corners<f32>.new(
      f32.max(r.topLeft + grow, 0.0),
      f32.max(r.topRight + grow, 0.0),
      f32.max(r.bottomRight + grow, 0.0),
      f32.max(r.bottomLeft + grow, 0.0),
    )
  }

  /// Everything the shadow can touch: the blurred shape (3 sigma covers all but 0.3% of the
  /// Gaussian) for a drop shadow, the box for an inset one.
  pub fn paintBounds(self: &Self) -> Rect<f32> {
    if self.inset {
      return self.bounds
    }
    let reach = 3.0 * self.sigma()
    let s = self.shape()
    return Rect<f32>.new(s.xMin - reach, s.yMin - reach, s.xMax + reach, s.yMax + reach)
  }
}

/// A text decoration line.
///
/// A straight underline fills the top `thickness` rows of `bounds`. A wavy one is a sine wave of
/// stroke width `thickness` centered in `bounds`, with wavelength `8 * thickness` and amplitude
/// `(bounds height - thickness) / 2`, starting at phase 0 on the left edge.
pub struct Underline {
  pub bounds: Rect<f32>,
  pub mask: ContentMask,
  pub color: Rgba<f32>,
  pub thickness: f32,
  pub wavy: bool,
}

impl Copy for Underline {}

/// A tinted coverage tile from a monochrome atlas texture: a glyph or a monochrome icon.
///
/// The tile is stretched over `bounds` with bilinear sampling. Glyph rasterization already puts the
/// subpixel offset into the tile, so `bounds` is normally on integer pixels and the tile's size,
/// which makes sampling exact.
pub struct GlyphSprite {
  pub bounds: Rect<f32>,
  pub mask: ContentMask,
  pub tile: AtlasTile,
  pub color: Rgba<f32>,
}

impl Copy for GlyphSprite {}

/// A premultiplied color tile from a polychrome atlas texture: an image, a color glyph or a color
/// icon, stretched over `bounds` with bilinear sampling and clipped to `cornerRadii`.
pub struct ImageSprite {
  /// Clockwise quarter turns applied to the sampled tile (0 through 3).
  pub quarterTurns: u32,
  /// Rounded content-box clip, independent of the image sampling bounds.
  pub clipBounds: Rect<f32>,
  pub bounds: Rect<f32>,
  pub mask: ContentMask,
  pub tile: AtlasTile,
  pub opacity: f32,
  pub cornerRadii: Corners<f32>,
  /// Draw as luminance only (Rec. 709 weights on the sRGB channels).
  pub grayscale: bool,
}

impl Copy for ImageSprite {}

/// A rasterized vector path: coverage strips from `vector`, placed at an integer pixel origin.
///
/// The strips, fills and alphas live in the scene ([`Scene.pathStrips`], [`Scene.pathFills`],
/// [`Scene.pathAlphas`]); this record holds their ranges. Strip and fill coordinates are relative to
/// `(x, y)`, and their 4-row bands start at `y`, which need not be a multiple of 4.
pub struct PathSprite {
  pub x: i32,
  pub y: i32,
  pub width: u32,
  pub height: u32,
  pub mask: ContentMask,
  pub paint: Background,
  /// The box a gradient paint spans, in device pixels: the path's bounds.
  pub paintBounds: Rect<f32>,
  pub stripStart: u32,
  pub stripCount: u32,
  pub fillStart: u32,
  pub fillCount: u32,
}

impl Copy for PathSprite {}

impl PathSprite {
  /// The pixels the coverage spans.
  pub fn bounds(self: &Self) -> Rect<f32> {
    let x = i32.toF32(self.x)
    let y = i32.toF32(self.y)
    return Rect<f32>.new(x, y, x + u32.toF32(self.width), y + u32.toF32(self.height))
  }
}

/// How an isolated layer is composited onto what is under it.
pub struct Isolation {
  /// Group opacity in `0 ..= 1`.
  pub opacity: f32,
  /// A `vector.layer` blend mode (`BLEND_NORMAL` and the others).
  pub blend: u8,
}

impl Copy for Isolation {}

/// An isolated layer as its parent sees it: one item, drawn by rendering the layer's own batches
/// into an offscreen target of `bounds` and compositing that with `isolation`.
pub struct LayerSprite {
  /// The layer index to pass to [`Scene.batches`].
  pub layer: u32,
  /// The offscreen target: the requested bounds clipped to the content mask, rounded out to pixels.
  pub bounds: Rect<f32>,
  pub isolation: Isolation,
  /// Filters applied before this layer is composited.
  pub effects: LayerEffects,
  /// Where the layer's pixels land: a projective map from a layer pixel `(x, y, 1)` to a target
  /// pixel. The identity for a layer drawn where it was painted; then `bounds` is also what the
  /// layer holds. A transformed layer has no `effects`; it holds the pixels of `source`.
  pub transform: Matrix3<f32>,
  pub source: Rect<f32>,
}

impl Copy for LayerSprite {}

impl LayerSprite {
  /// Whether the layer is drawn through a transform other than the identity.
  pub fn transformed(self: &Self) -> bool {
    return &self.transform != &Matrix3<f32>.identity()
  }
}

/// The smallest rectangle holding `bounds` mapped through `transform`, cut to `limit`. Where a
/// corner maps behind the viewer (`w` not positive) the map is unbounded there, so the result
/// is `limit` itself.
pub fn mappedBounds(transform: Matrix3<f32>, bounds: Rect<f32>, limit: Rect<f32>) -> Rect<f32> {
  let xs = [bounds.xMin, bounds.xMax, bounds.xMin, bounds.xMax]
  let ys = [bounds.yMin, bounds.yMin, bounds.yMax, bounds.yMax]
  let mut xMin: f32 = 1.0e30
  let mut yMin: f32 = 1.0e30
  let mut xMax: f32 = -1.0e30
  let mut yMax: f32 = -1.0e30
  let mut i: usize = 0
  while i < 4 {
    let h = transform.transformHomogeneous(Point2<f32> { x: xs[i], y: ys[i] })
    if !(h.z > 0.000001) {
      return limit
    }
    let x = h.x / h.z
    let y = h.y / h.z
    xMin = f32.min(xMin, x)
    yMin = f32.min(yMin, y)
    xMax = f32.max(xMax, x)
    yMax = f32.max(yMax, y)
    i = i + 1
  }
  return Rect<f32>.new(
    f32.max(xMin, limit.xMin),
    f32.max(yMin, limit.yMin),
    f32.min(xMax, limit.xMax),
    f32.min(yMax, limit.yMax),
  )
}
