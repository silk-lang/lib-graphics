// Generated by silk task embed-shaders from modules/ui_renderer/shaders; do not edit.
pub fn quad() -> &'static [u8] { return b"// Shared by every UI pipeline (silk task embed-shaders prepends it). Coordinates are device pixels,\n// y down. Colors leave the fragment shaders premultiplied; the pipelines blend source-over.\nstruct Globals {\n  // Target width and height in pixels.\n  size: vec2f,\n  // Text: enhanced contrast for grayscale glyphs (0 turns it off).\n  contrast: f32,\n  unused: f32,\n  // Text: DirectWrite gamma correction ratios (all 0 turns it off).\n  gamma: vec4f,\n  // Image-only retained scenes: uniform scale, reserved, translation x/y.\n  imageCamera: vec4f,\n  // Where the target's pixel (0, 0) lies in scene pixels: an offscreen page holds only the part\n  // of the scene its layers cover. `size` is the target's own size. zw unused.\n  origin: vec4f,\n}\n@group(0) @binding(0) var<uniform> globals: Globals;\n\n// Corner radii, fitted on the CPU (Radii.fitted): horizontal `x` and vertical `y` of the\n// top-left, top-right, bottom-right and bottom-left corners. A corner with a zero radius is square.\nstruct Radii { x: vec4f, y: vec4f }\n\n// Gradient ramps, 256 premultiplied RGBA8 words each. Only quads and paths read it.\n@group(0) @binding(7) var<storage, read> ramps: array<u32>;\n\n// A layer drawn straight onto its parent's surface instead of through a texture: its primitives\n// keep the layer's own pixels and take this to where they land, faded by the layer's opacity.\n// Entry 0 is unused: a primitive whose transform is 0 is drawn where it lies. Paths do not read\n// it.\nstruct Transform {\n  // Rows of the map from a layer pixel to a scene pixel, `x' = dot(to0.xyz, (x, y, 1))`, and of\n  // its inverse.\n  to0: vec4f,\n  to1: vec4f,\n  from0: vec4f,\n  from1: vec4f,\n  // The scene pixels the layer may touch and their corner radii: the content mask it lands in.\n  // A texture would also cut the layer to the pixels it holds; drawn here, its primitives end\n  // where they end.\n  clip: vec4f,\n  clipRadii: Radii,\n  // x is the layer's opacity; the rest is unused.\n  more: vec4f,\n}\n@group(0) @binding(8) var<storage, read> transforms: array<Transform>;\n\nconst CORNERS = array<vec2f, 6>(vec2f(0.0, 0.0), vec2f(1.0, 0.0), vec2f(0.0, 1.0), vec2f(0.0, 1.0), vec2f(1.0, 0.0), vec2f(1.0, 1.0));\n\n// Clip space for corner `index` of the pixel rectangle `r` (xMin, yMin, xMax, yMax).\nfn corner(r: vec4f, index: u32) -> vec4f {\n  let c = CORNERS[index];\n  let p = mix(r.xy, r.zw, c) - globals.origin.xy;\n  return vec4f(p.x / globals.size.x * 2.0 - 1.0, 1.0 - p.y / globals.size.y * 2.0, 0.0, 1.0);\n}\n\n// The pixels a primitive drawing `bounds` under `mask` touches: their intersection rounded out to\n// whole pixels and clamped to the target, in scene pixels. Empty rectangles collapse to a point.\nfn cover(bounds: vec4f, mask: vec4f) -> vec4f {\n  let low = globals.origin.xy;\n  let high = low + globals.size;\n  let lo = clamp(floor(max(bounds.xy, mask.xy)), low, high);\n  let hi = clamp(ceil(min(bounds.zw, mask.zw)), low, high);\n  return vec4f(lo, max(hi, lo));\n}\n\n// A corner of a primitive: its clip space position and, for a transformed one, its layer pixel.\nstruct Placed { position: vec4f, local: vec2f }\n\n// Corner `index` of a primitive that draws `bounds` under `mask` through transform `transform`.\nfn place(bounds: vec4f, mask: vec4f, transform: u32, index: u32) -> Placed {\n  if transform == 0u { return Placed(corner(cover(bounds, mask), index), vec2f(0.0)); }\n  let t = transforms[transform];\n  // The layer pixels it touches, wider by what one device pixel spans for the edges' ramps.\n  let lo = max(bounds.xy, mask.xy);\n  let hi = max(min(bounds.zw, mask.zw), lo);\n  let margin = vec2f(abs(t.from0.x) + abs(t.from0.y), abs(t.from1.x) + abs(t.from1.y));\n  let local = mix(lo - margin, hi + margin, CORNERS[index]);\n  let p = vec2f(dot(t.to0.xyz, vec3f(local, 1.0)), dot(t.to1.xyz, vec3f(local, 1.0))) - globals.origin.xy;\n  return Placed(vec4f(p.x / globals.size.x * 2.0 - 1.0, 1.0 - p.y / globals.size.y * 2.0, 0.0, 1.0), local);\n}\n\n// A fragment of a primitive: `p` is its center in the primitive's own pixels (scene pixels, or\n// the layer's for a transformed one), `scale` the device pixels one of those spans along x and\n// along y, and `keep` how much of the pixel the transform's clip keeps.\nstruct Spot { p: vec2f, scale: vec2f, keep: f32 }\n\nfn spot(position: vec4f, local: vec2f, transform: u32) -> Spot {\n  let device = position.xy + globals.origin.xy;\n  if transform == 0u { return Spot(device, vec2f(1.0), 1.0); }\n  let t = transforms[transform];\n  let scale = vec2f(length(vec2f(t.to0.x, t.to1.x)), length(vec2f(t.to0.y, t.to1.y)));\n  let keep = areaIn(t.clip, device) * cornerCoverage(t.clip, t.clipRadii, device) * t.more.x;\n  return Spot(local, scale, keep);\n}\n\n// How much of the pixel square around `p` (a pixel center) lies in `r`, as the CPU reference clips.\nfn areaIn(r: vec4f, p: vec2f) -> f32 {\n  let lo = max(p - 0.5, r.xy);\n  let hi = min(p + 0.5, r.zw);\n  let d = clamp(hi - lo, vec2f(0.0), vec2f(1.0));\n  return d.x * d.y;\n}\n\n// `areaIn` where a pixel of `r` spans `scale` device pixels: the device pixel around `p` is\n// `1 / scale` of them wide.\nfn areaInAt(r: vec4f, p: vec2f, scale: vec2f) -> f32 {\n  let half = 0.5 / scale;\n  let lo = max(p - half, r.xy);\n  let hi = min(p + half, r.zw);\n  let d = clamp((hi - lo) * scale, vec2f(0.0), vec2f(1.0));\n  return d.x * d.y;\n}\n\n// The device pixels in one pixel of a shape along its outward normal `n`, where the shape's\n// pixels span `scale` device pixels.\nfn along(n: vec2f, scale: vec2f) -> f32 {\n  return 1.0 / max(length(n / scale), 0.000001);\n}\n\n// The radii (horizontal, vertical) of the corner of quadrant `q` (from the center).\nfn pickRadii(q: vec2f, r: Radii) -> vec2f {\n  if q.x < 0.0 {\n    return select(vec2f(r.x.w, r.y.w), vec2f(r.x.x, r.y.x), q.y < 0.0);\n  }\n  return select(vec2f(r.x.z, r.y.z), vec2f(r.x.y, r.y.y), q.y < 0.0);\n}\n\n// Signed distance to the ellipse with radii `e` from `d`, a point measured from its center: the\n// implicit function over its gradient, exact for a circle. Matches radii.ellipseDistance.\nfn ellipseDistance(d: vec2f, e: vec2f) -> f32 {\n  let k1 = length(d / (e * e));\n  if k1 <= 0.0 { return -min(e.x, e.y); }\n  let k0 = length(d / e);\n  return k0 * (k0 - 1.0) / k1;\n}\n\n// Signed distance from `a`, a point folded into the positive quadrant of a rectangle of half size\n// `half`, to that rectangle with the corner there the quarter ellipse with radii `e`.\nfn foldedRectSdf(a: vec2f, half: vec2f, e: vec2f) -> f32 {\n  let d = a - (half - e);\n  // Circular and square corners, the common case, take the branch-free circle distance.\n  if e.x == e.y { return min(max(d.x, d.y), 0.0) + length(max(d, vec2f(0.0))) - e.x; }\n  if d.x > 0.0 && d.y > 0.0 && e.x > 0.0 && e.y > 0.0 {\n    return ellipseDistance(d, e);\n  }\n  let b = a - half;\n  return min(max(b.x, b.y), 0.0) + length(max(b, vec2f(0.0)));\n}\n\n// Signed distance from `p` to rectangle `r` with corners `radii`; negative inside.\nfn roundedRectSdf(p: vec2f, r: vec4f, radii: Radii) -> f32 {\n  let half = (r.zw - r.xy) * 0.5;\n  let q = p - (r.xy + half);\n  return foldedRectSdf(abs(q), half, max(pickRadii(q, radii), vec2f(0.0)));\n}\n\n// Whether any corner of `radii` is rounded.\nfn isRounded(radii: Radii) -> bool {\n  return max(max(radii.x.x, radii.x.y), max(radii.x.z, radii.x.w)) > 0.0;\n}\n\n// The outward normal at `d` (from the corner's center) of the corner with radii `e`.\nfn cornerNormal(d: vec2f, e: vec2f) -> vec2f {\n  if e.x > 0.0 && e.y > 0.0 { return normalize(d / (e * e)); }\n  return normalize(d);\n}\n\n// How much of the pixel centered at `p` the rounded corners `radii` of content mask `r` keep: 1\n// away from the corners, so the rectangle stays `areaIn`'s. Matches ContentMask.cornerCoverage.\nfn cornerCoverage(r: vec4f, radii: Radii, p: vec2f) -> f32 {\n  return cornerCoverageAt(r, radii, p, vec2f(1.0));\n}\n\n// `cornerCoverage` where a pixel of `r` spans `scale` device pixels.\nfn cornerCoverageAt(r: vec4f, radii: Radii, p: vec2f, scale: vec2f) -> f32 {\n  if !isRounded(radii) { return 1.0; }\n  let half = (r.zw - r.xy) * 0.5;\n  let q = p - (r.xy + half);\n  let e = pickRadii(q, radii);\n  if e.x <= 0.0 || e.y <= 0.0 { return 1.0; }\n  let d = abs(q) - half + e;\n  if d.x <= 0.0 || d.y <= 0.0 { return 1.0; }\n  var distance = length(d) - e.x;\n  if e.x != e.y { distance = ellipseDistance(d, e); }\n  if scale.x == 1.0 && scale.y == 1.0 { return clamp(0.5 - distance, 0.0, 1.0); }\n  return clamp(0.5 - distance * along(cornerNormal(d, e), scale), 0.0, 1.0);\n}\n\n// Coverage of the pixel at `p` by rectangle `r` with corners `radii`, where a pixel of `r` spans\n// `scale` device pixels: `coverage(roundedRectSdf(p, r, radii))` at scale 1.\nfn roundedCoverage(p: vec2f, r: vec4f, radii: Radii, scale: vec2f) -> f32 {\n  let distance = roundedRectSdf(p, r, radii);\n  if scale.x == 1.0 && scale.y == 1.0 { return coverage(distance); }\n  let half = (r.zw - r.xy) * 0.5;\n  let q = p - (r.xy + half);\n  let e = max(pickRadii(q, radii), vec2f(0.0));\n  let d = abs(q) - half + e;\n  var n = vec2f(0.0, 1.0);\n  if d.x > 0.0 && d.y > 0.0 { n = cornerNormal(d, e); } else if d.x > d.y { n = vec2f(1.0, 0.0); }\n  return coverage(distance * along(n, scale));\n}\n\n// Signed distance from `p` to rectangle `r` whose corner in `p`'s quadrant is the quarter\n// ellipse with radii `e`.\nfn ellipticRectSdf(p: vec2f, r: vec4f, e: vec2f) -> f32 {\n  let half = (r.zw - r.xy) * 0.5;\n  return foldedRectSdf(abs(p - (r.xy + half)), half, e);\n}\n\n// Coverage of the pixel at `p` from a signed distance: exact for a straight edge.\nfn coverage(distance: f32) -> f32 {\n  return clamp(0.5 - distance, 0.0, 1.0);\n}\n\n// A background: a solid color or a CSS gradient. `kind.x` is 0 for solid, 1 for a two-stop linear\n// gradient mixed here in sRGB, 2 for one read from ramp `kind.y` of `ramps` (any other\n// interpolation, sampled on the CPU with silk.color), 3 for a gradient with any number of stops\n// mixed here in sRGB: `first.x` of them at word `kind.y` of `ramps`, five words each (the offset,\n// then the straight color), repeating when `first.y` is 1. With any other interpolation `first.z`\n// is one more than the first of their ramps, one per pair of neighbours. `kind.w` is the shape: 0 linear,\n// 1 radial, 2 conic. For two stops `first` and `last` hold them, straight sRGB (`first` is the\n// solid color). `line` is the center and then the direction (linear), the reciprocal radii\n// (radial) or the start angle in turns (conic); `stops` holds the linear half length and the two\n// stop offsets.\nstruct Paint {\n  kind: vec4u,\n  first: vec4f,\n  last: vec4f,\n  line: vec4f,\n  stops: vec4f,\n}\n\nfn premultiply(c: vec4f) -> vec4f {\n  let s = clamp(c, vec4f(0.0), vec4f(1.0));\n  return vec4f(s.rgb * s.a, s.a);\n}\n\n// The premultiplied color of `paint` at pixel center `p`. Gradients take their parameter in\n// 1/255 steps and mix premultiplied, as the CPU reference's 256-entry ramp does.\nfn shade(paint: Paint, p: vec2f) -> vec4f {\n  if paint.kind.x == 0u { return premultiply(paint.first); }\n  let d = p - paint.line.xy;\n  var along = dot(d, paint.line.zw) / paint.stops.x * 0.5 + 0.5;\n  if paint.kind.w == 1u {\n    along = length(d * paint.line.zw);\n  } else if paint.kind.w == 2u {\n    let a = atan2(d.x, -d.y) / 6.2831855 - paint.line.z;\n    along = a - floor(a);\n  }\n  if paint.kind.x == 3u { return shadeStops(paint, along); }\n  let span = paint.stops.z - paint.stops.y;\n  var t = select(0.0, 1.0, along >= paint.stops.y);\n  if span > 0.0 { t = (along - paint.stops.y) / span; }\n  let step = floor(clamp(t, 0.0, 1.0) * 255.0 + 0.5);\n  if paint.kind.x == 2u { return unpack4x8unorm(ramps[paint.kind.y * 256u + u32(step)]); }\n  return mixPremultiplied(paint.first, paint.last, step / 255.0);\n}\n\n// Straight colors `a` and `b` mixed premultiplied at `t`.\nfn mixPremultiplied(a: vec4f, b: vec4f, t: f32) -> vec4f {\n  let aa = clamp(a.a, 0.0, 1.0);\n  let ba = clamp(b.a, 0.0, 1.0);\n  let alpha = aa + (ba - aa) * t;\n  if !(alpha > 0.0) { return vec4f(0.0); }\n  let c = (a.rgb * aa + (b.rgb * ba - a.rgb * aa) * t) / alpha;\n  return premultiply(vec4f(c, alpha));\n}\n\nfn stopOffset(base: u32, i: u32) -> f32 {\n  return bitcast<f32>(ramps[base + i * 5u]);\n}\n\nfn stopColor(base: u32, i: u32) -> vec4f {\n  let w = base + i * 5u;\n  return vec4f(bitcast<f32>(ramps[w + 1u]), bitcast<f32>(ramps[w + 2u]), bitcast<f32>(ramps[w + 3u]), bitcast<f32>(ramps[w + 4u]));\n}\n\n// The stops of `paint` at offset `along`, mixed in 1/255 steps between neighbours.\nfn shadeStops(paint: Paint, along: f32) -> vec4f {\n  let base = paint.kind.y;\n  let n = u32(paint.first.x);\n  if n == 0u { return vec4f(0.0); }\n  let first = stopOffset(base, 0u);\n  let period = stopOffset(base, n - 1u) - first;\n  var a = along;\n  if paint.first.y > 0.5 && period > 0.000001 {\n    let k = (a - first) / period;\n    a = first + (k - floor(k)) * period;\n  }\n  var i = 0u;\n  loop {\n    if i + 1u >= n || stopOffset(base, i + 1u) > a { break; }\n    i = i + 1u;\n  }\n  if i + 1u >= n || a < first { return mixPremultiplied(stopColor(base, i), stopColor(base, i), 0.0); }\n  let lo = stopOffset(base, i);\n  let t = (a - lo) / (stopOffset(base, i + 1u) - lo);\n  let step = floor(clamp(t, 0.0, 1.0) * 255.0 + 0.5);\n  if paint.first.z > 0.5 {\n    return unpack4x8unorm(ramps[(u32(paint.first.z) - 1u + i) * 256u + u32(step)]);\n  }\n  return mixPremultiplied(stopColor(base, i), stopColor(base, i + 1u), step / 255.0);\n}\n// Quads: a rounded rectangle filled with a paint, and a solid or dashed border band over it.\nstruct Quad {\n  bounds: vec4f,\n  mask: vec4f,\n  radii: Radii,\n  // top, right, bottom, left\n  borders: vec4f,\n  // straight alpha; `paint.kind.z` is 1 for a dashed border\n  borderColor: vec4f,\n  paint: Paint,\n  maskRadii: Radii,\n}\n@group(0) @binding(1) var<storage, read> quads: array<Quad>;\n\nstruct Varying { @builtin(position) position: vec4f, @location(0) @interpolate(flat) index: u32, @location(1) local: vec2f }\n\n// A quad's transform rides in the spare word of its paint.\nfn transformOf(q: Quad) -> u32 { return u32(q.paint.stops.w); }\n\n@vertex fn vs(@builtin(vertex_index) v: u32, @builtin(instance_index) index: u32) -> Varying {\n  let q = quads[index];\n  let placed = place(q.bounds, q.mask, transformOf(q), v);\n  return Varying(placed.position, index, placed.local);\n}\n\nconst PI: f32 = 3.141592653589793;\n\n// A quarter of an ellipse's perimeter (Ramanujan).\nfn quarterArc(e: vec2f) -> f32 {\n  if e.x <= 0.0 || e.y <= 0.0 { return 0.0; }\n  return PI * 0.25 * (3.0 * (e.x + e.y) - sqrt((3.0 * e.x + e.y) * (e.x + 3.0 * e.y)));\n}\n\n// Where along the outline of `r` (corner radii `tl`, `tr`, `br`, `bl` as x, y pairs) the point\n// nearest to `p` lies, measured from the bottom of the top-left corner, clockwise.\nfn perimeterPosition(p: vec2f, r: vec4f, tl: vec2f, tr: vec2f, br: vec2f, bl: vec2f) -> f32 {\n  let arcs = vec4f(quarterArc(tl), quarterArc(tr), quarterArc(br), quarterArc(bl));\n  let top = max(r.z - tr.x - (r.x + tl.x), 0.0);\n  let right = max(r.w - br.y - (r.y + tr.y), 0.0);\n  let bottom = max(r.z - br.x - (r.x + bl.x), 0.0);\n  let start1 = arcs.x;\n  let start2 = start1 + top;\n  let start3 = start2 + arcs.y;\n  let start4 = start3 + right;\n  let start5 = start4 + arcs.z;\n  let start6 = start5 + bottom;\n  let start7 = start6 + arcs.w;\n\n  // Corner zones, by the arc's angle (y down: angles grow clockwise).\n  if p.x < r.x + tl.x && p.y < r.y + tl.y && arcs.x > 0.0 {\n    let d = (p - (r.xy + tl)) / tl;\n    let a = atan2(d.y, d.x) + 2.0 * PI;\n    return clamp((a - PI) / (0.5 * PI), 0.0, 1.0) * arcs.x;\n  }\n  if p.x > r.z - tr.x && p.y < r.y + tr.y && arcs.y > 0.0 {\n    let d = (p - vec2f(r.z - tr.x, r.y + tr.y)) / tr;\n    let a = atan2(d.y, d.x) + 2.0 * PI;\n    return start2 + clamp((a - 1.5 * PI) / (0.5 * PI), 0.0, 1.0) * arcs.y;\n  }\n  if p.x > r.z - br.x && p.y > r.w - br.y && arcs.z > 0.0 {\n    let d = (p - (r.zw - br)) / br;\n    let a = atan2(d.y, d.x);\n    return start4 + clamp(a / (0.5 * PI), 0.0, 1.0) * arcs.z;\n  }\n  if p.x < r.x + bl.x && p.y > r.w - bl.y && arcs.w > 0.0 {\n    let d = (p - vec2f(r.x + bl.x, r.w - bl.y)) / bl;\n    let a = atan2(d.y, d.x);\n    return start6 + clamp((a - 0.5 * PI) / (0.5 * PI), 0.0, 1.0) * arcs.w;\n  }\n\n  // Otherwise the nearest straight side.\n  let distances = vec4f(abs(p.y - r.y), abs(p.x - r.z), abs(p.y - r.w), abs(p.x - r.x));\n  let nearest = min(min(distances.x, distances.y), min(distances.z, distances.w));\n  if nearest == distances.x { return start1 + clamp(p.x - (r.x + tl.x), 0.0, top); }\n  if nearest == distances.y { return start3 + clamp(p.y - (r.y + tr.y), 0.0, right); }\n  if nearest == distances.z { return start5 + clamp(r.z - br.x - p.x, 0.0, bottom); }\n  let left = max(r.w - bl.y - (r.y + tl.y), 0.0);\n  return start7 + clamp(r.w - bl.y - p.y, 0.0, left);\n}\n\n// Coverage of dashes `2 w` long with gaps `w`, starting on at position 0.\nfn dashCoverage(s: f32, w: f32) -> f32 {\n  let period = 3.0 * w;\n  let m = s - period * floor(s / period);\n  if m < 2.0 * w {\n    return clamp(0.5 + min(m, 2.0 * w - m), 0.0, 1.0);\n  }\n  return clamp(0.5 - min(m - 2.0 * w, period - m), 0.0, 1.0);\n}\n\n@fragment fn fs(v: Varying) -> @location(0) vec4f {\n  let q = quads[v.index];\n  let at = spot(v.position, v.local, transformOf(q));\n  let p = at.p;\n  let clip = areaInAt(q.mask, p, at.scale) * cornerCoverageAt(q.mask, q.maskRadii, p, at.scale) * at.keep;\n  if clip <= 0.0 { discard; }\n  // The device pixels in one of the quad's, for the edges no normal is known for.\n  let unit = sqrt(at.scale.x * at.scale.y);\n  let radii = q.radii;\n  let outer = roundedCoverage(p, q.bounds, radii, at.scale);\n  let background = shade(q.paint, p) * outer;\n\n  var border = vec4f(0.0);\n  let w = q.borders;\n  if q.borderColor.a > 0.0 && max(max(w.x, w.y), max(w.z, w.w)) > 0.0 {\n    // The band between the outline and the inner outline inset by the widths, whose corners have\n    // radii (rx - left or right, ry - top or bottom), as CSS's padding edge.\n    let inner = vec4f(q.bounds.x + w.w, q.bounds.y + w.x, q.bounds.z - w.y, q.bounds.w - w.z);\n    var inside = 0.0;\n    if inner.x < inner.z && inner.y < inner.w {\n      let c = p - (inner.xy + inner.zw) * 0.5;\n      let sides = vec2f(select(w.y, w.w, c.x < 0.0), select(w.z, w.x, c.y < 0.0));\n      let e = pickRadii(c, radii) - sides;\n      inside = coverage(ellipticRectSdf(p, inner, max(e, vec2f(0.0))) * unit);\n    }\n    var band = max(outer - inside, 0.0);\n    if q.paint.kind.z == 1u && band > 0.0 {\n      // Dashes along the band's center line, as long as twice the widest edge.\n      let widest = max(max(w.x, w.y), max(w.z, w.w));\n      let mid = vec4f(q.bounds.x + w.w * 0.5, q.bounds.y + w.x * 0.5, q.bounds.z - w.y * 0.5, q.bounds.w - w.z * 0.5);\n      let tl = max(vec2f(radii.x.x - w.w * 0.5, radii.y.x - w.x * 0.5), vec2f(0.0));\n      let tr = max(vec2f(radii.x.y - w.y * 0.5, radii.y.y - w.x * 0.5), vec2f(0.0));\n      let br = max(vec2f(radii.x.z - w.y * 0.5, radii.y.z - w.z * 0.5), vec2f(0.0));\n      let bl = max(vec2f(radii.x.w - w.w * 0.5, radii.y.w - w.z * 0.5), vec2f(0.0));\n      band = band * dashCoverage(perimeterPosition(p, mid, tl, tr, br, bl) * unit, widest * unit);\n    }\n    border = premultiply(q.borderColor) * band;\n  }\n  let b = border * clip;\n  let g = background * clip;\n  return b + g * (1.0 - b.a);\n}\n" }
pub fn shadow() -> &'static [u8] { return b"// Shared by every UI pipeline (silk task embed-shaders prepends it). Coordinates are device pixels,\n// y down. Colors leave the fragment shaders premultiplied; the pipelines blend source-over.\nstruct Globals {\n  // Target width and height in pixels.\n  size: vec2f,\n  // Text: enhanced contrast for grayscale glyphs (0 turns it off).\n  contrast: f32,\n  unused: f32,\n  // Text: DirectWrite gamma correction ratios (all 0 turns it off).\n  gamma: vec4f,\n  // Image-only retained scenes: uniform scale, reserved, translation x/y.\n  imageCamera: vec4f,\n  // Where the target's pixel (0, 0) lies in scene pixels: an offscreen page holds only the part\n  // of the scene its layers cover. `size` is the target's own size. zw unused.\n  origin: vec4f,\n}\n@group(0) @binding(0) var<uniform> globals: Globals;\n\n// Corner radii, fitted on the CPU (Radii.fitted): horizontal `x` and vertical `y` of the\n// top-left, top-right, bottom-right and bottom-left corners. A corner with a zero radius is square.\nstruct Radii { x: vec4f, y: vec4f }\n\n// Gradient ramps, 256 premultiplied RGBA8 words each. Only quads and paths read it.\n@group(0) @binding(7) var<storage, read> ramps: array<u32>;\n\n// A layer drawn straight onto its parent's surface instead of through a texture: its primitives\n// keep the layer's own pixels and take this to where they land, faded by the layer's opacity.\n// Entry 0 is unused: a primitive whose transform is 0 is drawn where it lies. Paths do not read\n// it.\nstruct Transform {\n  // Rows of the map from a layer pixel to a scene pixel, `x' = dot(to0.xyz, (x, y, 1))`, and of\n  // its inverse.\n  to0: vec4f,\n  to1: vec4f,\n  from0: vec4f,\n  from1: vec4f,\n  // The scene pixels the layer may touch and their corner radii: the content mask it lands in.\n  // A texture would also cut the layer to the pixels it holds; drawn here, its primitives end\n  // where they end.\n  clip: vec4f,\n  clipRadii: Radii,\n  // x is the layer's opacity; the rest is unused.\n  more: vec4f,\n}\n@group(0) @binding(8) var<storage, read> transforms: array<Transform>;\n\nconst CORNERS = array<vec2f, 6>(vec2f(0.0, 0.0), vec2f(1.0, 0.0), vec2f(0.0, 1.0), vec2f(0.0, 1.0), vec2f(1.0, 0.0), vec2f(1.0, 1.0));\n\n// Clip space for corner `index` of the pixel rectangle `r` (xMin, yMin, xMax, yMax).\nfn corner(r: vec4f, index: u32) -> vec4f {\n  let c = CORNERS[index];\n  let p = mix(r.xy, r.zw, c) - globals.origin.xy;\n  return vec4f(p.x / globals.size.x * 2.0 - 1.0, 1.0 - p.y / globals.size.y * 2.0, 0.0, 1.0);\n}\n\n// The pixels a primitive drawing `bounds` under `mask` touches: their intersection rounded out to\n// whole pixels and clamped to the target, in scene pixels. Empty rectangles collapse to a point.\nfn cover(bounds: vec4f, mask: vec4f) -> vec4f {\n  let low = globals.origin.xy;\n  let high = low + globals.size;\n  let lo = clamp(floor(max(bounds.xy, mask.xy)), low, high);\n  let hi = clamp(ceil(min(bounds.zw, mask.zw)), low, high);\n  return vec4f(lo, max(hi, lo));\n}\n\n// A corner of a primitive: its clip space position and, for a transformed one, its layer pixel.\nstruct Placed { position: vec4f, local: vec2f }\n\n// Corner `index` of a primitive that draws `bounds` under `mask` through transform `transform`.\nfn place(bounds: vec4f, mask: vec4f, transform: u32, index: u32) -> Placed {\n  if transform == 0u { return Placed(corner(cover(bounds, mask), index), vec2f(0.0)); }\n  let t = transforms[transform];\n  // The layer pixels it touches, wider by what one device pixel spans for the edges' ramps.\n  let lo = max(bounds.xy, mask.xy);\n  let hi = max(min(bounds.zw, mask.zw), lo);\n  let margin = vec2f(abs(t.from0.x) + abs(t.from0.y), abs(t.from1.x) + abs(t.from1.y));\n  let local = mix(lo - margin, hi + margin, CORNERS[index]);\n  let p = vec2f(dot(t.to0.xyz, vec3f(local, 1.0)), dot(t.to1.xyz, vec3f(local, 1.0))) - globals.origin.xy;\n  return Placed(vec4f(p.x / globals.size.x * 2.0 - 1.0, 1.0 - p.y / globals.size.y * 2.0, 0.0, 1.0), local);\n}\n\n// A fragment of a primitive: `p` is its center in the primitive's own pixels (scene pixels, or\n// the layer's for a transformed one), `scale` the device pixels one of those spans along x and\n// along y, and `keep` how much of the pixel the transform's clip keeps.\nstruct Spot { p: vec2f, scale: vec2f, keep: f32 }\n\nfn spot(position: vec4f, local: vec2f, transform: u32) -> Spot {\n  let device = position.xy + globals.origin.xy;\n  if transform == 0u { return Spot(device, vec2f(1.0), 1.0); }\n  let t = transforms[transform];\n  let scale = vec2f(length(vec2f(t.to0.x, t.to1.x)), length(vec2f(t.to0.y, t.to1.y)));\n  let keep = areaIn(t.clip, device) * cornerCoverage(t.clip, t.clipRadii, device) * t.more.x;\n  return Spot(local, scale, keep);\n}\n\n// How much of the pixel square around `p` (a pixel center) lies in `r`, as the CPU reference clips.\nfn areaIn(r: vec4f, p: vec2f) -> f32 {\n  let lo = max(p - 0.5, r.xy);\n  let hi = min(p + 0.5, r.zw);\n  let d = clamp(hi - lo, vec2f(0.0), vec2f(1.0));\n  return d.x * d.y;\n}\n\n// `areaIn` where a pixel of `r` spans `scale` device pixels: the device pixel around `p` is\n// `1 / scale` of them wide.\nfn areaInAt(r: vec4f, p: vec2f, scale: vec2f) -> f32 {\n  let half = 0.5 / scale;\n  let lo = max(p - half, r.xy);\n  let hi = min(p + half, r.zw);\n  let d = clamp((hi - lo) * scale, vec2f(0.0), vec2f(1.0));\n  return d.x * d.y;\n}\n\n// The device pixels in one pixel of a shape along its outward normal `n`, where the shape's\n// pixels span `scale` device pixels.\nfn along(n: vec2f, scale: vec2f) -> f32 {\n  return 1.0 / max(length(n / scale), 0.000001);\n}\n\n// The radii (horizontal, vertical) of the corner of quadrant `q` (from the center).\nfn pickRadii(q: vec2f, r: Radii) -> vec2f {\n  if q.x < 0.0 {\n    return select(vec2f(r.x.w, r.y.w), vec2f(r.x.x, r.y.x), q.y < 0.0);\n  }\n  return select(vec2f(r.x.z, r.y.z), vec2f(r.x.y, r.y.y), q.y < 0.0);\n}\n\n// Signed distance to the ellipse with radii `e` from `d`, a point measured from its center: the\n// implicit function over its gradient, exact for a circle. Matches radii.ellipseDistance.\nfn ellipseDistance(d: vec2f, e: vec2f) -> f32 {\n  let k1 = length(d / (e * e));\n  if k1 <= 0.0 { return -min(e.x, e.y); }\n  let k0 = length(d / e);\n  return k0 * (k0 - 1.0) / k1;\n}\n\n// Signed distance from `a`, a point folded into the positive quadrant of a rectangle of half size\n// `half`, to that rectangle with the corner there the quarter ellipse with radii `e`.\nfn foldedRectSdf(a: vec2f, half: vec2f, e: vec2f) -> f32 {\n  let d = a - (half - e);\n  // Circular and square corners, the common case, take the branch-free circle distance.\n  if e.x == e.y { return min(max(d.x, d.y), 0.0) + length(max(d, vec2f(0.0))) - e.x; }\n  if d.x > 0.0 && d.y > 0.0 && e.x > 0.0 && e.y > 0.0 {\n    return ellipseDistance(d, e);\n  }\n  let b = a - half;\n  return min(max(b.x, b.y), 0.0) + length(max(b, vec2f(0.0)));\n}\n\n// Signed distance from `p` to rectangle `r` with corners `radii`; negative inside.\nfn roundedRectSdf(p: vec2f, r: vec4f, radii: Radii) -> f32 {\n  let half = (r.zw - r.xy) * 0.5;\n  let q = p - (r.xy + half);\n  return foldedRectSdf(abs(q), half, max(pickRadii(q, radii), vec2f(0.0)));\n}\n\n// Whether any corner of `radii` is rounded.\nfn isRounded(radii: Radii) -> bool {\n  return max(max(radii.x.x, radii.x.y), max(radii.x.z, radii.x.w)) > 0.0;\n}\n\n// The outward normal at `d` (from the corner's center) of the corner with radii `e`.\nfn cornerNormal(d: vec2f, e: vec2f) -> vec2f {\n  if e.x > 0.0 && e.y > 0.0 { return normalize(d / (e * e)); }\n  return normalize(d);\n}\n\n// How much of the pixel centered at `p` the rounded corners `radii` of content mask `r` keep: 1\n// away from the corners, so the rectangle stays `areaIn`'s. Matches ContentMask.cornerCoverage.\nfn cornerCoverage(r: vec4f, radii: Radii, p: vec2f) -> f32 {\n  return cornerCoverageAt(r, radii, p, vec2f(1.0));\n}\n\n// `cornerCoverage` where a pixel of `r` spans `scale` device pixels.\nfn cornerCoverageAt(r: vec4f, radii: Radii, p: vec2f, scale: vec2f) -> f32 {\n  if !isRounded(radii) { return 1.0; }\n  let half = (r.zw - r.xy) * 0.5;\n  let q = p - (r.xy + half);\n  let e = pickRadii(q, radii);\n  if e.x <= 0.0 || e.y <= 0.0 { return 1.0; }\n  let d = abs(q) - half + e;\n  if d.x <= 0.0 || d.y <= 0.0 { return 1.0; }\n  var distance = length(d) - e.x;\n  if e.x != e.y { distance = ellipseDistance(d, e); }\n  if scale.x == 1.0 && scale.y == 1.0 { return clamp(0.5 - distance, 0.0, 1.0); }\n  return clamp(0.5 - distance * along(cornerNormal(d, e), scale), 0.0, 1.0);\n}\n\n// Coverage of the pixel at `p` by rectangle `r` with corners `radii`, where a pixel of `r` spans\n// `scale` device pixels: `coverage(roundedRectSdf(p, r, radii))` at scale 1.\nfn roundedCoverage(p: vec2f, r: vec4f, radii: Radii, scale: vec2f) -> f32 {\n  let distance = roundedRectSdf(p, r, radii);\n  if scale.x == 1.0 && scale.y == 1.0 { return coverage(distance); }\n  let half = (r.zw - r.xy) * 0.5;\n  let q = p - (r.xy + half);\n  let e = max(pickRadii(q, radii), vec2f(0.0));\n  let d = abs(q) - half + e;\n  var n = vec2f(0.0, 1.0);\n  if d.x > 0.0 && d.y > 0.0 { n = cornerNormal(d, e); } else if d.x > d.y { n = vec2f(1.0, 0.0); }\n  return coverage(distance * along(n, scale));\n}\n\n// Signed distance from `p` to rectangle `r` whose corner in `p`'s quadrant is the quarter\n// ellipse with radii `e`.\nfn ellipticRectSdf(p: vec2f, r: vec4f, e: vec2f) -> f32 {\n  let half = (r.zw - r.xy) * 0.5;\n  return foldedRectSdf(abs(p - (r.xy + half)), half, e);\n}\n\n// Coverage of the pixel at `p` from a signed distance: exact for a straight edge.\nfn coverage(distance: f32) -> f32 {\n  return clamp(0.5 - distance, 0.0, 1.0);\n}\n\n// A background: a solid color or a CSS gradient. `kind.x` is 0 for solid, 1 for a two-stop linear\n// gradient mixed here in sRGB, 2 for one read from ramp `kind.y` of `ramps` (any other\n// interpolation, sampled on the CPU with silk.color), 3 for a gradient with any number of stops\n// mixed here in sRGB: `first.x` of them at word `kind.y` of `ramps`, five words each (the offset,\n// then the straight color), repeating when `first.y` is 1. With any other interpolation `first.z`\n// is one more than the first of their ramps, one per pair of neighbours. `kind.w` is the shape: 0 linear,\n// 1 radial, 2 conic. For two stops `first` and `last` hold them, straight sRGB (`first` is the\n// solid color). `line` is the center and then the direction (linear), the reciprocal radii\n// (radial) or the start angle in turns (conic); `stops` holds the linear half length and the two\n// stop offsets.\nstruct Paint {\n  kind: vec4u,\n  first: vec4f,\n  last: vec4f,\n  line: vec4f,\n  stops: vec4f,\n}\n\nfn premultiply(c: vec4f) -> vec4f {\n  let s = clamp(c, vec4f(0.0), vec4f(1.0));\n  return vec4f(s.rgb * s.a, s.a);\n}\n\n// The premultiplied color of `paint` at pixel center `p`. Gradients take their parameter in\n// 1/255 steps and mix premultiplied, as the CPU reference's 256-entry ramp does.\nfn shade(paint: Paint, p: vec2f) -> vec4f {\n  if paint.kind.x == 0u { return premultiply(paint.first); }\n  let d = p - paint.line.xy;\n  var along = dot(d, paint.line.zw) / paint.stops.x * 0.5 + 0.5;\n  if paint.kind.w == 1u {\n    along = length(d * paint.line.zw);\n  } else if paint.kind.w == 2u {\n    let a = atan2(d.x, -d.y) / 6.2831855 - paint.line.z;\n    along = a - floor(a);\n  }\n  if paint.kind.x == 3u { return shadeStops(paint, along); }\n  let span = paint.stops.z - paint.stops.y;\n  var t = select(0.0, 1.0, along >= paint.stops.y);\n  if span > 0.0 { t = (along - paint.stops.y) / span; }\n  let step = floor(clamp(t, 0.0, 1.0) * 255.0 + 0.5);\n  if paint.kind.x == 2u { return unpack4x8unorm(ramps[paint.kind.y * 256u + u32(step)]); }\n  return mixPremultiplied(paint.first, paint.last, step / 255.0);\n}\n\n// Straight colors `a` and `b` mixed premultiplied at `t`.\nfn mixPremultiplied(a: vec4f, b: vec4f, t: f32) -> vec4f {\n  let aa = clamp(a.a, 0.0, 1.0);\n  let ba = clamp(b.a, 0.0, 1.0);\n  let alpha = aa + (ba - aa) * t;\n  if !(alpha > 0.0) { return vec4f(0.0); }\n  let c = (a.rgb * aa + (b.rgb * ba - a.rgb * aa) * t) / alpha;\n  return premultiply(vec4f(c, alpha));\n}\n\nfn stopOffset(base: u32, i: u32) -> f32 {\n  return bitcast<f32>(ramps[base + i * 5u]);\n}\n\nfn stopColor(base: u32, i: u32) -> vec4f {\n  let w = base + i * 5u;\n  return vec4f(bitcast<f32>(ramps[w + 1u]), bitcast<f32>(ramps[w + 2u]), bitcast<f32>(ramps[w + 3u]), bitcast<f32>(ramps[w + 4u]));\n}\n\n// The stops of `paint` at offset `along`, mixed in 1/255 steps between neighbours.\nfn shadeStops(paint: Paint, along: f32) -> vec4f {\n  let base = paint.kind.y;\n  let n = u32(paint.first.x);\n  if n == 0u { return vec4f(0.0); }\n  let first = stopOffset(base, 0u);\n  let period = stopOffset(base, n - 1u) - first;\n  var a = along;\n  if paint.first.y > 0.5 && period > 0.000001 {\n    let k = (a - first) / period;\n    a = first + (k - floor(k)) * period;\n  }\n  var i = 0u;\n  loop {\n    if i + 1u >= n || stopOffset(base, i + 1u) > a { break; }\n    i = i + 1u;\n  }\n  if i + 1u >= n || a < first { return mixPremultiplied(stopColor(base, i), stopColor(base, i), 0.0); }\n  let lo = stopOffset(base, i);\n  let t = (a - lo) / (stopOffset(base, i + 1u) - lo);\n  let step = floor(clamp(t, 0.0, 1.0) * 255.0 + 0.5);\n  if paint.first.z > 0.5 {\n    return unpack4x8unorm(ramps[(u32(paint.first.z) - 1u + i) * 256u + u32(step)]);\n  }\n  return mixPremultiplied(stopColor(base, i), stopColor(base, i + 1u), step / 255.0);\n}\n// Shadows: a rounded rectangle blurred by a Gaussian, evaluated in closed form along x with an\n// erf approximation and integrated numerically along y (Evan Wallace's method, as GPUI does).\nstruct Shadow {\n  // The blurred shape: the box moved by the offset and grown (or, inset, shrunk) by the spread.\n  shape: vec4f,\n  mask: vec4f,\n  shapeRadii: Radii,\n  // straight alpha\n  color: vec4f,\n  // The box casting the shadow; an inset shadow draws only inside it.\n  box: vec4f,\n  boxRadii: Radii,\n  // Everything the shadow can touch.\n  reach: vec4f,\n  // sigma, inset (1 or 0), the transform\n  params: vec4f,\n  maskRadii: Radii,\n}\n@group(0) @binding(1) var<storage, read> shadows: array<Shadow>;\n\nstruct Varying { @builtin(position) position: vec4f, @location(0) @interpolate(flat) index: u32, @location(1) local: vec2f }\n\n@vertex fn vs(@builtin(vertex_index) v: u32, @builtin(instance_index) index: u32) -> Varying {\n  let s = shadows[index];\n  let placed = place(s.reach, s.mask, u32(s.params.z), v);\n  return Varying(placed.position, index, placed.local);\n}\n\nconst SQRT_HALF: f32 = 0.7071067811865476;\nconst SQRT_TAU: f32 = 2.5066282746310002;\nconst SAMPLES: i32 = 8;\n\nfn gaussian(x: f32, sigma: f32) -> f32 {\n  return exp(-(x * x) / (2.0 * sigma * sigma)) / (SQRT_TAU * sigma);\n}\n\n// Abramowitz and Stegun 7.1.27, |error| < 5e-4.\nfn erf2(v: vec2f) -> vec2f {\n  let s = sign(v);\n  let a = abs(v);\n  let r1 = 1.0 + (0.278393 + (0.230389 + (0.000972 + 0.078108 * a) * a) * a) * a;\n  let r2 = r1 * r1;\n  return s - s / (r2 * r2);\n}\n\n// How far row `y` (from the center) of a box of half size `half` reaches out from the center on\n// the side of the corner with radii `e`; `inverse` is 1 / e.y, or 0 for a square corner.\nfn reachAt(y: f32, e: vec2f, inverse: f32, half: vec2f) -> f32 {\n  let delta = min(half.y - e.y - abs(y), 0.0) * inverse;\n  return half.x - e.x + e.x * sqrt(max(0.0, 1.0 - delta * delta));\n}\n\n// 1 / e.y for a rounded corner with radii `e`, 0 for a square one.\nfn inverseOf(e: vec2f) -> f32 {\n  return select(0.0, 1.0 / e.y, e.x > 0.0 && e.y > 0.0);\n}\n\n@fragment fn fs(v: Varying) -> @location(0) vec4f {\n  let s = shadows[v.index];\n  let at = spot(v.position, v.local, u32(s.params.z));\n  let p = at.p;\n  let clip = areaInAt(s.mask, p, at.scale) * cornerCoverageAt(s.mask, s.maskRadii, p, at.scale) * at.keep;\n  if clip <= 0.0 { discard; }\n  let sigma = s.params.x;\n  var alpha = 0.0;\n  if s.shape.x < s.shape.z && s.shape.y < s.shape.w {\n    if sigma < 0.05 {\n      alpha = roundedCoverage(p, s.shape, s.shapeRadii, at.scale);\n    } else {\n      let half = (s.shape.zw - s.shape.xy) * 0.5;\n      let q = p - (s.shape.xy + half);\n      // The kernel is only non-zero over the shape's rows within 3 sigma.\n      let start = clamp(-3.0 * sigma, q.y - half.y, q.y + half.y);\n      let end = clamp(3.0 * sigma, q.y - half.y, q.y + half.y);\n      let step = (end - start) / f32(SAMPLES);\n      var y = start + step * 0.5;\n      // The corners on each side, above and below the center: a row reaches out to the corner\n      // on its side, so each sample takes one reach per side (one when the sides match).\n      let r = s.shapeRadii;\n      let mirrored = all(r.x.xw == r.x.yz) && all(r.y.xw == r.y.yz);\n      let leftTop = vec2f(r.x.x, r.y.x);\n      let leftBottom = vec2f(r.x.w, r.y.w);\n      let rightTop = vec2f(r.x.y, r.y.y);\n      let rightBottom = vec2f(r.x.z, r.y.z);\n      let inverses = vec4f(inverseOf(leftTop), inverseOf(leftBottom), inverseOf(rightTop), inverseOf(rightBottom));\n      let scale = SQRT_HALF / sigma;\n      for (var i = 0; i < SAMPLES; i += 1) {\n        let row = q.y - y;\n        let top = row < 0.0;\n        let left = reachAt(row, select(leftBottom, leftTop, top), select(inverses.y, inverses.x, top), half);\n        var right = left;\n        if !mirrored {\n          right = reachAt(row, select(rightBottom, rightTop, top), select(inverses.w, inverses.z, top), half);\n        }\n        let integral = 0.5 + 0.5 * erf2((q.x + vec2f(-right, left)) * scale);\n        alpha += (integral.y - integral.x) * gaussian(y, sigma) * step;\n        y += step;\n      }\n    }\n  }\n  if s.params.y != 0.0 {\n    alpha = (1.0 - alpha) * roundedCoverage(p, s.box, s.boxRadii, at.scale);\n  }\n  return premultiply(s.color) * (clamp(alpha, 0.0, 1.0) * clip);\n}\n" }
pub fn underline() -> &'static [u8] { return b"// Shared by every UI pipeline (silk task embed-shaders prepends it). Coordinates are device pixels,\n// y down. Colors leave the fragment shaders premultiplied; the pipelines blend source-over.\nstruct Globals {\n  // Target width and height in pixels.\n  size: vec2f,\n  // Text: enhanced contrast for grayscale glyphs (0 turns it off).\n  contrast: f32,\n  unused: f32,\n  // Text: DirectWrite gamma correction ratios (all 0 turns it off).\n  gamma: vec4f,\n  // Image-only retained scenes: uniform scale, reserved, translation x/y.\n  imageCamera: vec4f,\n  // Where the target's pixel (0, 0) lies in scene pixels: an offscreen page holds only the part\n  // of the scene its layers cover. `size` is the target's own size. zw unused.\n  origin: vec4f,\n}\n@group(0) @binding(0) var<uniform> globals: Globals;\n\n// Corner radii, fitted on the CPU (Radii.fitted): horizontal `x` and vertical `y` of the\n// top-left, top-right, bottom-right and bottom-left corners. A corner with a zero radius is square.\nstruct Radii { x: vec4f, y: vec4f }\n\n// Gradient ramps, 256 premultiplied RGBA8 words each. Only quads and paths read it.\n@group(0) @binding(7) var<storage, read> ramps: array<u32>;\n\n// A layer drawn straight onto its parent's surface instead of through a texture: its primitives\n// keep the layer's own pixels and take this to where they land, faded by the layer's opacity.\n// Entry 0 is unused: a primitive whose transform is 0 is drawn where it lies. Paths do not read\n// it.\nstruct Transform {\n  // Rows of the map from a layer pixel to a scene pixel, `x' = dot(to0.xyz, (x, y, 1))`, and of\n  // its inverse.\n  to0: vec4f,\n  to1: vec4f,\n  from0: vec4f,\n  from1: vec4f,\n  // The scene pixels the layer may touch and their corner radii: the content mask it lands in.\n  // A texture would also cut the layer to the pixels it holds; drawn here, its primitives end\n  // where they end.\n  clip: vec4f,\n  clipRadii: Radii,\n  // x is the layer's opacity; the rest is unused.\n  more: vec4f,\n}\n@group(0) @binding(8) var<storage, read> transforms: array<Transform>;\n\nconst CORNERS = array<vec2f, 6>(vec2f(0.0, 0.0), vec2f(1.0, 0.0), vec2f(0.0, 1.0), vec2f(0.0, 1.0), vec2f(1.0, 0.0), vec2f(1.0, 1.0));\n\n// Clip space for corner `index` of the pixel rectangle `r` (xMin, yMin, xMax, yMax).\nfn corner(r: vec4f, index: u32) -> vec4f {\n  let c = CORNERS[index];\n  let p = mix(r.xy, r.zw, c) - globals.origin.xy;\n  return vec4f(p.x / globals.size.x * 2.0 - 1.0, 1.0 - p.y / globals.size.y * 2.0, 0.0, 1.0);\n}\n\n// The pixels a primitive drawing `bounds` under `mask` touches: their intersection rounded out to\n// whole pixels and clamped to the target, in scene pixels. Empty rectangles collapse to a point.\nfn cover(bounds: vec4f, mask: vec4f) -> vec4f {\n  let low = globals.origin.xy;\n  let high = low + globals.size;\n  let lo = clamp(floor(max(bounds.xy, mask.xy)), low, high);\n  let hi = clamp(ceil(min(bounds.zw, mask.zw)), low, high);\n  return vec4f(lo, max(hi, lo));\n}\n\n// A corner of a primitive: its clip space position and, for a transformed one, its layer pixel.\nstruct Placed { position: vec4f, local: vec2f }\n\n// Corner `index` of a primitive that draws `bounds` under `mask` through transform `transform`.\nfn place(bounds: vec4f, mask: vec4f, transform: u32, index: u32) -> Placed {\n  if transform == 0u { return Placed(corner(cover(bounds, mask), index), vec2f(0.0)); }\n  let t = transforms[transform];\n  // The layer pixels it touches, wider by what one device pixel spans for the edges' ramps.\n  let lo = max(bounds.xy, mask.xy);\n  let hi = max(min(bounds.zw, mask.zw), lo);\n  let margin = vec2f(abs(t.from0.x) + abs(t.from0.y), abs(t.from1.x) + abs(t.from1.y));\n  let local = mix(lo - margin, hi + margin, CORNERS[index]);\n  let p = vec2f(dot(t.to0.xyz, vec3f(local, 1.0)), dot(t.to1.xyz, vec3f(local, 1.0))) - globals.origin.xy;\n  return Placed(vec4f(p.x / globals.size.x * 2.0 - 1.0, 1.0 - p.y / globals.size.y * 2.0, 0.0, 1.0), local);\n}\n\n// A fragment of a primitive: `p` is its center in the primitive's own pixels (scene pixels, or\n// the layer's for a transformed one), `scale` the device pixels one of those spans along x and\n// along y, and `keep` how much of the pixel the transform's clip keeps.\nstruct Spot { p: vec2f, scale: vec2f, keep: f32 }\n\nfn spot(position: vec4f, local: vec2f, transform: u32) -> Spot {\n  let device = position.xy + globals.origin.xy;\n  if transform == 0u { return Spot(device, vec2f(1.0), 1.0); }\n  let t = transforms[transform];\n  let scale = vec2f(length(vec2f(t.to0.x, t.to1.x)), length(vec2f(t.to0.y, t.to1.y)));\n  let keep = areaIn(t.clip, device) * cornerCoverage(t.clip, t.clipRadii, device) * t.more.x;\n  return Spot(local, scale, keep);\n}\n\n// How much of the pixel square around `p` (a pixel center) lies in `r`, as the CPU reference clips.\nfn areaIn(r: vec4f, p: vec2f) -> f32 {\n  let lo = max(p - 0.5, r.xy);\n  let hi = min(p + 0.5, r.zw);\n  let d = clamp(hi - lo, vec2f(0.0), vec2f(1.0));\n  return d.x * d.y;\n}\n\n// `areaIn` where a pixel of `r` spans `scale` device pixels: the device pixel around `p` is\n// `1 / scale` of them wide.\nfn areaInAt(r: vec4f, p: vec2f, scale: vec2f) -> f32 {\n  let half = 0.5 / scale;\n  let lo = max(p - half, r.xy);\n  let hi = min(p + half, r.zw);\n  let d = clamp((hi - lo) * scale, vec2f(0.0), vec2f(1.0));\n  return d.x * d.y;\n}\n\n// The device pixels in one pixel of a shape along its outward normal `n`, where the shape's\n// pixels span `scale` device pixels.\nfn along(n: vec2f, scale: vec2f) -> f32 {\n  return 1.0 / max(length(n / scale), 0.000001);\n}\n\n// The radii (horizontal, vertical) of the corner of quadrant `q` (from the center).\nfn pickRadii(q: vec2f, r: Radii) -> vec2f {\n  if q.x < 0.0 {\n    return select(vec2f(r.x.w, r.y.w), vec2f(r.x.x, r.y.x), q.y < 0.0);\n  }\n  return select(vec2f(r.x.z, r.y.z), vec2f(r.x.y, r.y.y), q.y < 0.0);\n}\n\n// Signed distance to the ellipse with radii `e` from `d`, a point measured from its center: the\n// implicit function over its gradient, exact for a circle. Matches radii.ellipseDistance.\nfn ellipseDistance(d: vec2f, e: vec2f) -> f32 {\n  let k1 = length(d / (e * e));\n  if k1 <= 0.0 { return -min(e.x, e.y); }\n  let k0 = length(d / e);\n  return k0 * (k0 - 1.0) / k1;\n}\n\n// Signed distance from `a`, a point folded into the positive quadrant of a rectangle of half size\n// `half`, to that rectangle with the corner there the quarter ellipse with radii `e`.\nfn foldedRectSdf(a: vec2f, half: vec2f, e: vec2f) -> f32 {\n  let d = a - (half - e);\n  // Circular and square corners, the common case, take the branch-free circle distance.\n  if e.x == e.y { return min(max(d.x, d.y), 0.0) + length(max(d, vec2f(0.0))) - e.x; }\n  if d.x > 0.0 && d.y > 0.0 && e.x > 0.0 && e.y > 0.0 {\n    return ellipseDistance(d, e);\n  }\n  let b = a - half;\n  return min(max(b.x, b.y), 0.0) + length(max(b, vec2f(0.0)));\n}\n\n// Signed distance from `p` to rectangle `r` with corners `radii`; negative inside.\nfn roundedRectSdf(p: vec2f, r: vec4f, radii: Radii) -> f32 {\n  let half = (r.zw - r.xy) * 0.5;\n  let q = p - (r.xy + half);\n  return foldedRectSdf(abs(q), half, max(pickRadii(q, radii), vec2f(0.0)));\n}\n\n// Whether any corner of `radii` is rounded.\nfn isRounded(radii: Radii) -> bool {\n  return max(max(radii.x.x, radii.x.y), max(radii.x.z, radii.x.w)) > 0.0;\n}\n\n// The outward normal at `d` (from the corner's center) of the corner with radii `e`.\nfn cornerNormal(d: vec2f, e: vec2f) -> vec2f {\n  if e.x > 0.0 && e.y > 0.0 { return normalize(d / (e * e)); }\n  return normalize(d);\n}\n\n// How much of the pixel centered at `p` the rounded corners `radii` of content mask `r` keep: 1\n// away from the corners, so the rectangle stays `areaIn`'s. Matches ContentMask.cornerCoverage.\nfn cornerCoverage(r: vec4f, radii: Radii, p: vec2f) -> f32 {\n  return cornerCoverageAt(r, radii, p, vec2f(1.0));\n}\n\n// `cornerCoverage` where a pixel of `r` spans `scale` device pixels.\nfn cornerCoverageAt(r: vec4f, radii: Radii, p: vec2f, scale: vec2f) -> f32 {\n  if !isRounded(radii) { return 1.0; }\n  let half = (r.zw - r.xy) * 0.5;\n  let q = p - (r.xy + half);\n  let e = pickRadii(q, radii);\n  if e.x <= 0.0 || e.y <= 0.0 { return 1.0; }\n  let d = abs(q) - half + e;\n  if d.x <= 0.0 || d.y <= 0.0 { return 1.0; }\n  var distance = length(d) - e.x;\n  if e.x != e.y { distance = ellipseDistance(d, e); }\n  if scale.x == 1.0 && scale.y == 1.0 { return clamp(0.5 - distance, 0.0, 1.0); }\n  return clamp(0.5 - distance * along(cornerNormal(d, e), scale), 0.0, 1.0);\n}\n\n// Coverage of the pixel at `p` by rectangle `r` with corners `radii`, where a pixel of `r` spans\n// `scale` device pixels: `coverage(roundedRectSdf(p, r, radii))` at scale 1.\nfn roundedCoverage(p: vec2f, r: vec4f, radii: Radii, scale: vec2f) -> f32 {\n  let distance = roundedRectSdf(p, r, radii);\n  if scale.x == 1.0 && scale.y == 1.0 { return coverage(distance); }\n  let half = (r.zw - r.xy) * 0.5;\n  let q = p - (r.xy + half);\n  let e = max(pickRadii(q, radii), vec2f(0.0));\n  let d = abs(q) - half + e;\n  var n = vec2f(0.0, 1.0);\n  if d.x > 0.0 && d.y > 0.0 { n = cornerNormal(d, e); } else if d.x > d.y { n = vec2f(1.0, 0.0); }\n  return coverage(distance * along(n, scale));\n}\n\n// Signed distance from `p` to rectangle `r` whose corner in `p`'s quadrant is the quarter\n// ellipse with radii `e`.\nfn ellipticRectSdf(p: vec2f, r: vec4f, e: vec2f) -> f32 {\n  let half = (r.zw - r.xy) * 0.5;\n  return foldedRectSdf(abs(p - (r.xy + half)), half, e);\n}\n\n// Coverage of the pixel at `p` from a signed distance: exact for a straight edge.\nfn coverage(distance: f32) -> f32 {\n  return clamp(0.5 - distance, 0.0, 1.0);\n}\n\n// A background: a solid color or a CSS gradient. `kind.x` is 0 for solid, 1 for a two-stop linear\n// gradient mixed here in sRGB, 2 for one read from ramp `kind.y` of `ramps` (any other\n// interpolation, sampled on the CPU with silk.color), 3 for a gradient with any number of stops\n// mixed here in sRGB: `first.x` of them at word `kind.y` of `ramps`, five words each (the offset,\n// then the straight color), repeating when `first.y` is 1. With any other interpolation `first.z`\n// is one more than the first of their ramps, one per pair of neighbours. `kind.w` is the shape: 0 linear,\n// 1 radial, 2 conic. For two stops `first` and `last` hold them, straight sRGB (`first` is the\n// solid color). `line` is the center and then the direction (linear), the reciprocal radii\n// (radial) or the start angle in turns (conic); `stops` holds the linear half length and the two\n// stop offsets.\nstruct Paint {\n  kind: vec4u,\n  first: vec4f,\n  last: vec4f,\n  line: vec4f,\n  stops: vec4f,\n}\n\nfn premultiply(c: vec4f) -> vec4f {\n  let s = clamp(c, vec4f(0.0), vec4f(1.0));\n  return vec4f(s.rgb * s.a, s.a);\n}\n\n// The premultiplied color of `paint` at pixel center `p`. Gradients take their parameter in\n// 1/255 steps and mix premultiplied, as the CPU reference's 256-entry ramp does.\nfn shade(paint: Paint, p: vec2f) -> vec4f {\n  if paint.kind.x == 0u { return premultiply(paint.first); }\n  let d = p - paint.line.xy;\n  var along = dot(d, paint.line.zw) / paint.stops.x * 0.5 + 0.5;\n  if paint.kind.w == 1u {\n    along = length(d * paint.line.zw);\n  } else if paint.kind.w == 2u {\n    let a = atan2(d.x, -d.y) / 6.2831855 - paint.line.z;\n    along = a - floor(a);\n  }\n  if paint.kind.x == 3u { return shadeStops(paint, along); }\n  let span = paint.stops.z - paint.stops.y;\n  var t = select(0.0, 1.0, along >= paint.stops.y);\n  if span > 0.0 { t = (along - paint.stops.y) / span; }\n  let step = floor(clamp(t, 0.0, 1.0) * 255.0 + 0.5);\n  if paint.kind.x == 2u { return unpack4x8unorm(ramps[paint.kind.y * 256u + u32(step)]); }\n  return mixPremultiplied(paint.first, paint.last, step / 255.0);\n}\n\n// Straight colors `a` and `b` mixed premultiplied at `t`.\nfn mixPremultiplied(a: vec4f, b: vec4f, t: f32) -> vec4f {\n  let aa = clamp(a.a, 0.0, 1.0);\n  let ba = clamp(b.a, 0.0, 1.0);\n  let alpha = aa + (ba - aa) * t;\n  if !(alpha > 0.0) { return vec4f(0.0); }\n  let c = (a.rgb * aa + (b.rgb * ba - a.rgb * aa) * t) / alpha;\n  return premultiply(vec4f(c, alpha));\n}\n\nfn stopOffset(base: u32, i: u32) -> f32 {\n  return bitcast<f32>(ramps[base + i * 5u]);\n}\n\nfn stopColor(base: u32, i: u32) -> vec4f {\n  let w = base + i * 5u;\n  return vec4f(bitcast<f32>(ramps[w + 1u]), bitcast<f32>(ramps[w + 2u]), bitcast<f32>(ramps[w + 3u]), bitcast<f32>(ramps[w + 4u]));\n}\n\n// The stops of `paint` at offset `along`, mixed in 1/255 steps between neighbours.\nfn shadeStops(paint: Paint, along: f32) -> vec4f {\n  let base = paint.kind.y;\n  let n = u32(paint.first.x);\n  if n == 0u { return vec4f(0.0); }\n  let first = stopOffset(base, 0u);\n  let period = stopOffset(base, n - 1u) - first;\n  var a = along;\n  if paint.first.y > 0.5 && period > 0.000001 {\n    let k = (a - first) / period;\n    a = first + (k - floor(k)) * period;\n  }\n  var i = 0u;\n  loop {\n    if i + 1u >= n || stopOffset(base, i + 1u) > a { break; }\n    i = i + 1u;\n  }\n  if i + 1u >= n || a < first { return mixPremultiplied(stopColor(base, i), stopColor(base, i), 0.0); }\n  let lo = stopOffset(base, i);\n  let t = (a - lo) / (stopOffset(base, i + 1u) - lo);\n  let step = floor(clamp(t, 0.0, 1.0) * 255.0 + 0.5);\n  if paint.first.z > 0.5 {\n    return unpack4x8unorm(ramps[(u32(paint.first.z) - 1u + i) * 256u + u32(step)]);\n  }\n  return mixPremultiplied(stopColor(base, i), stopColor(base, i + 1u), step / 255.0);\n}\n// Underlines: the top `thickness` rows of the bounds, or a sine wave of that stroke width with\n// wavelength 8 * thickness, centered in the bounds.\nstruct Underline {\n  bounds: vec4f,\n  mask: vec4f,\n  // straight alpha\n  color: vec4f,\n  // thickness, wavy (1 or 0), the transform\n  params: vec4f,\n  maskRadii: Radii,\n}\n@group(0) @binding(1) var<storage, read> underlines: array<Underline>;\n\nstruct Varying { @builtin(position) position: vec4f, @location(0) @interpolate(flat) index: u32, @location(1) local: vec2f }\n\n@vertex fn vs(@builtin(vertex_index) v: u32, @builtin(instance_index) index: u32) -> Varying {\n  let u = underlines[index];\n  let placed = place(u.bounds, u.mask, u32(u.params.z), v);\n  return Varying(placed.position, index, placed.local);\n}\n\nconst TAU: f32 = 6.283185307179586;\n\n@fragment fn fs(v: Varying) -> @location(0) vec4f {\n  let u = underlines[v.index];\n  let at = spot(v.position, v.local, u32(u.params.z));\n  let p = at.p;\n  let b = u.bounds;\n  let thickness = u.params.x;\n  var alpha = 0.0;\n  if u.params.y == 0.0 {\n    alpha = areaInAt(vec4f(b.x, b.y, b.z, min(b.y + thickness, b.w)), p, at.scale) * areaInAt(u.mask, p, at.scale) * cornerCoverageAt(u.mask, u.maskRadii, p, at.scale);\n  } else {\n    // Distance to the wave, to first order: the vertical gap over the slope's length.\n    let amplitude = max((b.w - b.y - thickness) * 0.5, 0.0);\n    let k = TAU / (8.0 * thickness);\n    let x = p.x - b.x;\n    let gap = p.y - (b.y + b.w) * 0.5 - amplitude * sin(k * x);\n    let slope = amplitude * k * cos(k * x);\n    let distance = abs(gap) / sqrt(1.0 + slope * slope);\n    let clipped = vec4f(max(u.mask.xy, b.xy), min(u.mask.zw, b.zw));\n    alpha = clamp((thickness * 0.5 - distance) * at.scale.y + 0.5, 0.0, 1.0) * areaInAt(clipped, p, at.scale) * cornerCoverageAt(u.mask, u.maskRadii, p, at.scale);\n  }\n  alpha = alpha * at.keep;\n  if alpha <= 0.0 { discard; }\n  return premultiply(u.color) * alpha;\n}\n" }
pub fn mono() -> &'static [u8] { return b"// Shared by every UI pipeline (silk task embed-shaders prepends it). Coordinates are device pixels,\n// y down. Colors leave the fragment shaders premultiplied; the pipelines blend source-over.\nstruct Globals {\n  // Target width and height in pixels.\n  size: vec2f,\n  // Text: enhanced contrast for grayscale glyphs (0 turns it off).\n  contrast: f32,\n  unused: f32,\n  // Text: DirectWrite gamma correction ratios (all 0 turns it off).\n  gamma: vec4f,\n  // Image-only retained scenes: uniform scale, reserved, translation x/y.\n  imageCamera: vec4f,\n  // Where the target's pixel (0, 0) lies in scene pixels: an offscreen page holds only the part\n  // of the scene its layers cover. `size` is the target's own size. zw unused.\n  origin: vec4f,\n}\n@group(0) @binding(0) var<uniform> globals: Globals;\n\n// Corner radii, fitted on the CPU (Radii.fitted): horizontal `x` and vertical `y` of the\n// top-left, top-right, bottom-right and bottom-left corners. A corner with a zero radius is square.\nstruct Radii { x: vec4f, y: vec4f }\n\n// Gradient ramps, 256 premultiplied RGBA8 words each. Only quads and paths read it.\n@group(0) @binding(7) var<storage, read> ramps: array<u32>;\n\n// A layer drawn straight onto its parent's surface instead of through a texture: its primitives\n// keep the layer's own pixels and take this to where they land, faded by the layer's opacity.\n// Entry 0 is unused: a primitive whose transform is 0 is drawn where it lies. Paths do not read\n// it.\nstruct Transform {\n  // Rows of the map from a layer pixel to a scene pixel, `x' = dot(to0.xyz, (x, y, 1))`, and of\n  // its inverse.\n  to0: vec4f,\n  to1: vec4f,\n  from0: vec4f,\n  from1: vec4f,\n  // The scene pixels the layer may touch and their corner radii: the content mask it lands in.\n  // A texture would also cut the layer to the pixels it holds; drawn here, its primitives end\n  // where they end.\n  clip: vec4f,\n  clipRadii: Radii,\n  // x is the layer's opacity; the rest is unused.\n  more: vec4f,\n}\n@group(0) @binding(8) var<storage, read> transforms: array<Transform>;\n\nconst CORNERS = array<vec2f, 6>(vec2f(0.0, 0.0), vec2f(1.0, 0.0), vec2f(0.0, 1.0), vec2f(0.0, 1.0), vec2f(1.0, 0.0), vec2f(1.0, 1.0));\n\n// Clip space for corner `index` of the pixel rectangle `r` (xMin, yMin, xMax, yMax).\nfn corner(r: vec4f, index: u32) -> vec4f {\n  let c = CORNERS[index];\n  let p = mix(r.xy, r.zw, c) - globals.origin.xy;\n  return vec4f(p.x / globals.size.x * 2.0 - 1.0, 1.0 - p.y / globals.size.y * 2.0, 0.0, 1.0);\n}\n\n// The pixels a primitive drawing `bounds` under `mask` touches: their intersection rounded out to\n// whole pixels and clamped to the target, in scene pixels. Empty rectangles collapse to a point.\nfn cover(bounds: vec4f, mask: vec4f) -> vec4f {\n  let low = globals.origin.xy;\n  let high = low + globals.size;\n  let lo = clamp(floor(max(bounds.xy, mask.xy)), low, high);\n  let hi = clamp(ceil(min(bounds.zw, mask.zw)), low, high);\n  return vec4f(lo, max(hi, lo));\n}\n\n// A corner of a primitive: its clip space position and, for a transformed one, its layer pixel.\nstruct Placed { position: vec4f, local: vec2f }\n\n// Corner `index` of a primitive that draws `bounds` under `mask` through transform `transform`.\nfn place(bounds: vec4f, mask: vec4f, transform: u32, index: u32) -> Placed {\n  if transform == 0u { return Placed(corner(cover(bounds, mask), index), vec2f(0.0)); }\n  let t = transforms[transform];\n  // The layer pixels it touches, wider by what one device pixel spans for the edges' ramps.\n  let lo = max(bounds.xy, mask.xy);\n  let hi = max(min(bounds.zw, mask.zw), lo);\n  let margin = vec2f(abs(t.from0.x) + abs(t.from0.y), abs(t.from1.x) + abs(t.from1.y));\n  let local = mix(lo - margin, hi + margin, CORNERS[index]);\n  let p = vec2f(dot(t.to0.xyz, vec3f(local, 1.0)), dot(t.to1.xyz, vec3f(local, 1.0))) - globals.origin.xy;\n  return Placed(vec4f(p.x / globals.size.x * 2.0 - 1.0, 1.0 - p.y / globals.size.y * 2.0, 0.0, 1.0), local);\n}\n\n// A fragment of a primitive: `p` is its center in the primitive's own pixels (scene pixels, or\n// the layer's for a transformed one), `scale` the device pixels one of those spans along x and\n// along y, and `keep` how much of the pixel the transform's clip keeps.\nstruct Spot { p: vec2f, scale: vec2f, keep: f32 }\n\nfn spot(position: vec4f, local: vec2f, transform: u32) -> Spot {\n  let device = position.xy + globals.origin.xy;\n  if transform == 0u { return Spot(device, vec2f(1.0), 1.0); }\n  let t = transforms[transform];\n  let scale = vec2f(length(vec2f(t.to0.x, t.to1.x)), length(vec2f(t.to0.y, t.to1.y)));\n  let keep = areaIn(t.clip, device) * cornerCoverage(t.clip, t.clipRadii, device) * t.more.x;\n  return Spot(local, scale, keep);\n}\n\n// How much of the pixel square around `p` (a pixel center) lies in `r`, as the CPU reference clips.\nfn areaIn(r: vec4f, p: vec2f) -> f32 {\n  let lo = max(p - 0.5, r.xy);\n  let hi = min(p + 0.5, r.zw);\n  let d = clamp(hi - lo, vec2f(0.0), vec2f(1.0));\n  return d.x * d.y;\n}\n\n// `areaIn` where a pixel of `r` spans `scale` device pixels: the device pixel around `p` is\n// `1 / scale` of them wide.\nfn areaInAt(r: vec4f, p: vec2f, scale: vec2f) -> f32 {\n  let half = 0.5 / scale;\n  let lo = max(p - half, r.xy);\n  let hi = min(p + half, r.zw);\n  let d = clamp((hi - lo) * scale, vec2f(0.0), vec2f(1.0));\n  return d.x * d.y;\n}\n\n// The device pixels in one pixel of a shape along its outward normal `n`, where the shape's\n// pixels span `scale` device pixels.\nfn along(n: vec2f, scale: vec2f) -> f32 {\n  return 1.0 / max(length(n / scale), 0.000001);\n}\n\n// The radii (horizontal, vertical) of the corner of quadrant `q` (from the center).\nfn pickRadii(q: vec2f, r: Radii) -> vec2f {\n  if q.x < 0.0 {\n    return select(vec2f(r.x.w, r.y.w), vec2f(r.x.x, r.y.x), q.y < 0.0);\n  }\n  return select(vec2f(r.x.z, r.y.z), vec2f(r.x.y, r.y.y), q.y < 0.0);\n}\n\n// Signed distance to the ellipse with radii `e` from `d`, a point measured from its center: the\n// implicit function over its gradient, exact for a circle. Matches radii.ellipseDistance.\nfn ellipseDistance(d: vec2f, e: vec2f) -> f32 {\n  let k1 = length(d / (e * e));\n  if k1 <= 0.0 { return -min(e.x, e.y); }\n  let k0 = length(d / e);\n  return k0 * (k0 - 1.0) / k1;\n}\n\n// Signed distance from `a`, a point folded into the positive quadrant of a rectangle of half size\n// `half`, to that rectangle with the corner there the quarter ellipse with radii `e`.\nfn foldedRectSdf(a: vec2f, half: vec2f, e: vec2f) -> f32 {\n  let d = a - (half - e);\n  // Circular and square corners, the common case, take the branch-free circle distance.\n  if e.x == e.y { return min(max(d.x, d.y), 0.0) + length(max(d, vec2f(0.0))) - e.x; }\n  if d.x > 0.0 && d.y > 0.0 && e.x > 0.0 && e.y > 0.0 {\n    return ellipseDistance(d, e);\n  }\n  let b = a - half;\n  return min(max(b.x, b.y), 0.0) + length(max(b, vec2f(0.0)));\n}\n\n// Signed distance from `p` to rectangle `r` with corners `radii`; negative inside.\nfn roundedRectSdf(p: vec2f, r: vec4f, radii: Radii) -> f32 {\n  let half = (r.zw - r.xy) * 0.5;\n  let q = p - (r.xy + half);\n  return foldedRectSdf(abs(q), half, max(pickRadii(q, radii), vec2f(0.0)));\n}\n\n// Whether any corner of `radii` is rounded.\nfn isRounded(radii: Radii) -> bool {\n  return max(max(radii.x.x, radii.x.y), max(radii.x.z, radii.x.w)) > 0.0;\n}\n\n// The outward normal at `d` (from the corner's center) of the corner with radii `e`.\nfn cornerNormal(d: vec2f, e: vec2f) -> vec2f {\n  if e.x > 0.0 && e.y > 0.0 { return normalize(d / (e * e)); }\n  return normalize(d);\n}\n\n// How much of the pixel centered at `p` the rounded corners `radii` of content mask `r` keep: 1\n// away from the corners, so the rectangle stays `areaIn`'s. Matches ContentMask.cornerCoverage.\nfn cornerCoverage(r: vec4f, radii: Radii, p: vec2f) -> f32 {\n  return cornerCoverageAt(r, radii, p, vec2f(1.0));\n}\n\n// `cornerCoverage` where a pixel of `r` spans `scale` device pixels.\nfn cornerCoverageAt(r: vec4f, radii: Radii, p: vec2f, scale: vec2f) -> f32 {\n  if !isRounded(radii) { return 1.0; }\n  let half = (r.zw - r.xy) * 0.5;\n  let q = p - (r.xy + half);\n  let e = pickRadii(q, radii);\n  if e.x <= 0.0 || e.y <= 0.0 { return 1.0; }\n  let d = abs(q) - half + e;\n  if d.x <= 0.0 || d.y <= 0.0 { return 1.0; }\n  var distance = length(d) - e.x;\n  if e.x != e.y { distance = ellipseDistance(d, e); }\n  if scale.x == 1.0 && scale.y == 1.0 { return clamp(0.5 - distance, 0.0, 1.0); }\n  return clamp(0.5 - distance * along(cornerNormal(d, e), scale), 0.0, 1.0);\n}\n\n// Coverage of the pixel at `p` by rectangle `r` with corners `radii`, where a pixel of `r` spans\n// `scale` device pixels: `coverage(roundedRectSdf(p, r, radii))` at scale 1.\nfn roundedCoverage(p: vec2f, r: vec4f, radii: Radii, scale: vec2f) -> f32 {\n  let distance = roundedRectSdf(p, r, radii);\n  if scale.x == 1.0 && scale.y == 1.0 { return coverage(distance); }\n  let half = (r.zw - r.xy) * 0.5;\n  let q = p - (r.xy + half);\n  let e = max(pickRadii(q, radii), vec2f(0.0));\n  let d = abs(q) - half + e;\n  var n = vec2f(0.0, 1.0);\n  if d.x > 0.0 && d.y > 0.0 { n = cornerNormal(d, e); } else if d.x > d.y { n = vec2f(1.0, 0.0); }\n  return coverage(distance * along(n, scale));\n}\n\n// Signed distance from `p` to rectangle `r` whose corner in `p`'s quadrant is the quarter\n// ellipse with radii `e`.\nfn ellipticRectSdf(p: vec2f, r: vec4f, e: vec2f) -> f32 {\n  let half = (r.zw - r.xy) * 0.5;\n  return foldedRectSdf(abs(p - (r.xy + half)), half, e);\n}\n\n// Coverage of the pixel at `p` from a signed distance: exact for a straight edge.\nfn coverage(distance: f32) -> f32 {\n  return clamp(0.5 - distance, 0.0, 1.0);\n}\n\n// A background: a solid color or a CSS gradient. `kind.x` is 0 for solid, 1 for a two-stop linear\n// gradient mixed here in sRGB, 2 for one read from ramp `kind.y` of `ramps` (any other\n// interpolation, sampled on the CPU with silk.color), 3 for a gradient with any number of stops\n// mixed here in sRGB: `first.x` of them at word `kind.y` of `ramps`, five words each (the offset,\n// then the straight color), repeating when `first.y` is 1. With any other interpolation `first.z`\n// is one more than the first of their ramps, one per pair of neighbours. `kind.w` is the shape: 0 linear,\n// 1 radial, 2 conic. For two stops `first` and `last` hold them, straight sRGB (`first` is the\n// solid color). `line` is the center and then the direction (linear), the reciprocal radii\n// (radial) or the start angle in turns (conic); `stops` holds the linear half length and the two\n// stop offsets.\nstruct Paint {\n  kind: vec4u,\n  first: vec4f,\n  last: vec4f,\n  line: vec4f,\n  stops: vec4f,\n}\n\nfn premultiply(c: vec4f) -> vec4f {\n  let s = clamp(c, vec4f(0.0), vec4f(1.0));\n  return vec4f(s.rgb * s.a, s.a);\n}\n\n// The premultiplied color of `paint` at pixel center `p`. Gradients take their parameter in\n// 1/255 steps and mix premultiplied, as the CPU reference's 256-entry ramp does.\nfn shade(paint: Paint, p: vec2f) -> vec4f {\n  if paint.kind.x == 0u { return premultiply(paint.first); }\n  let d = p - paint.line.xy;\n  var along = dot(d, paint.line.zw) / paint.stops.x * 0.5 + 0.5;\n  if paint.kind.w == 1u {\n    along = length(d * paint.line.zw);\n  } else if paint.kind.w == 2u {\n    let a = atan2(d.x, -d.y) / 6.2831855 - paint.line.z;\n    along = a - floor(a);\n  }\n  if paint.kind.x == 3u { return shadeStops(paint, along); }\n  let span = paint.stops.z - paint.stops.y;\n  var t = select(0.0, 1.0, along >= paint.stops.y);\n  if span > 0.0 { t = (along - paint.stops.y) / span; }\n  let step = floor(clamp(t, 0.0, 1.0) * 255.0 + 0.5);\n  if paint.kind.x == 2u { return unpack4x8unorm(ramps[paint.kind.y * 256u + u32(step)]); }\n  return mixPremultiplied(paint.first, paint.last, step / 255.0);\n}\n\n// Straight colors `a` and `b` mixed premultiplied at `t`.\nfn mixPremultiplied(a: vec4f, b: vec4f, t: f32) -> vec4f {\n  let aa = clamp(a.a, 0.0, 1.0);\n  let ba = clamp(b.a, 0.0, 1.0);\n  let alpha = aa + (ba - aa) * t;\n  if !(alpha > 0.0) { return vec4f(0.0); }\n  let c = (a.rgb * aa + (b.rgb * ba - a.rgb * aa) * t) / alpha;\n  return premultiply(vec4f(c, alpha));\n}\n\nfn stopOffset(base: u32, i: u32) -> f32 {\n  return bitcast<f32>(ramps[base + i * 5u]);\n}\n\nfn stopColor(base: u32, i: u32) -> vec4f {\n  let w = base + i * 5u;\n  return vec4f(bitcast<f32>(ramps[w + 1u]), bitcast<f32>(ramps[w + 2u]), bitcast<f32>(ramps[w + 3u]), bitcast<f32>(ramps[w + 4u]));\n}\n\n// The stops of `paint` at offset `along`, mixed in 1/255 steps between neighbours.\nfn shadeStops(paint: Paint, along: f32) -> vec4f {\n  let base = paint.kind.y;\n  let n = u32(paint.first.x);\n  if n == 0u { return vec4f(0.0); }\n  let first = stopOffset(base, 0u);\n  let period = stopOffset(base, n - 1u) - first;\n  var a = along;\n  if paint.first.y > 0.5 && period > 0.000001 {\n    let k = (a - first) / period;\n    a = first + (k - floor(k)) * period;\n  }\n  var i = 0u;\n  loop {\n    if i + 1u >= n || stopOffset(base, i + 1u) > a { break; }\n    i = i + 1u;\n  }\n  if i + 1u >= n || a < first { return mixPremultiplied(stopColor(base, i), stopColor(base, i), 0.0); }\n  let lo = stopOffset(base, i);\n  let t = (a - lo) / (stopOffset(base, i + 1u) - lo);\n  let step = floor(clamp(t, 0.0, 1.0) * 255.0 + 0.5);\n  if paint.first.z > 0.5 {\n    return unpack4x8unorm(ramps[(u32(paint.first.z) - 1u + i) * 256u + u32(step)]);\n  }\n  return mixPremultiplied(stopColor(base, i), stopColor(base, i + 1u), step / 255.0);\n}\n// Sprite sampling shared by mono.wgsl and poly.wgsl: bilinear (or nearest) at pixel centers, clamped to the\n// tile, read with textureLoad so no texel outside the tile is touched.\n@group(0) @binding(2) var atlas: texture_2d<f32>;\n\n// `tile` clipped to the texture: a surface sprite may name more than the texture holds.\nfn clipTile(tile: vec4f) -> vec4f {\n  let dims = vec2f(textureDimensions(atlas));\n  return vec4f(min(tile.xy, dims), min(tile.zw, dims));\n}\n\n// Tile `tile` (texel rectangle xMin, yMin, xMax, yMax) stretched over `bounds`, at pixel center `p`.\nfn sampleTile(whole: vec4f, bounds: vec4f, p: vec2f) -> vec4f {\n  let tile = clipTile(whole);\n  let size = tile.zw - tile.xy;\n  let uv = (p - bounds.xy) * size / (bounds.zw - bounds.xy);\n  let f = clamp(uv - 0.5, vec2f(0.0), size - 1.0);\n  let i0 = floor(f);\n  let w = f - i0;\n  let i1 = min(i0 + 1.0, size - 1.0);\n  let a = textureLoad(atlas, vec2u(tile.xy + i0), 0);\n  let b = textureLoad(atlas, vec2u(tile.xy + vec2f(i1.x, i0.y)), 0);\n  let c = textureLoad(atlas, vec2u(tile.xy + vec2f(i0.x, i1.y)), 0);\n  let d = textureLoad(atlas, vec2u(tile.xy + i1), 0);\n  return mix(mix(a, b, w.x), mix(c, d, w.x), w.y);\n}\n\n// The texel of `tile` under pixel center `p`, clamped to the tile: `image-rendering: pixelated`.\nfn nearestTile(whole: vec4f, bounds: vec4f, p: vec2f) -> vec4f {\n  let tile = clipTile(whole);\n  let size = tile.zw - tile.xy;\n  let uv = (p - bounds.xy) * size / (bounds.zw - bounds.xy);\n  let i = clamp(floor(uv), vec2f(0.0), size - 1.0);\n  return textureLoad(atlas, vec2u(tile.xy + i), 0);\n}\n\nstruct Varying { @builtin(position) position: vec4f, @location(0) @interpolate(flat) index: u32, @location(1) local: vec2f }\n// Monochrome sprites: glyphs and icons, a coverage tile tinted with one color, with the\n// DirectWrite contrast and gamma correction for text (from Windows Terminal's dwrite.hlsl, MIT,\n// as GPUI uses it).\nstruct MonoSprite {\n  bounds: vec4f,\n  mask: vec4f,\n  // straight alpha\n  color: vec4f,\n  tile: vec4f,\n  maskRadii: Radii,\n  // x is the transform, y the scroll group (a `Placement`).\n  extra: vec4f,\n}\n@group(0) @binding(1) var<storage, read> sprites: array<MonoSprite>;\n\n// Where a scroll group draws: what it holds is moved by `offset.xy` and cut to `clip` with\n// corners `clipRadii`. Sprites keep the bounds and mask they were painted with and name their\n// group, so a scroll writes these and no sprite. Entry 0, outside every group, moves nothing.\nstruct Placement {\n  offset: vec4f,\n  clip: vec4f,\n  clipRadii: Radii,\n}\n@group(0) @binding(9) var<storage, read> placements: array<Placement>;\n\n@vertex fn vs(@builtin(vertex_index) v: u32, @builtin(instance_index) index: u32) -> Varying {\n  let s = sprites[index];\n  let g = placements[u32(s.extra.y)];\n  let own = s.mask + g.offset.xyxy;\n  let mask = vec4f(max(own.xy, g.clip.xy), min(own.zw, g.clip.zw));\n  let placed = place(s.bounds + g.offset.xyxy, mask, u32(s.extra.x), v);\n  return Varying(placed.position, index, placed.local);\n}\n\nfn brightness(color: vec3f) -> f32 {\n  return dot(color, vec3f(0.30, 0.59, 0.11));\n}\n\n// The correction of glyph coverage `alpha` for text of `color`.\nfn correctText(alpha: f32, color: vec3f) -> f32 {\n  let b = brightness(color);\n  let k = globals.contrast * clamp(4.0 * (0.75 - b), 0.0, 1.0);\n  let a = alpha * (k + 1.0) / (alpha * k + 1.0);\n  let g = globals.gamma;\n  let correction = (g.x * b + g.y) * a + (g.z * b + g.w);\n  return a + a * (1.0 - a) * correction;\n}\n\n@fragment fn fs(v: Varying) -> @location(0) vec4f {\n  let s = sprites[v.index];\n  let at = spot(v.position, v.local, u32(s.extra.x));\n  let p = at.p;\n  let g = placements[u32(s.extra.y)];\n  let bounds = s.bounds + g.offset.xyxy;\n  let own = s.mask + g.offset.xyxy;\n  let clipped = vec4f(max(max(own.xy, g.clip.xy), bounds.xy), min(min(own.zw, g.clip.zw), bounds.zw));\n  let clip = areaInAt(clipped, p, at.scale) * cornerCoverageAt(own, s.maskRadii, p, at.scale)\n    * cornerCoverageAt(g.clip, g.clipRadii, p, at.scale) * at.keep;\n  if clip <= 0.0 { discard; }\n  let sample = sampleTile(s.tile, bounds, p).r;\n  let alpha = clamp(correctText(sample, clamp(s.color.rgb, vec3f(0.0), vec3f(1.0))), 0.0, 1.0);\n  return premultiply(s.color) * (alpha * clip);\n}\n" }
pub fn poly() -> &'static [u8] { return b"// Shared by every UI pipeline (silk task embed-shaders prepends it). Coordinates are device pixels,\n// y down. Colors leave the fragment shaders premultiplied; the pipelines blend source-over.\nstruct Globals {\n  // Target width and height in pixels.\n  size: vec2f,\n  // Text: enhanced contrast for grayscale glyphs (0 turns it off).\n  contrast: f32,\n  unused: f32,\n  // Text: DirectWrite gamma correction ratios (all 0 turns it off).\n  gamma: vec4f,\n  // Image-only retained scenes: uniform scale, reserved, translation x/y.\n  imageCamera: vec4f,\n  // Where the target's pixel (0, 0) lies in scene pixels: an offscreen page holds only the part\n  // of the scene its layers cover. `size` is the target's own size. zw unused.\n  origin: vec4f,\n}\n@group(0) @binding(0) var<uniform> globals: Globals;\n\n// Corner radii, fitted on the CPU (Radii.fitted): horizontal `x` and vertical `y` of the\n// top-left, top-right, bottom-right and bottom-left corners. A corner with a zero radius is square.\nstruct Radii { x: vec4f, y: vec4f }\n\n// Gradient ramps, 256 premultiplied RGBA8 words each. Only quads and paths read it.\n@group(0) @binding(7) var<storage, read> ramps: array<u32>;\n\n// A layer drawn straight onto its parent's surface instead of through a texture: its primitives\n// keep the layer's own pixels and take this to where they land, faded by the layer's opacity.\n// Entry 0 is unused: a primitive whose transform is 0 is drawn where it lies. Paths do not read\n// it.\nstruct Transform {\n  // Rows of the map from a layer pixel to a scene pixel, `x' = dot(to0.xyz, (x, y, 1))`, and of\n  // its inverse.\n  to0: vec4f,\n  to1: vec4f,\n  from0: vec4f,\n  from1: vec4f,\n  // The scene pixels the layer may touch and their corner radii: the content mask it lands in.\n  // A texture would also cut the layer to the pixels it holds; drawn here, its primitives end\n  // where they end.\n  clip: vec4f,\n  clipRadii: Radii,\n  // x is the layer's opacity; the rest is unused.\n  more: vec4f,\n}\n@group(0) @binding(8) var<storage, read> transforms: array<Transform>;\n\nconst CORNERS = array<vec2f, 6>(vec2f(0.0, 0.0), vec2f(1.0, 0.0), vec2f(0.0, 1.0), vec2f(0.0, 1.0), vec2f(1.0, 0.0), vec2f(1.0, 1.0));\n\n// Clip space for corner `index` of the pixel rectangle `r` (xMin, yMin, xMax, yMax).\nfn corner(r: vec4f, index: u32) -> vec4f {\n  let c = CORNERS[index];\n  let p = mix(r.xy, r.zw, c) - globals.origin.xy;\n  return vec4f(p.x / globals.size.x * 2.0 - 1.0, 1.0 - p.y / globals.size.y * 2.0, 0.0, 1.0);\n}\n\n// The pixels a primitive drawing `bounds` under `mask` touches: their intersection rounded out to\n// whole pixels and clamped to the target, in scene pixels. Empty rectangles collapse to a point.\nfn cover(bounds: vec4f, mask: vec4f) -> vec4f {\n  let low = globals.origin.xy;\n  let high = low + globals.size;\n  let lo = clamp(floor(max(bounds.xy, mask.xy)), low, high);\n  let hi = clamp(ceil(min(bounds.zw, mask.zw)), low, high);\n  return vec4f(lo, max(hi, lo));\n}\n\n// A corner of a primitive: its clip space position and, for a transformed one, its layer pixel.\nstruct Placed { position: vec4f, local: vec2f }\n\n// Corner `index` of a primitive that draws `bounds` under `mask` through transform `transform`.\nfn place(bounds: vec4f, mask: vec4f, transform: u32, index: u32) -> Placed {\n  if transform == 0u { return Placed(corner(cover(bounds, mask), index), vec2f(0.0)); }\n  let t = transforms[transform];\n  // The layer pixels it touches, wider by what one device pixel spans for the edges' ramps.\n  let lo = max(bounds.xy, mask.xy);\n  let hi = max(min(bounds.zw, mask.zw), lo);\n  let margin = vec2f(abs(t.from0.x) + abs(t.from0.y), abs(t.from1.x) + abs(t.from1.y));\n  let local = mix(lo - margin, hi + margin, CORNERS[index]);\n  let p = vec2f(dot(t.to0.xyz, vec3f(local, 1.0)), dot(t.to1.xyz, vec3f(local, 1.0))) - globals.origin.xy;\n  return Placed(vec4f(p.x / globals.size.x * 2.0 - 1.0, 1.0 - p.y / globals.size.y * 2.0, 0.0, 1.0), local);\n}\n\n// A fragment of a primitive: `p` is its center in the primitive's own pixels (scene pixels, or\n// the layer's for a transformed one), `scale` the device pixels one of those spans along x and\n// along y, and `keep` how much of the pixel the transform's clip keeps.\nstruct Spot { p: vec2f, scale: vec2f, keep: f32 }\n\nfn spot(position: vec4f, local: vec2f, transform: u32) -> Spot {\n  let device = position.xy + globals.origin.xy;\n  if transform == 0u { return Spot(device, vec2f(1.0), 1.0); }\n  let t = transforms[transform];\n  let scale = vec2f(length(vec2f(t.to0.x, t.to1.x)), length(vec2f(t.to0.y, t.to1.y)));\n  let keep = areaIn(t.clip, device) * cornerCoverage(t.clip, t.clipRadii, device) * t.more.x;\n  return Spot(local, scale, keep);\n}\n\n// How much of the pixel square around `p` (a pixel center) lies in `r`, as the CPU reference clips.\nfn areaIn(r: vec4f, p: vec2f) -> f32 {\n  let lo = max(p - 0.5, r.xy);\n  let hi = min(p + 0.5, r.zw);\n  let d = clamp(hi - lo, vec2f(0.0), vec2f(1.0));\n  return d.x * d.y;\n}\n\n// `areaIn` where a pixel of `r` spans `scale` device pixels: the device pixel around `p` is\n// `1 / scale` of them wide.\nfn areaInAt(r: vec4f, p: vec2f, scale: vec2f) -> f32 {\n  let half = 0.5 / scale;\n  let lo = max(p - half, r.xy);\n  let hi = min(p + half, r.zw);\n  let d = clamp((hi - lo) * scale, vec2f(0.0), vec2f(1.0));\n  return d.x * d.y;\n}\n\n// The device pixels in one pixel of a shape along its outward normal `n`, where the shape's\n// pixels span `scale` device pixels.\nfn along(n: vec2f, scale: vec2f) -> f32 {\n  return 1.0 / max(length(n / scale), 0.000001);\n}\n\n// The radii (horizontal, vertical) of the corner of quadrant `q` (from the center).\nfn pickRadii(q: vec2f, r: Radii) -> vec2f {\n  if q.x < 0.0 {\n    return select(vec2f(r.x.w, r.y.w), vec2f(r.x.x, r.y.x), q.y < 0.0);\n  }\n  return select(vec2f(r.x.z, r.y.z), vec2f(r.x.y, r.y.y), q.y < 0.0);\n}\n\n// Signed distance to the ellipse with radii `e` from `d`, a point measured from its center: the\n// implicit function over its gradient, exact for a circle. Matches radii.ellipseDistance.\nfn ellipseDistance(d: vec2f, e: vec2f) -> f32 {\n  let k1 = length(d / (e * e));\n  if k1 <= 0.0 { return -min(e.x, e.y); }\n  let k0 = length(d / e);\n  return k0 * (k0 - 1.0) / k1;\n}\n\n// Signed distance from `a`, a point folded into the positive quadrant of a rectangle of half size\n// `half`, to that rectangle with the corner there the quarter ellipse with radii `e`.\nfn foldedRectSdf(a: vec2f, half: vec2f, e: vec2f) -> f32 {\n  let d = a - (half - e);\n  // Circular and square corners, the common case, take the branch-free circle distance.\n  if e.x == e.y { return min(max(d.x, d.y), 0.0) + length(max(d, vec2f(0.0))) - e.x; }\n  if d.x > 0.0 && d.y > 0.0 && e.x > 0.0 && e.y > 0.0 {\n    return ellipseDistance(d, e);\n  }\n  let b = a - half;\n  return min(max(b.x, b.y), 0.0) + length(max(b, vec2f(0.0)));\n}\n\n// Signed distance from `p` to rectangle `r` with corners `radii`; negative inside.\nfn roundedRectSdf(p: vec2f, r: vec4f, radii: Radii) -> f32 {\n  let half = (r.zw - r.xy) * 0.5;\n  let q = p - (r.xy + half);\n  return foldedRectSdf(abs(q), half, max(pickRadii(q, radii), vec2f(0.0)));\n}\n\n// Whether any corner of `radii` is rounded.\nfn isRounded(radii: Radii) -> bool {\n  return max(max(radii.x.x, radii.x.y), max(radii.x.z, radii.x.w)) > 0.0;\n}\n\n// The outward normal at `d` (from the corner's center) of the corner with radii `e`.\nfn cornerNormal(d: vec2f, e: vec2f) -> vec2f {\n  if e.x > 0.0 && e.y > 0.0 { return normalize(d / (e * e)); }\n  return normalize(d);\n}\n\n// How much of the pixel centered at `p` the rounded corners `radii` of content mask `r` keep: 1\n// away from the corners, so the rectangle stays `areaIn`'s. Matches ContentMask.cornerCoverage.\nfn cornerCoverage(r: vec4f, radii: Radii, p: vec2f) -> f32 {\n  return cornerCoverageAt(r, radii, p, vec2f(1.0));\n}\n\n// `cornerCoverage` where a pixel of `r` spans `scale` device pixels.\nfn cornerCoverageAt(r: vec4f, radii: Radii, p: vec2f, scale: vec2f) -> f32 {\n  if !isRounded(radii) { return 1.0; }\n  let half = (r.zw - r.xy) * 0.5;\n  let q = p - (r.xy + half);\n  let e = pickRadii(q, radii);\n  if e.x <= 0.0 || e.y <= 0.0 { return 1.0; }\n  let d = abs(q) - half + e;\n  if d.x <= 0.0 || d.y <= 0.0 { return 1.0; }\n  var distance = length(d) - e.x;\n  if e.x != e.y { distance = ellipseDistance(d, e); }\n  if scale.x == 1.0 && scale.y == 1.0 { return clamp(0.5 - distance, 0.0, 1.0); }\n  return clamp(0.5 - distance * along(cornerNormal(d, e), scale), 0.0, 1.0);\n}\n\n// Coverage of the pixel at `p` by rectangle `r` with corners `radii`, where a pixel of `r` spans\n// `scale` device pixels: `coverage(roundedRectSdf(p, r, radii))` at scale 1.\nfn roundedCoverage(p: vec2f, r: vec4f, radii: Radii, scale: vec2f) -> f32 {\n  let distance = roundedRectSdf(p, r, radii);\n  if scale.x == 1.0 && scale.y == 1.0 { return coverage(distance); }\n  let half = (r.zw - r.xy) * 0.5;\n  let q = p - (r.xy + half);\n  let e = max(pickRadii(q, radii), vec2f(0.0));\n  let d = abs(q) - half + e;\n  var n = vec2f(0.0, 1.0);\n  if d.x > 0.0 && d.y > 0.0 { n = cornerNormal(d, e); } else if d.x > d.y { n = vec2f(1.0, 0.0); }\n  return coverage(distance * along(n, scale));\n}\n\n// Signed distance from `p` to rectangle `r` whose corner in `p`'s quadrant is the quarter\n// ellipse with radii `e`.\nfn ellipticRectSdf(p: vec2f, r: vec4f, e: vec2f) -> f32 {\n  let half = (r.zw - r.xy) * 0.5;\n  return foldedRectSdf(abs(p - (r.xy + half)), half, e);\n}\n\n// Coverage of the pixel at `p` from a signed distance: exact for a straight edge.\nfn coverage(distance: f32) -> f32 {\n  return clamp(0.5 - distance, 0.0, 1.0);\n}\n\n// A background: a solid color or a CSS gradient. `kind.x` is 0 for solid, 1 for a two-stop linear\n// gradient mixed here in sRGB, 2 for one read from ramp `kind.y` of `ramps` (any other\n// interpolation, sampled on the CPU with silk.color), 3 for a gradient with any number of stops\n// mixed here in sRGB: `first.x` of them at word `kind.y` of `ramps`, five words each (the offset,\n// then the straight color), repeating when `first.y` is 1. With any other interpolation `first.z`\n// is one more than the first of their ramps, one per pair of neighbours. `kind.w` is the shape: 0 linear,\n// 1 radial, 2 conic. For two stops `first` and `last` hold them, straight sRGB (`first` is the\n// solid color). `line` is the center and then the direction (linear), the reciprocal radii\n// (radial) or the start angle in turns (conic); `stops` holds the linear half length and the two\n// stop offsets.\nstruct Paint {\n  kind: vec4u,\n  first: vec4f,\n  last: vec4f,\n  line: vec4f,\n  stops: vec4f,\n}\n\nfn premultiply(c: vec4f) -> vec4f {\n  let s = clamp(c, vec4f(0.0), vec4f(1.0));\n  return vec4f(s.rgb * s.a, s.a);\n}\n\n// The premultiplied color of `paint` at pixel center `p`. Gradients take their parameter in\n// 1/255 steps and mix premultiplied, as the CPU reference's 256-entry ramp does.\nfn shade(paint: Paint, p: vec2f) -> vec4f {\n  if paint.kind.x == 0u { return premultiply(paint.first); }\n  let d = p - paint.line.xy;\n  var along = dot(d, paint.line.zw) / paint.stops.x * 0.5 + 0.5;\n  if paint.kind.w == 1u {\n    along = length(d * paint.line.zw);\n  } else if paint.kind.w == 2u {\n    let a = atan2(d.x, -d.y) / 6.2831855 - paint.line.z;\n    along = a - floor(a);\n  }\n  if paint.kind.x == 3u { return shadeStops(paint, along); }\n  let span = paint.stops.z - paint.stops.y;\n  var t = select(0.0, 1.0, along >= paint.stops.y);\n  if span > 0.0 { t = (along - paint.stops.y) / span; }\n  let step = floor(clamp(t, 0.0, 1.0) * 255.0 + 0.5);\n  if paint.kind.x == 2u { return unpack4x8unorm(ramps[paint.kind.y * 256u + u32(step)]); }\n  return mixPremultiplied(paint.first, paint.last, step / 255.0);\n}\n\n// Straight colors `a` and `b` mixed premultiplied at `t`.\nfn mixPremultiplied(a: vec4f, b: vec4f, t: f32) -> vec4f {\n  let aa = clamp(a.a, 0.0, 1.0);\n  let ba = clamp(b.a, 0.0, 1.0);\n  let alpha = aa + (ba - aa) * t;\n  if !(alpha > 0.0) { return vec4f(0.0); }\n  let c = (a.rgb * aa + (b.rgb * ba - a.rgb * aa) * t) / alpha;\n  return premultiply(vec4f(c, alpha));\n}\n\nfn stopOffset(base: u32, i: u32) -> f32 {\n  return bitcast<f32>(ramps[base + i * 5u]);\n}\n\nfn stopColor(base: u32, i: u32) -> vec4f {\n  let w = base + i * 5u;\n  return vec4f(bitcast<f32>(ramps[w + 1u]), bitcast<f32>(ramps[w + 2u]), bitcast<f32>(ramps[w + 3u]), bitcast<f32>(ramps[w + 4u]));\n}\n\n// The stops of `paint` at offset `along`, mixed in 1/255 steps between neighbours.\nfn shadeStops(paint: Paint, along: f32) -> vec4f {\n  let base = paint.kind.y;\n  let n = u32(paint.first.x);\n  if n == 0u { return vec4f(0.0); }\n  let first = stopOffset(base, 0u);\n  let period = stopOffset(base, n - 1u) - first;\n  var a = along;\n  if paint.first.y > 0.5 && period > 0.000001 {\n    let k = (a - first) / period;\n    a = first + (k - floor(k)) * period;\n  }\n  var i = 0u;\n  loop {\n    if i + 1u >= n || stopOffset(base, i + 1u) > a { break; }\n    i = i + 1u;\n  }\n  if i + 1u >= n || a < first { return mixPremultiplied(stopColor(base, i), stopColor(base, i), 0.0); }\n  let lo = stopOffset(base, i);\n  let t = (a - lo) / (stopOffset(base, i + 1u) - lo);\n  let step = floor(clamp(t, 0.0, 1.0) * 255.0 + 0.5);\n  if paint.first.z > 0.5 {\n    return unpack4x8unorm(ramps[(u32(paint.first.z) - 1u + i) * 256u + u32(step)]);\n  }\n  return mixPremultiplied(stopColor(base, i), stopColor(base, i + 1u), step / 255.0);\n}\n// Sprite sampling shared by mono.wgsl and poly.wgsl: bilinear (or nearest) at pixel centers, clamped to the\n// tile, read with textureLoad so no texel outside the tile is touched.\n@group(0) @binding(2) var atlas: texture_2d<f32>;\n\n// `tile` clipped to the texture: a surface sprite may name more than the texture holds.\nfn clipTile(tile: vec4f) -> vec4f {\n  let dims = vec2f(textureDimensions(atlas));\n  return vec4f(min(tile.xy, dims), min(tile.zw, dims));\n}\n\n// Tile `tile` (texel rectangle xMin, yMin, xMax, yMax) stretched over `bounds`, at pixel center `p`.\nfn sampleTile(whole: vec4f, bounds: vec4f, p: vec2f) -> vec4f {\n  let tile = clipTile(whole);\n  let size = tile.zw - tile.xy;\n  let uv = (p - bounds.xy) * size / (bounds.zw - bounds.xy);\n  let f = clamp(uv - 0.5, vec2f(0.0), size - 1.0);\n  let i0 = floor(f);\n  let w = f - i0;\n  let i1 = min(i0 + 1.0, size - 1.0);\n  let a = textureLoad(atlas, vec2u(tile.xy + i0), 0);\n  let b = textureLoad(atlas, vec2u(tile.xy + vec2f(i1.x, i0.y)), 0);\n  let c = textureLoad(atlas, vec2u(tile.xy + vec2f(i0.x, i1.y)), 0);\n  let d = textureLoad(atlas, vec2u(tile.xy + i1), 0);\n  return mix(mix(a, b, w.x), mix(c, d, w.x), w.y);\n}\n\n// The texel of `tile` under pixel center `p`, clamped to the tile: `image-rendering: pixelated`.\nfn nearestTile(whole: vec4f, bounds: vec4f, p: vec2f) -> vec4f {\n  let tile = clipTile(whole);\n  let size = tile.zw - tile.xy;\n  let uv = (p - bounds.xy) * size / (bounds.zw - bounds.xy);\n  let i = clamp(floor(uv), vec2f(0.0), size - 1.0);\n  return textureLoad(atlas, vec2u(tile.xy + i), 0);\n}\n\nstruct Varying { @builtin(position) position: vec4f, @location(0) @interpolate(flat) index: u32, @location(1) local: vec2f }\n// Polychrome sprites: images, color glyphs and color icons from premultiplied RGBA tiles, with\n// opacity, corner radii and grayscale.\nstruct PolySprite {\n  bounds: vec4f,\n  mask: vec4f,\n  tile: vec4f,\n  clipBounds: vec4f,\n  radii: Radii,\n  // opacity, flags (1 grayscale, 2 nearest), quarter turns, the transform\n  params: vec4f,\n  maskRadii: Radii,\n}\n@group(0) @binding(1) var<storage, read> sprites: array<PolySprite>;\n\nfn cameraSprite(source: PolySprite) -> PolySprite {\n  var s = source;\n  let camera = globals.imageCamera;\n  let translation = vec4f(camera.zw, camera.zw);\n  s.bounds = source.bounds * camera.x + translation;\n  s.mask = source.mask * camera.x + translation;\n  s.clipBounds = source.clipBounds * camera.x + translation;\n  s.radii = Radii(source.radii.x * camera.x, source.radii.y * camera.x);\n  s.maskRadii = Radii(source.maskRadii.x * camera.x, source.maskRadii.y * camera.x);\n  return s;\n}\n\n@vertex fn vs(@builtin(vertex_index) v: u32, @builtin(instance_index) index: u32) -> Varying {\n  let s = cameraSprite(sprites[index]);\n  let placed = place(s.bounds, s.mask, u32(s.params.w), v);\n  return Varying(placed.position, index, placed.local);\n}\n\n@fragment fn fs(v: Varying) -> @location(0) vec4f {\n  let s = cameraSprite(sprites[v.index]);\n  let at = spot(v.position, v.local, u32(s.params.w));\n  let p = at.p;\n  let weight = roundedCoverage(p, s.clipBounds, s.radii, at.scale) * clamp(s.params.x, 0.0, 1.0) * areaInAt(s.mask, p, at.scale) * cornerCoverageAt(s.mask, s.maskRadii, p, at.scale) * at.keep;\n  if weight <= 0.0 { discard; }\n  var uv = (p - s.bounds.xy) / (s.bounds.zw - s.bounds.xy);\n  let turn = u32(s.params.z);\n  if turn == 1u { uv = vec2f(uv.y, 1.0 - uv.x); }\n  if turn == 2u { uv = vec2f(1.0) - uv; }\n  if turn == 3u { uv = vec2f(1.0 - uv.y, uv.x); }\n  let q = s.bounds.xy + uv * (s.bounds.zw - s.bounds.xy);\n  let flags = u32(s.params.y);\n  var c: vec4f;\n  if (flags & 2u) != 0u { c = nearestTile(s.tile, s.bounds, q); } else { c = sampleTile(s.tile, s.bounds, q); }\n  if (flags & 1u) != 0u {\n    let l = dot(c.rgb, vec3f(0.2126, 0.7152, 0.0722));\n    c = vec4f(l, l, l, c.a);\n  }\n  return c * weight;\n}\n" }
pub fn path() -> &'static [u8] { return b"// Shared by every UI pipeline (silk task embed-shaders prepends it). Coordinates are device pixels,\n// y down. Colors leave the fragment shaders premultiplied; the pipelines blend source-over.\nstruct Globals {\n  // Target width and height in pixels.\n  size: vec2f,\n  // Text: enhanced contrast for grayscale glyphs (0 turns it off).\n  contrast: f32,\n  unused: f32,\n  // Text: DirectWrite gamma correction ratios (all 0 turns it off).\n  gamma: vec4f,\n  // Image-only retained scenes: uniform scale, reserved, translation x/y.\n  imageCamera: vec4f,\n  // Where the target's pixel (0, 0) lies in scene pixels: an offscreen page holds only the part\n  // of the scene its layers cover. `size` is the target's own size. zw unused.\n  origin: vec4f,\n}\n@group(0) @binding(0) var<uniform> globals: Globals;\n\n// Corner radii, fitted on the CPU (Radii.fitted): horizontal `x` and vertical `y` of the\n// top-left, top-right, bottom-right and bottom-left corners. A corner with a zero radius is square.\nstruct Radii { x: vec4f, y: vec4f }\n\n// Gradient ramps, 256 premultiplied RGBA8 words each. Only quads and paths read it.\n@group(0) @binding(7) var<storage, read> ramps: array<u32>;\n\n// A layer drawn straight onto its parent's surface instead of through a texture: its primitives\n// keep the layer's own pixels and take this to where they land, faded by the layer's opacity.\n// Entry 0 is unused: a primitive whose transform is 0 is drawn where it lies. Paths do not read\n// it.\nstruct Transform {\n  // Rows of the map from a layer pixel to a scene pixel, `x' = dot(to0.xyz, (x, y, 1))`, and of\n  // its inverse.\n  to0: vec4f,\n  to1: vec4f,\n  from0: vec4f,\n  from1: vec4f,\n  // The scene pixels the layer may touch and their corner radii: the content mask it lands in.\n  // A texture would also cut the layer to the pixels it holds; drawn here, its primitives end\n  // where they end.\n  clip: vec4f,\n  clipRadii: Radii,\n  // x is the layer's opacity; the rest is unused.\n  more: vec4f,\n}\n@group(0) @binding(8) var<storage, read> transforms: array<Transform>;\n\nconst CORNERS = array<vec2f, 6>(vec2f(0.0, 0.0), vec2f(1.0, 0.0), vec2f(0.0, 1.0), vec2f(0.0, 1.0), vec2f(1.0, 0.0), vec2f(1.0, 1.0));\n\n// Clip space for corner `index` of the pixel rectangle `r` (xMin, yMin, xMax, yMax).\nfn corner(r: vec4f, index: u32) -> vec4f {\n  let c = CORNERS[index];\n  let p = mix(r.xy, r.zw, c) - globals.origin.xy;\n  return vec4f(p.x / globals.size.x * 2.0 - 1.0, 1.0 - p.y / globals.size.y * 2.0, 0.0, 1.0);\n}\n\n// The pixels a primitive drawing `bounds` under `mask` touches: their intersection rounded out to\n// whole pixels and clamped to the target, in scene pixels. Empty rectangles collapse to a point.\nfn cover(bounds: vec4f, mask: vec4f) -> vec4f {\n  let low = globals.origin.xy;\n  let high = low + globals.size;\n  let lo = clamp(floor(max(bounds.xy, mask.xy)), low, high);\n  let hi = clamp(ceil(min(bounds.zw, mask.zw)), low, high);\n  return vec4f(lo, max(hi, lo));\n}\n\n// A corner of a primitive: its clip space position and, for a transformed one, its layer pixel.\nstruct Placed { position: vec4f, local: vec2f }\n\n// Corner `index` of a primitive that draws `bounds` under `mask` through transform `transform`.\nfn place(bounds: vec4f, mask: vec4f, transform: u32, index: u32) -> Placed {\n  if transform == 0u { return Placed(corner(cover(bounds, mask), index), vec2f(0.0)); }\n  let t = transforms[transform];\n  // The layer pixels it touches, wider by what one device pixel spans for the edges' ramps.\n  let lo = max(bounds.xy, mask.xy);\n  let hi = max(min(bounds.zw, mask.zw), lo);\n  let margin = vec2f(abs(t.from0.x) + abs(t.from0.y), abs(t.from1.x) + abs(t.from1.y));\n  let local = mix(lo - margin, hi + margin, CORNERS[index]);\n  let p = vec2f(dot(t.to0.xyz, vec3f(local, 1.0)), dot(t.to1.xyz, vec3f(local, 1.0))) - globals.origin.xy;\n  return Placed(vec4f(p.x / globals.size.x * 2.0 - 1.0, 1.0 - p.y / globals.size.y * 2.0, 0.0, 1.0), local);\n}\n\n// A fragment of a primitive: `p` is its center in the primitive's own pixels (scene pixels, or\n// the layer's for a transformed one), `scale` the device pixels one of those spans along x and\n// along y, and `keep` how much of the pixel the transform's clip keeps.\nstruct Spot { p: vec2f, scale: vec2f, keep: f32 }\n\nfn spot(position: vec4f, local: vec2f, transform: u32) -> Spot {\n  let device = position.xy + globals.origin.xy;\n  if transform == 0u { return Spot(device, vec2f(1.0), 1.0); }\n  let t = transforms[transform];\n  let scale = vec2f(length(vec2f(t.to0.x, t.to1.x)), length(vec2f(t.to0.y, t.to1.y)));\n  let keep = areaIn(t.clip, device) * cornerCoverage(t.clip, t.clipRadii, device) * t.more.x;\n  return Spot(local, scale, keep);\n}\n\n// How much of the pixel square around `p` (a pixel center) lies in `r`, as the CPU reference clips.\nfn areaIn(r: vec4f, p: vec2f) -> f32 {\n  let lo = max(p - 0.5, r.xy);\n  let hi = min(p + 0.5, r.zw);\n  let d = clamp(hi - lo, vec2f(0.0), vec2f(1.0));\n  return d.x * d.y;\n}\n\n// `areaIn` where a pixel of `r` spans `scale` device pixels: the device pixel around `p` is\n// `1 / scale` of them wide.\nfn areaInAt(r: vec4f, p: vec2f, scale: vec2f) -> f32 {\n  let half = 0.5 / scale;\n  let lo = max(p - half, r.xy);\n  let hi = min(p + half, r.zw);\n  let d = clamp((hi - lo) * scale, vec2f(0.0), vec2f(1.0));\n  return d.x * d.y;\n}\n\n// The device pixels in one pixel of a shape along its outward normal `n`, where the shape's\n// pixels span `scale` device pixels.\nfn along(n: vec2f, scale: vec2f) -> f32 {\n  return 1.0 / max(length(n / scale), 0.000001);\n}\n\n// The radii (horizontal, vertical) of the corner of quadrant `q` (from the center).\nfn pickRadii(q: vec2f, r: Radii) -> vec2f {\n  if q.x < 0.0 {\n    return select(vec2f(r.x.w, r.y.w), vec2f(r.x.x, r.y.x), q.y < 0.0);\n  }\n  return select(vec2f(r.x.z, r.y.z), vec2f(r.x.y, r.y.y), q.y < 0.0);\n}\n\n// Signed distance to the ellipse with radii `e` from `d`, a point measured from its center: the\n// implicit function over its gradient, exact for a circle. Matches radii.ellipseDistance.\nfn ellipseDistance(d: vec2f, e: vec2f) -> f32 {\n  let k1 = length(d / (e * e));\n  if k1 <= 0.0 { return -min(e.x, e.y); }\n  let k0 = length(d / e);\n  return k0 * (k0 - 1.0) / k1;\n}\n\n// Signed distance from `a`, a point folded into the positive quadrant of a rectangle of half size\n// `half`, to that rectangle with the corner there the quarter ellipse with radii `e`.\nfn foldedRectSdf(a: vec2f, half: vec2f, e: vec2f) -> f32 {\n  let d = a - (half - e);\n  // Circular and square corners, the common case, take the branch-free circle distance.\n  if e.x == e.y { return min(max(d.x, d.y), 0.0) + length(max(d, vec2f(0.0))) - e.x; }\n  if d.x > 0.0 && d.y > 0.0 && e.x > 0.0 && e.y > 0.0 {\n    return ellipseDistance(d, e);\n  }\n  let b = a - half;\n  return min(max(b.x, b.y), 0.0) + length(max(b, vec2f(0.0)));\n}\n\n// Signed distance from `p` to rectangle `r` with corners `radii`; negative inside.\nfn roundedRectSdf(p: vec2f, r: vec4f, radii: Radii) -> f32 {\n  let half = (r.zw - r.xy) * 0.5;\n  let q = p - (r.xy + half);\n  return foldedRectSdf(abs(q), half, max(pickRadii(q, radii), vec2f(0.0)));\n}\n\n// Whether any corner of `radii` is rounded.\nfn isRounded(radii: Radii) -> bool {\n  return max(max(radii.x.x, radii.x.y), max(radii.x.z, radii.x.w)) > 0.0;\n}\n\n// The outward normal at `d` (from the corner's center) of the corner with radii `e`.\nfn cornerNormal(d: vec2f, e: vec2f) -> vec2f {\n  if e.x > 0.0 && e.y > 0.0 { return normalize(d / (e * e)); }\n  return normalize(d);\n}\n\n// How much of the pixel centered at `p` the rounded corners `radii` of content mask `r` keep: 1\n// away from the corners, so the rectangle stays `areaIn`'s. Matches ContentMask.cornerCoverage.\nfn cornerCoverage(r: vec4f, radii: Radii, p: vec2f) -> f32 {\n  return cornerCoverageAt(r, radii, p, vec2f(1.0));\n}\n\n// `cornerCoverage` where a pixel of `r` spans `scale` device pixels.\nfn cornerCoverageAt(r: vec4f, radii: Radii, p: vec2f, scale: vec2f) -> f32 {\n  if !isRounded(radii) { return 1.0; }\n  let half = (r.zw - r.xy) * 0.5;\n  let q = p - (r.xy + half);\n  let e = pickRadii(q, radii);\n  if e.x <= 0.0 || e.y <= 0.0 { return 1.0; }\n  let d = abs(q) - half + e;\n  if d.x <= 0.0 || d.y <= 0.0 { return 1.0; }\n  var distance = length(d) - e.x;\n  if e.x != e.y { distance = ellipseDistance(d, e); }\n  if scale.x == 1.0 && scale.y == 1.0 { return clamp(0.5 - distance, 0.0, 1.0); }\n  return clamp(0.5 - distance * along(cornerNormal(d, e), scale), 0.0, 1.0);\n}\n\n// Coverage of the pixel at `p` by rectangle `r` with corners `radii`, where a pixel of `r` spans\n// `scale` device pixels: `coverage(roundedRectSdf(p, r, radii))` at scale 1.\nfn roundedCoverage(p: vec2f, r: vec4f, radii: Radii, scale: vec2f) -> f32 {\n  let distance = roundedRectSdf(p, r, radii);\n  if scale.x == 1.0 && scale.y == 1.0 { return coverage(distance); }\n  let half = (r.zw - r.xy) * 0.5;\n  let q = p - (r.xy + half);\n  let e = max(pickRadii(q, radii), vec2f(0.0));\n  let d = abs(q) - half + e;\n  var n = vec2f(0.0, 1.0);\n  if d.x > 0.0 && d.y > 0.0 { n = cornerNormal(d, e); } else if d.x > d.y { n = vec2f(1.0, 0.0); }\n  return coverage(distance * along(n, scale));\n}\n\n// Signed distance from `p` to rectangle `r` whose corner in `p`'s quadrant is the quarter\n// ellipse with radii `e`.\nfn ellipticRectSdf(p: vec2f, r: vec4f, e: vec2f) -> f32 {\n  let half = (r.zw - r.xy) * 0.5;\n  return foldedRectSdf(abs(p - (r.xy + half)), half, e);\n}\n\n// Coverage of the pixel at `p` from a signed distance: exact for a straight edge.\nfn coverage(distance: f32) -> f32 {\n  return clamp(0.5 - distance, 0.0, 1.0);\n}\n\n// A background: a solid color or a CSS gradient. `kind.x` is 0 for solid, 1 for a two-stop linear\n// gradient mixed here in sRGB, 2 for one read from ramp `kind.y` of `ramps` (any other\n// interpolation, sampled on the CPU with silk.color), 3 for a gradient with any number of stops\n// mixed here in sRGB: `first.x` of them at word `kind.y` of `ramps`, five words each (the offset,\n// then the straight color), repeating when `first.y` is 1. With any other interpolation `first.z`\n// is one more than the first of their ramps, one per pair of neighbours. `kind.w` is the shape: 0 linear,\n// 1 radial, 2 conic. For two stops `first` and `last` hold them, straight sRGB (`first` is the\n// solid color). `line` is the center and then the direction (linear), the reciprocal radii\n// (radial) or the start angle in turns (conic); `stops` holds the linear half length and the two\n// stop offsets.\nstruct Paint {\n  kind: vec4u,\n  first: vec4f,\n  last: vec4f,\n  line: vec4f,\n  stops: vec4f,\n}\n\nfn premultiply(c: vec4f) -> vec4f {\n  let s = clamp(c, vec4f(0.0), vec4f(1.0));\n  return vec4f(s.rgb * s.a, s.a);\n}\n\n// The premultiplied color of `paint` at pixel center `p`. Gradients take their parameter in\n// 1/255 steps and mix premultiplied, as the CPU reference's 256-entry ramp does.\nfn shade(paint: Paint, p: vec2f) -> vec4f {\n  if paint.kind.x == 0u { return premultiply(paint.first); }\n  let d = p - paint.line.xy;\n  var along = dot(d, paint.line.zw) / paint.stops.x * 0.5 + 0.5;\n  if paint.kind.w == 1u {\n    along = length(d * paint.line.zw);\n  } else if paint.kind.w == 2u {\n    let a = atan2(d.x, -d.y) / 6.2831855 - paint.line.z;\n    along = a - floor(a);\n  }\n  if paint.kind.x == 3u { return shadeStops(paint, along); }\n  let span = paint.stops.z - paint.stops.y;\n  var t = select(0.0, 1.0, along >= paint.stops.y);\n  if span > 0.0 { t = (along - paint.stops.y) / span; }\n  let step = floor(clamp(t, 0.0, 1.0) * 255.0 + 0.5);\n  if paint.kind.x == 2u { return unpack4x8unorm(ramps[paint.kind.y * 256u + u32(step)]); }\n  return mixPremultiplied(paint.first, paint.last, step / 255.0);\n}\n\n// Straight colors `a` and `b` mixed premultiplied at `t`.\nfn mixPremultiplied(a: vec4f, b: vec4f, t: f32) -> vec4f {\n  let aa = clamp(a.a, 0.0, 1.0);\n  let ba = clamp(b.a, 0.0, 1.0);\n  let alpha = aa + (ba - aa) * t;\n  if !(alpha > 0.0) { return vec4f(0.0); }\n  let c = (a.rgb * aa + (b.rgb * ba - a.rgb * aa) * t) / alpha;\n  return premultiply(vec4f(c, alpha));\n}\n\nfn stopOffset(base: u32, i: u32) -> f32 {\n  return bitcast<f32>(ramps[base + i * 5u]);\n}\n\nfn stopColor(base: u32, i: u32) -> vec4f {\n  let w = base + i * 5u;\n  return vec4f(bitcast<f32>(ramps[w + 1u]), bitcast<f32>(ramps[w + 2u]), bitcast<f32>(ramps[w + 3u]), bitcast<f32>(ramps[w + 4u]));\n}\n\n// The stops of `paint` at offset `along`, mixed in 1/255 steps between neighbours.\nfn shadeStops(paint: Paint, along: f32) -> vec4f {\n  let base = paint.kind.y;\n  let n = u32(paint.first.x);\n  if n == 0u { return vec4f(0.0); }\n  let first = stopOffset(base, 0u);\n  let period = stopOffset(base, n - 1u) - first;\n  var a = along;\n  if paint.first.y > 0.5 && period > 0.000001 {\n    let k = (a - first) / period;\n    a = first + (k - floor(k)) * period;\n  }\n  var i = 0u;\n  loop {\n    if i + 1u >= n || stopOffset(base, i + 1u) > a { break; }\n    i = i + 1u;\n  }\n  if i + 1u >= n || a < first { return mixPremultiplied(stopColor(base, i), stopColor(base, i), 0.0); }\n  let lo = stopOffset(base, i);\n  let t = (a - lo) / (stopOffset(base, i + 1u) - lo);\n  let step = floor(clamp(t, 0.0, 1.0) * 255.0 + 0.5);\n  if paint.first.z > 0.5 {\n    return unpack4x8unorm(ramps[(u32(paint.first.z) - 1u + i) * 256u + u32(step)]);\n  }\n  return mixPremultiplied(stopColor(base, i), stopColor(base, i + 1u), step / 255.0);\n}\n// Paths: `vector` coverage strips (4-row bands with one coverage byte per row, packed into a\n// word per column) and fully covered runs, placed at the path's integer origin. The band layout\n// is gpu_scene's, except that bands start at the sprite's own y and every run has a paint record.\nstruct Run {\n  x: i32,\n  y: i32,\n  width: u32,\n  // Word index of the first column in `alphas`, or SOLID for a fully covered run.\n  alpha: u32,\n  path: u32,\n  // The last row + 1 the path covers.\n  bottom: i32,\n  unused0: u32,\n  unused1: u32,\n}\nstruct PathRecord {\n  mask: vec4f,\n  paint: Paint,\n  maskRadii: Radii,\n}\n@group(0) @binding(1) var<storage, read> runs: array<Run>;\n@group(0) @binding(2) var<storage, read> paths: array<PathRecord>;\n@group(0) @binding(3) var<storage, read> alphas: array<u32>;\n\nconst SOLID: u32 = 0xffffffffu;\n\nstruct Varying { @builtin(position) position: vec4f, @location(0) @interpolate(flat) index: u32 }\n\n@vertex fn vs(@builtin(vertex_index) v: u32, @builtin(instance_index) index: u32) -> Varying {\n  let r = runs[index];\n  let top = f32(r.y);\n  let x = f32(r.x);\n  let bounds = vec4f(x, top, x + f32(r.width), f32(min(r.y + 4, r.bottom)));\n  return Varying(corner(cover(bounds, paths[r.path].mask), v), index);\n}\n\n@fragment fn fs(v: Varying) -> @location(0) vec4f {\n  let r = runs[v.index];\n  let path = paths[r.path];\n  let p = v.position.xy + globals.origin.xy;\n  let clip = areaIn(path.mask, p) * cornerCoverage(path.mask, path.maskRadii, p);\n  if clip <= 0.0 { discard; }\n  var alpha = 1.0;\n  if r.alpha != SOLID {\n    let column = u32(i32(floor(p.x)) - r.x);\n    let row = u32(i32(floor(p.y)) - r.y);\n    alpha = f32((alphas[r.alpha + column] >> (8u * row)) & 255u) / 255.0;\n  }\n  return shade(path.paint, p) * (alpha * clip);\n}\n" }
pub fn layer() -> &'static [u8] { return b"// Blend-mode math shared by compose.wgsl and filter.wgsl (silk task embed-shaders prepends it),\n// matching vector.layer on premultiplied bytes.\n\nconst NORMAL: u32 = 0u;\nconst MULTIPLY: u32 = 1u;\nconst SCREEN: u32 = 2u;\nconst OVERLAY: u32 = 3u;\nconst DARKEN: u32 = 4u;\nconst LIGHTEN: u32 = 5u;\nconst COLOR_DODGE: u32 = 6u;\nconst COLOR_BURN: u32 = 7u;\nconst HARD_LIGHT: u32 = 8u;\nconst SOFT_LIGHT: u32 = 9u;\nconst DIFFERENCE: u32 = 10u;\nconst EXCLUSION: u32 = 11u;\nconst HUE: u32 = 12u;\nconst SATURATION: u32 = 13u;\nconst COLOR: u32 = 14u;\n// From here on Porter-Duff compositing, as vector.layer composePixel.\nconst PLUS_LIGHTER: u32 = 16u;\nconst SOURCE_IN: u32 = 17u;\nconst SOURCE_OUT: u32 = 18u;\nconst XOR: u32 = 19u;\n\nfn div255(x: u32) -> u32 {\n  let t = x + 128u;\n  return (t + (t >> 8u)) >> 8u;\n}\n\nfn bytes(t: texture_2d<f32>, pixel: vec2u) -> vec4u {\n  return vec4u(round(textureLoad(t, pixel, 0) * 255.0));\n}\n\nfn toByte(v: f32) -> u32 { return u32(floor(clamp(v, 0.0, 1.0) * 255.0 + 0.5)); }\n\nfn hardLight(cb: f32, cs: f32) -> f32 {\n  if cs <= 0.5 { return cb * 2.0 * cs; }\n  let s = 2.0 * cs - 1.0;\n  return cb + s - cb * s;\n}\n\nfn separable(cb: f32, cs: f32, mode: u32) -> f32 {\n  switch mode {\n    case MULTIPLY: { return cb * cs; }\n    case SCREEN: { return cb + cs - cb * cs; }\n    case OVERLAY: { return hardLight(cs, cb); }\n    case DARKEN: { return min(cb, cs); }\n    case LIGHTEN: { return max(cb, cs); }\n    case COLOR_DODGE: {\n      if cb == 0.0 { return 0.0; }\n      if cs >= 1.0 { return 1.0; }\n      return min(1.0, cb / (1.0 - cs));\n    }\n    case COLOR_BURN: {\n      if cb >= 1.0 { return 1.0; }\n      if cs <= 0.0 { return 0.0; }\n      return 1.0 - min(1.0, (1.0 - cb) / cs);\n    }\n    case HARD_LIGHT: { return hardLight(cb, cs); }\n    case SOFT_LIGHT: {\n      if cs <= 0.5 { return cb - (1.0 - 2.0 * cs) * cb * (1.0 - cb); }\n      var d = sqrt(cb);\n      if cb <= 0.25 { d = ((16.0 * cb - 12.0) * cb + 4.0) * cb; }\n      return cb + (2.0 * cs - 1.0) * (d - cb);\n    }\n    case DIFFERENCE: { return abs(cb - cs); }\n    case EXCLUSION: { return cb + cs - 2.0 * cb * cs; }\n    default: { return cs; }\n  }\n}\n\nfn lum(c: vec3f) -> f32 { return 0.3 * c.x + 0.59 * c.y + 0.11 * c.z; }\n\nfn clipColor(c: vec3f) -> vec3f {\n  let l = lum(c);\n  let n = min(c.x, min(c.y, c.z));\n  let x = max(c.x, max(c.y, c.z));\n  var r = c;\n  if n < 0.0 { r = l + (r - l) * l / (l - n); }\n  if x > 1.0 { r = l + (r - l) * (1.0 - l) / (x - l); }\n  return r;\n}\n\nfn setLum(c: vec3f, l: f32) -> vec3f { return clipColor(c + (l - lum(c))); }\n\nfn sat(c: vec3f) -> f32 { return max(c.x, max(c.y, c.z)) - min(c.x, min(c.y, c.z)); }\n\nfn setSat(c: vec3f, s: f32) -> vec3f {\n  let mx = max(c.x, max(c.y, c.z));\n  let mn = min(c.x, min(c.y, c.z));\n  if mx <= mn { return vec3f(0.0); }\n  return (c - mn) * s / (mx - mn);\n}\n\nfn composed(b: vec4u, s: vec4u, mode: u32) -> vec4u {\n  if mode == PLUS_LIGHTER { return min(s + b, vec4u(255u)); }\n  var fs = 255u - b.w;\n  if mode == SOURCE_IN { fs = b.w; }\n  var fb = 0u;\n  if mode == XOR { fb = 255u - s.w; }\n  let r = vec4u(div255(s.x * fs), div255(s.y * fs), div255(s.z * fs), div255(s.w * fs))\n    + vec4u(div255(b.x * fb), div255(b.y * fb), div255(b.z * fb), div255(b.w * fb));\n  return min(r, vec4u(255u));\n}\n\n// Whether `mode` changes the backdrop under a transparent source pixel.\nfn clearsUnder(mode: u32) -> bool { return mode == SOURCE_IN || mode == SOURCE_OUT; }\n\n// co = cs (1 - ab) + cb (1 - as) + as ab B(Cb, Cs), ao = as + ab (1 - as), on premultiplied bytes.\nfn blend(b: vec4u, s: vec4u, mode: u32) -> vec4u {\n  if mode == NORMAL {\n    let inverse = 255u - s.w;\n    return s + vec4u(div255(b.x * inverse), div255(b.y * inverse), div255(b.z * inverse), div255(b.w * inverse));\n  }\n  if mode >= PLUS_LIGHTER { return composed(b, s, mode); }\n  let sa = f32(s.w) / 255.0;\n  let ba = f32(b.w) / 255.0;\n  if sa == 0.0 { return b; }\n  let sc = vec3f(f32(s.x) / 255.0, f32(s.y) / 255.0, f32(s.z) / 255.0);\n  let bc = vec3f(f32(b.x) / 255.0, f32(b.y) / 255.0, f32(b.z) / 255.0);\n  let cs = sc / sa;\n  var cb = vec3f(0.0);\n  if ba > 0.0 { cb = bc / ba; }\n  var r = vec3f(0.0);\n  if mode == HUE {\n    r = setLum(setSat(cs, sat(cb)), lum(cb));\n  } else if mode == SATURATION {\n    r = setLum(setSat(cb, sat(cs)), lum(cb));\n  } else if mode == COLOR {\n    r = setLum(cs, lum(cb));\n  } else if mode > COLOR {\n    r = setLum(cb, lum(cs));\n  } else {\n    r = vec3f(separable(cb.x, cs.x, mode), separable(cb.y, cs.y, mode), separable(cb.z, cs.z, mode));\n  }\n  let k = sa * ba;\n  let o = sc * (1.0 - ba) + bc * (1.0 - sa) + k * r;\n  return vec4u(toByte(o.x), toByte(o.y), toByte(o.z), toByte(sa + ba * (1.0 - sa)));\n}\n\n// Blending without compositing (feBlend no-composite): `s` mixed with B(Cb, Cs), keeping\n// its alpha; vector.layer mixPixel.\nfn mixed(b: vec4u, s: vec4u, mode: u32) -> vec4u {\n  if mode == NORMAL || s.w == 0u { return s; }\n  let sa = f32(s.w) / 255.0;\n  let ba = f32(b.w) / 255.0;\n  let sc = vec3f(f32(s.x) / 255.0, f32(s.y) / 255.0, f32(s.z) / 255.0);\n  let bc = vec3f(f32(b.x) / 255.0, f32(b.y) / 255.0, f32(b.z) / 255.0);\n  let cs = sc / sa;\n  var cb = vec3f(0.0);\n  if ba > 0.0 { cb = bc / ba; }\n  var r = vec3f(0.0);\n  if mode == HUE {\n    r = setLum(setSat(cs, sat(cb)), lum(cb));\n  } else if mode == SATURATION {\n    r = setLum(setSat(cb, sat(cs)), lum(cb));\n  } else if mode == COLOR {\n    r = setLum(cs, lum(cb));\n  } else if mode > COLOR {\n    r = setLum(cb, lum(cs));\n  } else {\n    r = vec3f(separable(cb.x, cs.x, mode), separable(cb.y, cs.y, mode), separable(cb.z, cs.z, mode));\n  }\n  let o = sc * (1.0 - ba) + sa * ba * r;\n  return vec4u(toByte(o.x), toByte(o.y), toByte(o.z), s.w);\n}\n// Isolated layers: composite a layer onto a copy of what is under it with a vector.layer blend\n// mode and a group opacity (prepended with gpu_scene's blend.wgsl), and copy a finished frame out\n// to a target of any format. A plain layer (normal blend, no filters, no mask) is instead blitted\n// inside its parent's pass, where the pipeline blends it source-over. A blit that is `masked` keeps\n// the layer inside the alpha of its mask layer, bound in place of the filtered backdrop.\n// A transformed layer (`mapped` set) is sampled bilinearly through `inverse` (rows), which maps a\n// target pixel back to a layer pixel, within the layer pixels `source` (x0, y0, x1, y1).\n// Positions are scene pixels; a page holds only part of the scene, so `origins` gives where pixel\n// (0, 0) of the output (xy) and of the layer's page or texture (zw) lie, `maskOrigin` of the\n// mask's page, and `backdropOrigin` of a composite's backdrop copy and its blur. A backdrop blurred\n// by `blur.wgsl` is `blurSize` pixels that each span `blurScale` pixels of the backdrop copy, and\n// is scaled back up here as that shader's GROW does; `blurScale` 0 is a blur at full size.\nstruct Params {\n  op: u32, mode: u32, opacity: u32, backdropEnabled: u32, clip: vec4f, pad0: u32, pad1: u32, maskOrigin: vec2u,\n  inverse0: vec4f, inverse1: vec4f, inverse2: vec4f, source: vec4f, mapped: u32, masked: u32, rounded: u32, blurScale: u32,\n  // The content mask the layer lands in; its rounded corners clip the layer.\n  maskBounds: vec4f, maskRadii: Radii,\n  origins: vec4u,\n  backdropOrigin: vec2u, blurSize: vec2u,\n  // The corners of the backdrop's `clip`.\n  clipRadii: Radii,\n}\n// A copy of common.wgsl's corner functions, which this shader is not prepended with.\n// Corner radii, fitted on the CPU (Radii.fitted): horizontal `x` and vertical `y` of the\n// top-left, top-right, bottom-right and bottom-left corners. A corner with a zero radius is square.\nstruct Radii { x: vec4f, y: vec4f }\n\n// The radii (horizontal, vertical) of the corner of quadrant `q` (from the center).\nfn pickRadii(q: vec2f, r: Radii) -> vec2f {\n  if q.x < 0.0 {\n    return select(vec2f(r.x.w, r.y.w), vec2f(r.x.x, r.y.x), q.y < 0.0);\n  }\n  return select(vec2f(r.x.z, r.y.z), vec2f(r.x.y, r.y.y), q.y < 0.0);\n}\n\n// Signed distance to the ellipse with radii `e` from `d`, a point measured from its center: the\n// implicit function over its gradient, exact for a circle. Matches radii.ellipseDistance.\nfn ellipseDistance(d: vec2f, e: vec2f) -> f32 {\n  let k1 = length(d / (e * e));\n  if k1 <= 0.0 { return -min(e.x, e.y); }\n  let k0 = length(d / e);\n  return k0 * (k0 - 1.0) / k1;\n}\n\n// Signed distance from `a`, a point folded into the positive quadrant of a rectangle of half size\n// `half`, to that rectangle with the corner there the quarter ellipse with radii `e`.\nfn foldedRectSdf(a: vec2f, half: vec2f, e: vec2f) -> f32 {\n  let d = a - (half - e);\n  // Circular and square corners, the common case, take the branch-free circle distance.\n  if e.x == e.y { return min(max(d.x, d.y), 0.0) + length(max(d, vec2f(0.0))) - e.x; }\n  if d.x > 0.0 && d.y > 0.0 && e.x > 0.0 && e.y > 0.0 {\n    return ellipseDistance(d, e);\n  }\n  let b = a - half;\n  return min(max(b.x, b.y), 0.0) + length(max(b, vec2f(0.0)));\n}\n\n// Signed distance from `p` to rectangle `r` with corners `radii`; negative inside.\nfn roundedRectSdf(p: vec2f, r: vec4f, radii: Radii) -> f32 {\n  let half = (r.zw - r.xy) * 0.5;\n  let q = p - (r.xy + half);\n  return foldedRectSdf(abs(q), half, max(pickRadii(q, radii), vec2f(0.0)));\n}\n\n@group(0) @binding(0) var<uniform> params: Params;\n@group(0) @binding(1) var backdrop: texture_2d<f32>;\n@group(0) @binding(2) var layer: texture_2d<f32>;\n@group(0) @binding(3) var filteredBackdrop: texture_2d<f32>;\n\nconst OP_COMPOSITE: u32 = 0u;\nconst OP_COPY: u32 = 1u;\nconst OP_BLIT: u32 = 2u;\n\n@vertex fn vs(@builtin(vertex_index) index: u32) -> @builtin(position) vec4f {\n  let p = vec2f(f32((index << 1u) & 2u), f32(index & 2u));\n  return vec4f(p * 2.0 - 1.0, 0.0, 1.0);\n}\n\n// `s` inside the mask layer's alpha at scene pixel `pixel`, as vector.filter's COMPOSITE_IN.\nfn inMask(s: vec4u, pixel: vec2u) -> vec4u {\n  let a = bytes(filteredBackdrop, pixel - params.maskOrigin).w;\n  return vec4u(div255(s.x * a), div255(s.y * a), div255(s.z * a), div255(s.w * a));\n}\n\nfn texel(x: f32, y: f32) -> vec4f {\n  let start = vec2f(params.origins.zw);\n  let size = vec2f(textureDimensions(layer));\n  let low = max(params.source.xy, start);\n  let high = min(params.source.zw, start + size) - 1.0;\n  if x < low.x || y < low.y || x > high.x || y > high.y { return vec4f(0.0); }\n  let at = vec2u(u32(x), u32(y));\n  let local = at - params.origins.zw;\n  if params.masked != 0u { return vec4f(inMask(bytes(layer, local), at)); }\n  return textureLoad(layer, local, 0) * 255.0;\n}\n\nfn mappedBytes(position: vec2f) -> vec4u {\n  let p = vec3f(position, 1.0);\n  let w = dot(params.inverse2.xyz, p);\n  if w <= 0.000001 { return vec4u(0u); }\n  let s = vec2f(dot(params.inverse0.xyz, p), dot(params.inverse1.xyz, p)) / w - 0.5;\n  let f = floor(s);\n  let t = s - f;\n  let top = mix(texel(f.x, f.y), texel(f.x + 1.0, f.y), t.x);\n  let bottom = mix(texel(f.x, f.y + 1.0), texel(f.x + 1.0, f.y + 1.0), t.x);\n  return vec4u(round(clamp(mix(top, bottom, t.y), vec4f(0.0), vec4f(255.0))));\n}\n\n// The layer's bytes at scene pixel `pixel`; transparent outside its page.\nfn layerBytes(pixel: vec2u) -> vec4u {\n  let start = params.origins.zw;\n  let size = textureDimensions(layer);\n  if any(pixel < start) || any(pixel - start >= size) { return vec4u(0u); }\n  return bytes(layer, pixel - start);\n}\n\nfn blurredTexel(p: vec2i) -> vec4f {\n  return textureLoad(filteredBackdrop, vec2u(clamp(p, vec2i(0), vec2i(params.blurSize) - 1)), 0);\n}\n\n// The blurred backdrop at pixel `under` of the backdrop copy, as bytes.\nfn blurred(under: vec2u) -> vec4f {\n  if params.blurScale == 0u { return vec4f(bytes(filteredBackdrop, under)); }\n  let c = (vec2f(under) + 0.5) / f32(params.blurScale) - 0.5;\n  let f = floor(c);\n  let t = c - f;\n  let q = vec2i(f);\n  let top = mix(blurredTexel(q), blurredTexel(q + vec2i(1, 0)), t.x);\n  let bottom = mix(blurredTexel(q + vec2i(0, 1)), blurredTexel(q + vec2i(1, 1)), t.x);\n  return mix(top, bottom, t.y) * 255.0;\n}\n\n// How much of the pixel at `p` the mask's rounded corners keep (common.wgsl's cornerCoverage).\nfn corner(p: vec2f) -> f32 {\n  let r = params.maskBounds;\n  let half = (r.zw - r.xy) * 0.5;\n  let q = p - (r.xy + half);\n  let e = pickRadii(q, params.maskRadii);\n  if e.x <= 0.0 || e.y <= 0.0 { return 1.0; }\n  let d = abs(q) - half + e;\n  if d.x <= 0.0 || d.y <= 0.0 { return 1.0; }\n  if e.x == e.y { return clamp(0.5 - (length(d) - e.x), 0.0, 1.0); }\n  return clamp(0.5 - ellipseDistance(d, e), 0.0, 1.0);\n}\n\n// `s` scaled by `k` (0 to 1).\nfn scaled(s: vec4u, k: f32) -> vec4u {\n  if k >= 1.0 { return s; }\n  return vec4u(round(vec4f(s) * k));\n}\n\n// `s` times the group opacity.\nfn faded(s: vec4u) -> vec4u {\n  return vec4u(div255(s.x * params.opacity), div255(s.y * params.opacity), div255(s.z * params.opacity), div255(s.w * params.opacity));\n}\n\n@fragment fn fs(@builtin(position) output: vec4f) -> @location(0) vec4f {\n  let position = vec4f(output.xy + vec2f(params.origins.xy), output.zw);\n  let pixel = vec2u(position.xy);\n  var content = vec4u(0u);\n  if params.mapped != 0u {\n    content = mappedBytes(position.xy);\n  } else {\n    content = layerBytes(pixel);\n    if params.masked != 0u { content = inMask(content, pixel); }\n  }\n  if params.op == OP_COPY { return vec4f(content) / 255.0; }\n  if params.rounded != 0u { content = scaled(content, corner(position.xy)); }\n  if params.op == OP_BLIT {\n    if params.opacity == 255u { return vec4f(content) / 255.0; }\n    return vec4f(faded(content)) / 255.0;\n  }\n  let under = pixel - params.backdropOrigin;\n  var b = bytes(backdrop, under);\n  if params.backdropEnabled != 0u {\n    let distance = roundedRectSdf(position.xy, params.clip, params.clipRadii);\n    let coverage = clamp(0.5 - distance, 0.0, 1.0) * f32(params.opacity) / 255.0;\n    b = vec4u(round(mix(vec4f(b), blurred(under), coverage)));\n  }\n  if (params.opacity == 0u || content.w == 0u) && !clearsUnder(params.mode) { return vec4f(b) / 255.0; }\n  var s = content;\n  if params.opacity != 255u { s = faded(s); }\n  return vec4f(blend(b, s, params.mode)) / 255.0;\n}\n" }
pub fn blur() -> &'static [u8] { return b"// A fast Gaussian blur for layer effects, as Skia draws large blurs: halve the image until the\n// blur is a few pixels wide (HALVE), blur that with a separable kernel (ROWS, then COLUMNS), and\n// scale the result back up bilinearly (GROW; layer.wgsl scales a blurred backdrop up itself, where\n// it reads it). Its cost follows the image's pixels, not the blur's radius. Images are\n// premultiplied RGBA8.\nstruct Params {\n  op: u32,\n  // The kernel's radius (ROWS, COLUMNS) or how many source pixels one image pixel spans (GROW).\n  count: u32,\n  // 1 repeats the image's edge pixels past its edges; 0 reads transparent there.\n  clamped: u32,\n  pad0: u32,\n  // The image's pixels in its texture: x0, y0, x1, y1.\n  image: vec4u,\n  // The output pixel the image's first pixel lands on.\n  origin: vec2u,\n  pad1: vec2u,\n  // `weights[i / 4][i % 4]` weighs the pixels `i` places from the center.\n  weights: array<vec4f, 4>,\n}\n@group(0) @binding(0) var<uniform> params: Params;\n@group(0) @binding(1) var image: texture_2d<f32>;\n\nconst OP_HALVE: u32 = 0u;\nconst OP_ROWS: u32 = 1u;\nconst OP_COLUMNS: u32 = 2u;\nconst OP_GROW: u32 = 3u;\n\n@vertex fn vs(@builtin(vertex_index) index: u32) -> @builtin(position) vec4f {\n  // One triangle covering the target.\n  let p = vec2f(f32((index << 1u) & 2u), f32(index & 2u));\n  return vec4f(p * 2.0 - 1.0, 0.0, 1.0);\n}\n\nfn size() -> vec2i { return vec2i(params.image.zw - params.image.xy); }\n\nfn held(p: vec2i) -> vec4f {\n  return textureLoad(image, vec2u(clamp(p, vec2i(0), size() - 1)) + params.image.xy, 0);\n}\n\n// The image's pixel `p`, counted from its first.\nfn read(p: vec2i) -> vec4f {\n  if params.clamped == 0u && (any(p < vec2i(0)) || any(p >= size())) { return vec4f(0.0); }\n  return held(p);\n}\n\nfn weight(i: u32) -> f32 { return params.weights[i >> 2u][i & 3u]; }\n\n@fragment fn fs(@builtin(position) position: vec4f) -> @location(0) vec4f {\n  let p = vec2i(position.xy) - vec2i(params.origin);\n  if params.op == OP_HALVE {\n    let q = p * 2;\n    return (read(q) + read(q + vec2i(1, 0)) + read(q + vec2i(0, 1)) + read(q + vec2i(1, 1))) * 0.25;\n  }\n  if params.op == OP_GROW {\n    // Output pixel centers in image pixels; the image's edge pixels reach to the output's edge.\n    let c = (vec2f(p) + 0.5) / f32(params.count) - 0.5;\n    let f = floor(c);\n    let t = c - f;\n    let q = vec2i(f);\n    let top = mix(held(q), held(q + vec2i(1, 0)), t.x);\n    let bottom = mix(held(q + vec2i(0, 1)), held(q + vec2i(1, 1)), t.x);\n    return mix(top, bottom, t.y);\n  }\n  var step = vec2i(1, 0);\n  if params.op == OP_COLUMNS { step = vec2i(0, 1); }\n  var sum = read(p) * weight(0u);\n  for (var i = 1u; i <= params.count; i++) {\n    let offset = step * i32(i);\n    sum += (read(p + offset) + read(p - offset)) * weight(i);\n  }\n  return sum;\n}\n" }
