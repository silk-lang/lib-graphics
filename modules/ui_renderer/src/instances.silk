//! Packs a finished `ui_scene.Scene` into the instance layouts the WGSL shaders read.
//!
//! Every kind's sorted list, from every layer, goes into one byte list in layer order, so one GPU
//! buffer per kind holds the whole frame and a batch draws instances `base + start .. base + end`.
//! The lists keep their storage between frames.
import silk.collections.list { List }
import silk.geometry.corners { Corners }
import silk.geometry.rect { Rect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.f64
import silk.num.i32
import silk.num.u32
import silk.num.usize
import silk.color.color { ColorSpace, Interpolation }
import silk.color.rgba { Rgba }
import ui_scene.color
import ui_scene.color { RampCache }
import ui_scene.primitives {
  Background,
  BorderStyle,
  ColorStop,
  GradientShape,
  GlyphSprite,
  ImageSprite,
  PathSprite,
  Quad,
  Shadow,
  Underline,
}
import ui_scene.radii { Radii }
import ui_scene.scene { PrimitiveKind, Scene, KIND_COUNT }
import ui_scene.scroll { Placements }
import vector.pixmap { pack }
import vector.strips { Fill, Strip }

/// Bytes per instance of each kind, matching the structs in `shaders/`.
pub const QUAD_BYTES: usize = 208

pub const SHADOW_BYTES: usize = 192

pub const UNDERLINE_BYTES: usize = 96

pub const MONO_BYTES: usize = 112

/// Bytes of a `Transform` of `shaders/common.wgsl`.
pub const TRANSFORM_BYTES: usize = 128

pub const POLY_BYTES: usize = 144

pub const PATH_BYTES: usize = 128

pub const RUN_BYTES: usize = 32

/// Entries per gradient ramp, one premultiplied RGBA8 word each, as the CPU reference keeps.
pub const RAMP_LENGTH: usize = 256

const SOLID: u32 = 4294967295

const PI: f64 = 3.141592653589793

fn writeWord(bytes: &mut [u8], offset: usize, value: u32) -> () {
  bytes[offset] = u32.toU8(value & 255)
  bytes[offset + 1] = u32.toU8(u32.shiftRight(value, 8) & 255)
  bytes[offset + 2] = u32.toU8(u32.shiftRight(value, 16) & 255)
  bytes[offset + 3] = u32.toU8(u32.shiftRight(value, 24))
}

effect fn pushU32(bytes: &mut List<u8>, value: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut word: [u8; 4] = [0; 4]
  writeWord(&mut word, 0, value)
  run bytes.appendSlice(&word)
}

effect fn pushF32(bytes: &mut List<u8>, value: f32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run pushU32(&mut bytes, f32.toBits(value))
}

effect fn push4(bytes: &mut List<u8>, a: f32, b: f32, c: f32, d: f32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  // One capacity check and bulk copy per vector, instead of sixteen individual appends.
  // Explicit little-endian writes preserve the shader ABI independently of host endianness.
  let mut vector: [u8; 16] = [0; 16]
  writeWord(&mut vector, 0, f32.toBits(a))
  writeWord(&mut vector, 4, f32.toBits(b))
  writeWord(&mut vector, 8, f32.toBits(c))
  writeWord(&mut vector, 12, f32.toBits(d))
  run bytes.appendSlice(&vector)
}

effect fn pushRect(bytes: &mut List<u8>, r: Rect<f32>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run push4(&mut bytes, r.xMin, r.yMin, r.xMax, r.yMax)
}

effect fn pushColor(bytes: &mut List<u8>, c: Rgba<f32>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run push4(&mut bytes, c.r, c.g, c.b, c.a)
}

effect fn pushCorners(bytes: &mut List<u8>, c: Corners<f32>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run push4(&mut bytes, c.topLeft, c.topRight, c.bottomRight, c.bottomLeft)
}

/// The horizontal radii, then the vertical ones: a WGSL `Radii`.
effect fn pushRadii(bytes: &mut List<u8>, r: Radii) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run pushCorners(&mut bytes, r.x)
  run pushCorners(&mut bytes, r.y)
}

/// Appends the 256-entry ramp from `from` to `to` to `ramps`, sampled with the same `color.mix`
/// the CPU reference uses, and returns its index.
effect fn pushRamp(
  ramps: &mut List<u8>,
  cache: &mut RampCache,
  from: ColorStop,
  to: ColorStop,
  interpolation: Interpolation,
) -> u32
  ! OutOfMemoryError
  ? &mut Allocator {
  // Stops of other gradients may share the buffer: start on a whole ramp.
  while ramps.length() % (RAMP_LENGTH * 4) != 0 {
    run pushU32(&mut ramps, 0)
  }
  let index = usize.toU32(ramps.length() / (RAMP_LENGTH * 4))
  let start = run cache.ramp(from.color, to.color, interpolation)
  let mut i: usize = 0
  while i < RAMP_LENGTH {
    run pushU32(&mut ramps, cache.word(start + i))
    i = i + 1
  }
  return index
}

/// Appends one 256-entry ramp per pair of neighbouring `stops`, as the CPU reference's
/// `Painter.setStopRamps`, and returns the index of the first.
effect fn pushStopRamps(
  ramps: &mut List<u8>,
  cache: &mut RampCache,
  stops: &[ColorStop],
  interpolation: Interpolation,
) -> u32
  ! OutOfMemoryError
  ? &mut Allocator {
  while ramps.length() % (RAMP_LENGTH * 4) != 0 {
    run pushU32(&mut ramps, 0)
  }
  let index = usize.toU32(ramps.length() / (RAMP_LENGTH * 4))
  let mut i: usize = 0
  while i + 1 < stops.length {
    let a = stops[i]
    let b = stops[i + 1]
    if b.offset > a.offset && !(a.color.r == b.color.r && a.color.g == b.color.g
      && a.color.b == b.color.b && a.color.a == b.color.a) {
      let start = run cache.ramp(a.color, b.color, interpolation)
      let mut step: usize = 0
      while step < RAMP_LENGTH {
        run pushU32(&mut ramps, cache.word(start + step))
        step = step + 1
      }
    } else {
      let flat = pack(color.toPremultipliedRgba8(a.color))
      let mut step: usize = 0
      while step < RAMP_LENGTH {
        run pushU32(&mut ramps, flat)
        step = step + 1
      }
    }
    i = i + 1
  }
  return index
}

/// The `Paint` struct of `shaders/common.wgsl`: 20 words. `box` is the box a gradient spans.
/// Gradients interpolated in sRGB mix in the shader; any other interpolation (Oklab, Oklch, a
/// hue arc, a wide gamut space, ...) gets a ramp in `ramps`, so it matches `silk.color` exactly.
effect fn pushPaint(
  scene: &Scene,
  bytes: &mut List<u8>,
  ramps: &mut List<u8>,
  cache: &mut RampCache,
  paint: Background,
  box: Rect<f32>,
  dashed: bool,
  /// The transform of the primitive's layer (see [`Instances.pack`]), which rides in the spare
  /// word of the paint's `stops`.
  transform: f32,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let dash: u32 = if dashed {
    1
  } else {
    0
  }
  match paint {
    Background.Solid { color: fill } => {
      run pushU32(&mut bytes, 0)
      run pushU32(&mut bytes, 0)
      run pushU32(&mut bytes, dash)
      run pushU32(&mut bytes, 0)
      run pushColor(&mut bytes, fill)
      run push4(&mut bytes, 0.0, 0.0, 0.0, 0.0)
      run push4(&mut bytes, 0.0, 0.0, 0.0, 0.0)
      run push4(&mut bytes, 1.0, 0.0, 0.0, transform)
    }
    Background.Linear { gradient } => {
      // CSS: the line runs through the center at `angle` clockwise from up, long enough that the
      // corners reach 0 and 1 (the CPU reference's Painter.setGradient).
      let radians = f32.toF64(gradient.angle) * PI / 180.0
      let dx = f64.toF32(f64.sin(radians))
      let dy = f64.toF32(-f64.cos(radians))
      let w = box.xMax - box.xMin
      let h = box.yMax - box.yMin
      let half = f32.max((f32.abs(w * dx) + f32.abs(h * dy)) * 0.5, 0.000001)
      run pushGradientHead(&mut bytes, &mut ramps, &mut cache, gradient.from, gradient.to, gradient.interpolation, dash)
      run push4(&mut bytes, (box.xMin + box.xMax) * 0.5, (box.yMin + box.yMax) * 0.5, dx, dy)
      run push4(&mut bytes, half, gradient.from.offset, gradient.to.offset, transform)
    }
    Background.Stops { gradient: g } => {
      // The stops go into `ramps` as five words each: the offset, then the straight color.
      let list = scene.stopsOf(g.stops)
      let start = usize.toU32(ramps.length() / 4)
      let mut i: usize = 0
      while i < list.length {
        run push4(&mut ramps, list[i].offset, list[i].color.r, list[i].color.g, list[i].color.b)
        run pushF32(&mut ramps, list[i].color.a)
        i = i + 1
      }
      // Any interpolation but sRGB: one ramp per pair of neighbours, numbered from `first.z - 1`.
      let ramp: f32 = if color.isSrgb(g.interpolation) || list.length < 2 {
        0.0
      } else {
        let first = run pushStopRamps(&mut ramps, &mut cache, list, g.interpolation)
        u32.toF32(first + 1)
      }
      let shape: u32 = match g.shape {
        GradientShape.Linear => 0
        GradientShape.Radial => 1
        GradientShape.Conic => 2
      }
      run pushU32(&mut bytes, 3)
      run pushU32(&mut bytes, start)
      run pushU32(&mut bytes, dash)
      run pushU32(&mut bytes, shape)
      run push4(&mut bytes, usize.toF32(list.length), if g.repeating { 1.0 } else { 0.0 }, ramp, 0.0)
      run push4(&mut bytes, 0.0, 0.0, 0.0, 0.0)
      match g.shape {
        GradientShape.Linear => {
          let radians = f32.toF64(g.angle) * PI / 180.0
          let dx = f64.toF32(f64.sin(radians))
          let dy = f64.toF32(-f64.cos(radians))
          let w = box.xMax - box.xMin
          let h = box.yMax - box.yMin
          let half = f32.max((f32.abs(w * dx) + f32.abs(h * dy)) * 0.5, 0.000001)
          run push4(&mut bytes, (box.xMin + box.xMax) * 0.5, (box.yMin + box.yMax) * 0.5, dx, dy)
          run push4(&mut bytes, half, 0.0, 0.0, transform)
        }
        GradientShape.Radial => {
          run push4(
            &mut bytes,
            box.xMin + g.centerX,
            box.yMin + g.centerY,
            1.0 / f32.max(g.radiusX, 0.000001),
            1.0 / f32.max(g.radiusY, 0.000001),
          )
          run push4(&mut bytes, 1.0, 0.0, 0.0, transform)
        }
        GradientShape.Conic => {
          run push4(&mut bytes, box.xMin + g.centerX, box.yMin + g.centerY, g.angle / 360.0, 0.0)
          run push4(&mut bytes, 1.0, 0.0, 0.0, transform)
        }
      }
    }
  }
}

/// The `kind` word and both stop colors of a two-stop linear gradient `Paint`.
effect fn pushGradientHead(
  bytes: &mut List<u8>,
  ramps: &mut List<u8>,
  cache: &mut RampCache,
  from: ColorStop,
  to: ColorStop,
  interpolation: Interpolation,
  dash: u32,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let native = match interpolation.space {
    ColorSpace.Srgb => true
    _ => false
  }
  if native {
    run pushU32(&mut bytes, 1)
    run pushU32(&mut bytes, 0)
  } else {
    let ramp = run pushRamp(&mut ramps, &mut cache, from, to, interpolation)
    run pushU32(&mut bytes, 2)
    run pushU32(&mut bytes, ramp)
  }
  run pushU32(&mut bytes, dash)
  run pushU32(&mut bytes, 0)
  run pushColor(&mut bytes, from.color)
  run pushColor(&mut bytes, to.color)
}

effect fn packQuad(scene: &Scene, bytes: &mut List<u8>, ramps: &mut List<u8>, cache: &mut RampCache, q: Quad, transform: f32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run pushRect(&mut bytes, q.bounds)
  run pushRect(&mut bytes, q.mask.bounds)
  run pushRadii(&mut bytes, q.cornerRadii.fittedTo(q.bounds))
  let w = q.borderWidths
  run push4(&mut bytes, w.top, w.right, w.bottom, w.left)
  let border = if q.hasBorder() {
    q.borderColor
  } else {
    color.transparent()
  }
  run pushColor(&mut bytes, border)
  let dashed = match q.borderStyle {
    BorderStyle.Solid => false
    BorderStyle.Dashed => true
  }
  run pushPaint(scene, &mut bytes, &mut ramps, &mut cache, q.background, q.bounds, dashed, transform)
  run pushRadii(&mut bytes, q.mask.radii)
}

effect fn packShadow(bytes: &mut List<u8>, s: Shadow, transform: f32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run pushRect(&mut bytes, s.shape())
  run pushRect(&mut bytes, s.mask.bounds)
  run pushRadii(&mut bytes, s.shapeRadii())
  run pushColor(&mut bytes, s.color)
  run pushRect(&mut bytes, s.bounds)
  run pushRadii(&mut bytes, s.cornerRadii.fittedTo(s.bounds))
  run pushRect(&mut bytes, s.paintBounds())
  run push4(
    &mut bytes,
    s.sigma(),
    if s.inset {
      1.0
    } else {
      0.0
    },
    transform,
    0.0,
  )
  run pushRadii(&mut bytes, s.mask.radii)
}

effect fn packUnderline(bytes: &mut List<u8>, u: Underline, transform: f32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run pushRect(&mut bytes, u.bounds)
  run pushRect(&mut bytes, u.mask.bounds)
  run pushColor(&mut bytes, u.color)
  run push4(
    &mut bytes,
    u.thickness,
    if u.wavy {
      1.0
    } else {
      0.0
    },
    transform,
    0.0,
  )
  run pushRadii(&mut bytes, u.mask.radii)
}

effect fn pushTile(bytes: &mut List<u8>, r: Rect<u32>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run push4(&mut bytes, u32.toF32(r.xMin), u32.toF32(r.yMin), u32.toF32(r.xMax), u32.toF32(r.yMax))
}

effect fn packGlyph(bytes: &mut List<u8>, g: GlyphSprite, transform: f32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run pushRect(&mut bytes, g.bounds)
  run pushRect(&mut bytes, g.mask.bounds)
  run pushColor(&mut bytes, g.color)
  run pushTile(&mut bytes, g.tile.bounds)
  run pushRadii(&mut bytes, g.mask.radii)
  run push4(&mut bytes, transform, 0.0, 0.0, 0.0)
}

effect fn packImage(bytes: &mut List<u8>, s: ImageSprite, transform: f32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run pushRect(&mut bytes, s.bounds)
  run pushRect(&mut bytes, s.mask.bounds)
  run pushTile(&mut bytes, s.tile.bounds)
  run pushRect(&mut bytes, s.clipBounds)
  run pushRadii(&mut bytes, s.cornerRadii.fittedTo(s.clipBounds))
  run push4(
    &mut bytes,
    s.opacity,
    imageFlags(s.grayscale, s.nearest),
    u32.toF32(s.quarterTurns % 4),
    transform,
  )
  run pushRadii(&mut bytes, s.mask.radii)
}

/// One frame's instances, ready to upload.
pub struct Instances {
  pub quads: List<u8>,
  pub shadows: List<u8>,
  pub underlines: List<u8>,
  pub glyphs: List<u8>,
  pub images: List<u8>,
  pub paths: List<u8>,
  pub runs: List<u8>,
  pub alphas: List<u8>,
  /// Gradient ramps, `RAMP_LENGTH` words each.
  pub ramps: List<u8>,
  /// Ramps sampled in earlier frames, so unchanged gradients outside sRGB are not sampled again.
  rampCache: RampCache,
  /// For layer `l` and kind `k`, `bases[l * KIND_COUNT + k]` is the index of the layer's first
  /// instance of that kind.
  bases: List<u32>,
  /// The first run of each path, in packed order, plus the total run count at the end.
  pathRuns: List<u32>,
}

impl Instances {
  pub fn make() -> Instances {
    return Instances {
      quads: List<u8>.make(),
      shadows: List<u8>.make(),
      underlines: List<u8>.make(),
      glyphs: List<u8>.make(),
      images: List<u8>.make(),
      paths: List<u8>.make(),
      runs: List<u8>.make(),
      alphas: List<u8>.make(),
      ramps: List<u8>.make(),
      rampCache: RampCache.make(),
      bases: List<u32>.make(),
      pathRuns: List<u32>.make(),
    }
  }

  /// The instance index of item `start` of kind `kind` (a `PrimitiveKind.index()`) in `layer`.
  pub fn base(self: &Self, layer: u32, kind: u32) -> u32 {
    return self.bases.get(u32.toUsize(layer) * KIND_COUNT + u32.toUsize(kind))
  }

  /// The runs of paths `first .. end` (packed path indices).
  pub fn runRange(self: &Self, first: u32, end: u32) -> [u32; 2] {
    return [self.pathRuns.get(u32.toUsize(first)), self.pathRuns.get(u32.toUsize(end))]
  }

  /// The number of path runs.
  pub fn runCount(self: &Self) -> u32 {
    return usize.toU32(self.runs.length() / RUN_BYTES)
  }

  /// Packs every layer of `scene`, which must be finished, with its scroll groups moved to
  /// `placed`. `transforms[l]` is the transform layer `l`'s primitives are drawn through: an
  /// index into the renderer's `Transform`s, 0 for a layer drawn where it lies.
  pub effect fn pack(self: &mut Self, scene: &Scene, placed: &Placements, transforms: &[u32]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.quads.clear()
    self.shadows.clear()
    self.underlines.clear()
    self.glyphs.clear()
    self.images.clear()
    self.paths.clear()
    self.runs.clear()
    self.alphas.clear()
    self.ramps.clear()
    self.bases.clear()
    self.pathRuns.clear()
    run self.alphas.appendSlice(scene.pathAlphas())
    while self.alphas.length() % 4 != 0 {
      run self.alphas.append(0)
    }
    let strips = scene.pathStrips()
    let fills = scene.pathFills()
    let mut layer: u32 = 0
    while layer < scene.layerCount() {
      run self.bases.append(usize.toU32(self.shadows.length() / SHADOW_BYTES))
      run self.bases.append(usize.toU32(self.quads.length() / QUAD_BYTES))
      run self.bases.append(usize.toU32(self.paths.length() / PATH_BYTES))
      run self.bases.append(usize.toU32(self.underlines.length() / UNDERLINE_BYTES))
      run self.bases.append(usize.toU32(self.glyphs.length() / MONO_BYTES))
      run self.bases.append(usize.toU32(self.images.length() / POLY_BYTES))
      run self.bases.append(0)
      let transform = u32.toF32(transforms[u32.toUsize(layer)])
      let shadows = scene.shadows(layer)
      let mut groups = scene.groupsOf(layer, PrimitiveKind.Shadow)
      let mut i: usize = 0
      while i < shadows.length {
        run packShadow(&mut self.shadows, placed.shadow(shadows[i], groups[i]), transform)
        i = i + 1
      }
      let quads = scene.quads(layer)
      groups = scene.groupsOf(layer, PrimitiveKind.Quad)
      i = 0
      while i < quads.length {
        run packQuad(scene, &mut self.quads, &mut self.ramps, &mut self.rampCache, placed.quad(quads[i], groups[i]), transform)
        i = i + 1
      }
      let underlines = scene.underlines(layer)
      groups = scene.groupsOf(layer, PrimitiveKind.Underline)
      i = 0
      while i < underlines.length {
        run packUnderline(&mut self.underlines, placed.underline(underlines[i], groups[i]), transform)
        i = i + 1
      }
      let glyphs = scene.glyphs(layer)
      groups = scene.groupsOf(layer, PrimitiveKind.Glyph)
      i = 0
      while i < glyphs.length {
        run packGlyph(&mut self.glyphs, placed.glyph(glyphs[i], groups[i]), transform)
        i = i + 1
      }
      let images = scene.images(layer)
      groups = scene.groupsOf(layer, PrimitiveKind.Image)
      i = 0
      while i < images.length {
        run packImage(&mut self.images, placed.image(images[i], groups[i]), transform)
        i = i + 1
      }
      let paths = scene.paths(layer)
      groups = scene.groupsOf(layer, PrimitiveKind.Path)
      i = 0
      while i < paths.length {
        run self.packPath(scene, placed.path(paths[i], groups[i]), strips, fills)
        i = i + 1
      }
      layer = layer + 1
    }
    let total = self.runCount()
    run self.pathRuns.append(total)
  }

  effect fn packPath(self: &mut Self, scene: &Scene, p: PathSprite, strips: &[Strip], fills: &[Fill]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let index = usize.toU32(self.paths.length() / PATH_BYTES)
    let firstRun = self.runCount()
    run self.pathRuns.append(firstRun)
    run pushRect(&mut self.paths, p.mask.bounds)
    run pushPaint(scene, &mut self.paths, &mut self.ramps, &mut self.rampCache, p.paint, p.paintBounds, false, 0.0)
    run pushRadii(&mut self.paths, p.mask.radii)
    let bottom = p.y + u32.toI32(p.height)
    let mut s = u32.toUsize(p.stripStart)
    while s < u32.toUsize(p.stripStart + p.stripCount) {
      let strip = strips[s]
      run self.addRun(
        p.x + u32.toI32(strip.x),
        p.y + u32.toI32(strip.y),
        strip.width,
        strip.alphaOffset / 4,
        index,
        bottom,
      )
      s = s + 1
    }
    let mut f = u32.toUsize(p.fillStart)
    while f < u32.toUsize(p.fillStart + p.fillCount) {
      let fill = fills[f]
      run self.addRun(
        p.x + u32.toI32(fill.x),
        p.y + u32.toI32(fill.y),
        fill.width,
        SOLID,
        index,
        bottom,
      )
      f = f + 1
    }
  }

  effect fn addRun(
    self: &mut Self,
    x: i32,
    y: i32,
    width: u32,
    alpha: u32,
    path: u32,
    bottom: i32,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run pushU32(&mut self.runs, i32.wrappingToU32(x))
    run pushU32(&mut self.runs, i32.wrappingToU32(y))
    run pushU32(&mut self.runs, width)
    run pushU32(&mut self.runs, alpha)
    run pushU32(&mut self.runs, path)
    run pushU32(&mut self.runs, i32.wrappingToU32(bottom))
    run pushU32(&mut self.runs, 0)
    run pushU32(&mut self.runs, 0)
  }
}

/// An image's shader flags: 1 grayscale, 2 nearest sampling (`image-rendering: pixelated`).
fn imageFlags(grayscale: bool, nearest: bool) -> f32 {
  let mut flags: f32 = 0.0
  if grayscale { flags = flags + 1.0 }
  if nearest { flags = flags + 2.0 }
  return flags
}
